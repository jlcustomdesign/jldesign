---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site";
import { BREADCRUMBS } from "../config/content";

const categories = [
  "Bucătării la comandă",
  "Dressinguri & Dulapuri",
  "Mobilier living & biblioteci",
  "Mobilă de dormitor",
  "Mobilier de baie",
  "Holuri & Riflaje",
  "Birouri & HoReCa",
  "Alt proiect personalizat",
];
---

<Layout
  title={`Contact | ${SITE.name} — Mobilier la Comandă Brașov`}
  description="Contactează atelierul JL Custom Design pentru consultanță, măsurători la fața locului și proiectare 3D de mobilier personalizat în Brașov."
  breadcrumbs={[
    { name: BREADCRUMBS.home, url: "/" },
    { name: "Contact", url: "/contact/" },
  ]}
>
  <main class="pt-32 pb-24 px-4 md:px-8 max-w-7xl mx-auto" data-theme="light">
    <!-- Header -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <span class="block text-accent uppercase tracking-[0.2em] text-sm font-bold mb-4">
        {SITE.name} — Brașov
      </span>
      <h1 class="text-4xl md:text-6xl font-serif text-primary leading-tight mb-6">
        Hai să discutăm despre proiectul tău
      </h1>
      <p class="text-lg md:text-xl text-primary/70 leading-relaxed">
        Programează o consultanță și măsurători la fața locului în Brașov și împrejurimi. Îți oferim proiectare 3D, randări fotorealiste și o ofertă detaliată fără costuri ascunse.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Contact Cards -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Telefon -->
        <a
          href={`tel:${SITE.phone}`}
          class="block p-6 rounded-2xl bg-white border border-primary/10 shadow-sm hover:shadow-md transition-shadow group"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-primary/50 block">Telefon Direct</span>
              <span class="text-xl font-serif text-primary font-bold">{SITE.phone}</span>
            </div>
          </div>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${SITE.email}`}
          class="block p-6 rounded-2xl bg-white border border-primary/10 shadow-sm hover:shadow-md transition-shadow group"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-primary/50 block">Email Atelier</span>
              <span class="text-lg font-serif text-primary font-bold">{SITE.email}</span>
            </div>
          </div>
        </a>

        <!-- Locatie -->
        <div class="p-6 rounded-2xl bg-white border border-primary/10 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center text-accent shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-primary/50 block mb-1">Zonă de Acoperire</span>
              <p class="text-primary font-medium">Brașov & localitățile învecinate (Săcele, Râșnov, Codlea, Făgăraș) + deplasări în Sibiu și Buzău.</p>
              <p class="text-xs text-primary/50 mt-2">Măsurătorile și consultanța se realizează direct la spațiul tău.</p>
            </div>
          </div>
        </div>

        <!-- Program -->
        <div class="p-6 rounded-2xl bg-secondary border border-primary/10">
          <span class="text-xs font-bold uppercase tracking-widest text-primary/50 block mb-2">Program de Lucru</span>
          <p class="text-primary font-serif font-bold text-lg">Luni – Vineri: 08:30 – 18:00</p>
          <p class="text-primary/70 text-sm mt-1">Sâmbătă: Cu programare prealabilă pentru măsurători.</p>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-8 md:p-12 border border-primary/10 shadow-lg">
        <h2 class="font-serif text-2xl md:text-3xl text-primary mb-2">Trimite-ne un mesaj</h2>
        <p class="text-primary/70 text-sm md:text-base mb-8">
          Completează formularul de mai jos și te vom contacta în maxim 24 de ore lucrătoare pentru detalii.
        </p>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-6"
          id="page-contact-form"
        >
          <input type="hidden" name="access_key" value={SITE.web3formsKey} />
          <input type="hidden" name="subject" value="Cerere ofertă de pe pagina Contact - JL Mobila" />
          <input type="hidden" name="from_name" value="Site JL Mobila" />

          <!-- Category Selection -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-widest text-primary/80 mb-3">
              Ce tip de mobilier te interesează?
            </label>
            <div class="flex flex-wrap gap-2">
              {categories.map((cat) => (
                <label class="cursor-pointer text-xs">
                  <input
                    type="checkbox"
                    name="categorie"
                    value={cat}
                    class="peer sr-only"
                  />
                  <span class="inline-block px-4 py-2 rounded-full border border-primary/20 text-primary/70 transition-all peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary hover:border-primary/50">
                    {cat}
                  </span>
                </label>
              ))}
            </div>
          </div>

          <!-- Nume & Telefon -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="contact-name" class="block text-xs font-bold uppercase tracking-widest text-primary/80 mb-2">
                Nume și Prenume *
              </label>
              <input
                id="contact-name"
                type="text"
                name="name"
                required
                placeholder="ex. Maria Ionescu"
                class="w-full px-4 py-3 rounded-xl border border-primary/20 bg-secondary/30 text-primary placeholder:text-primary/40 focus:outline-none focus:border-accent transition-colors"
              />
            </div>
            <div>
              <label for="contact-phone" class="block text-xs font-bold uppercase tracking-widest text-primary/80 mb-2">
                Număr de Telefon *
              </label>
              <input
                id="contact-phone"
                type="tel"
                name="phone"
                required
                placeholder="ex. 07xx xxx xxx"
                class="w-full px-4 py-3 rounded-xl border border-primary/20 bg-secondary/30 text-primary placeholder:text-primary/40 focus:outline-none focus:border-accent transition-colors"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-widest text-primary/80 mb-2">
              Adresă de Email *
            </label>
            <input
              id="contact-email"
              type="email"
              name="email"
              required
              placeholder="ex. maria@exemplu.ro"
              class="w-full px-4 py-3 rounded-xl border border-primary/20 bg-secondary/30 text-primary placeholder:text-primary/40 focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <!-- Mesaj -->
          <div>
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-widest text-primary/80 mb-2">
              Detalii despre proiect / Dimensiuni aproximative
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              placeholder="Spune-ne câteva cuvinte despre ce îți dorești: spațiul disponibil, materiale preferate, termen estimat..."
              class="w-full px-4 py-3 rounded-xl border border-primary/20 bg-secondary/30 text-primary placeholder:text-primary/40 focus:outline-none focus:border-accent transition-colors resize-none"
            ></textarea>
          </div>

          <!-- GDPR -->
          <div class="flex items-start gap-3 pt-2">
            <input
              id="contact-gdpr"
              type="checkbox"
              name="gdpr"
              required
              class="mt-1 w-4 h-4 rounded border-primary/20 text-accent focus:ring-accent"
            />
            <label for="contact-gdpr" class="text-xs text-primary/70 leading-relaxed">
              Sunt de acord ca datele mele să fie prelucrate de JL Custom Design exclusiv pentru transmiterea ofertei, conform <a href="/politica-de-confidentialitate/" target="_blank" class="underline hover:text-accent">Politicii de Confidențialitate</a>. *
            </label>
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <button
              type="submit"
              class="w-full md:w-auto inline-block bg-primary text-white px-10 py-4 rounded-full font-bold uppercase tracking-wider text-sm hover:bg-accent transition-colors duration-300 shadow-md cursor-pointer"
            >
              Trimite Cererea de Ofertă
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <Footer slot="footer" />
</Layout>
