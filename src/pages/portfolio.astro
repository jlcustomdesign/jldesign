---
import Layout from "../layouts/Layout.astro";
import PortfolioHero from "../components/PortfolioHero.astro";
import PortfolioCMSGrid from "../components/PortfolioCMSGrid.astro";
import Footer from "../components/Footer.astro";
import { PORTFOLIO_PAGE, BREADCRUMBS } from "../config/content";
import { SITE } from "../config/site";

// CollectionPage schema: tells search engines and AI engines that this page
// is a curated gallery of completed custom-furniture projects.
const collectionSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Portofoliu proiecte de mobilier la comandă — " + SITE.name,
  "url": `${SITE.url}/portfolio`,
  "description": PORTFOLIO_PAGE.description,
  "inLanguage": "ro",
  "isPartOf": {
    "@type": "WebSite",
    "name": SITE.name,
    "url": SITE.url,
  },
  "about": {
    "@type": "Thing",
    "name": "Mobilier la comandă și mobilă personalizată în Brașov",
  },
});
---

<Layout
  title={PORTFOLIO_PAGE.title}
  description={PORTFOLIO_PAGE.description}
  breadcrumbs={[
    { name: BREADCRUMBS.home, url: "/" },
    { name: BREADCRUMBS.portfolio, url: "/portfolio" },
  ]}
>
  <main>
    <script type="application/ld+json" set:html={collectionSchema}></script>
    <!-- Semantic keywords for AI engines (GEO) -->
    <div class="sr-only">
      {
        Array.isArray(PORTFOLIO_PAGE.seoFabric) ? (
          PORTFOLIO_PAGE.seoFabric.map((paragraph) => <p>{paragraph}</p>)
        ) : (
          <p>{PORTFOLIO_PAGE.seoFabric}</p>
        )
      }
    </div>
    <PortfolioHero />
    <PortfolioCMSGrid />
  </main>
  <Footer slot="footer" />
  <div slot="outside">
    <!-- Lightbox (Simplified) -->
    <div id="portfolio-lightbox" class="fixed inset-0 z-[9999] bg-black/95 opacity-0 pointer-events-none flex items-center justify-center p-4 transition-opacity duration-300">
      <button id="lightbox-close" class="absolute top-6 right-6 z-50 p-2 text-white/50 hover:text-white bg-black/20 rounded-full" aria-label={PORTFOLIO_PAGE.closeGallery}>
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300" />
    </div>
  </div>
</Layout>
