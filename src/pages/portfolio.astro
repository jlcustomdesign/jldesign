---
import Layout from "../layouts/Layout.astro";
import PortfolioHero from "../components/PortfolioHero.astro";
import PortfolioCMSGrid from "../components/PortfolioCMSGrid.astro";
import Footer from "../components/Footer.astro";
import { PORTFOLIO_PAGE, BREADCRUMBS } from "../config/content";
---

<Layout
  title={PORTFOLIO_PAGE.title}
  description={PORTFOLIO_PAGE.description}
  breadcrumbs={[
    { name: BREADCRUMBS.home, url: "/" },
    { name: BREADCRUMBS.portfolio, url: "/portfolio" },
  ]}
>
  <main>
    <!-- Semantic keywords for AI engines (GEO) -->
    <div class="sr-only">
      {
        Array.isArray(PORTFOLIO_PAGE.seoFabric) ? (
          PORTFOLIO_PAGE.seoFabric.map((paragraph) => <p>{paragraph}</p>)
        ) : (
          <p>{PORTFOLIO_PAGE.seoFabric}</p>
        )
      }
    </div>
    <PortfolioHero />
    <PortfolioCMSGrid />
  </main>
  <Footer slot="footer" />
</Layout>
