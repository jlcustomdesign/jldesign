---
import Layout from "../layouts/Layout.astro";
import PortfolioCategoriesHover from "../components/PortfolioCategoriesHover.astro";
import ServicesGridV2 from "../components/ServicesGridV2.astro";
import ServicesCTA from "../components/ServicesCTA.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import { SERVICES_PAGE, BREADCRUMBS } from "../config/content";
---

<Layout
  title={SERVICES_PAGE.title}
  description={SERVICES_PAGE.description}
  breadcrumbs={[
    { name: BREADCRUMBS.home, url: "/" },
    { name: BREADCRUMBS.services, url: "/services" },
  ]}
>
  <div
    id="services-hero-section"
    class="relative w-full h-[100svh] lg:h-screen min-h-[680px] overflow-hidden bg-secondary"
  >
    <!-- Answer-first summary + semantic keywords for AI engines (AEO/GEO) -->
    <div class="sr-only">
      {SERVICES_PAGE.seoFabric.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <!-- Text Content (Behind SVG) -->
    <div class="absolute inset-0 w-full h-full z-0 pointer-events-none">
      <div class="relative w-full h-full max-w-[1920px] mx-auto">
        <h1 class="sr-only">
          {SERVICES_PAGE.heroH1}
        </h1>
        <!-- DESKTOP TEXT (Hidden on Mobile) -->
        <div class="hidden md:block" aria-hidden="true">
          <!-- Text for Cutout 1: SERVICIILE -->
          <div
            class="absolute left-[4%] top-[19.5vh] -translate-y-1/2 overflow-hidden"
          >
            <div
              class="font-serif text-[clamp(3.5rem,7vw,8rem)] leading-none text-primary uppercase whitespace-nowrap pl-4 desktop-headline-text opacity-0"
            >
              {SERVICES_PAGE.heroDesktopLines[0]}
            </div>
          </div>
 
          <!-- Text for Cutout 2: PE CARE NOI -->
          <div
            class="absolute left-[4%] top-[40vh] -translate-y-1/2 overflow-hidden"
          >
            <div
              class="font-serif text-[clamp(3.5rem,7vw,8rem)] leading-none text-primary uppercase whitespace-nowrap pl-4 desktop-headline-text opacity-0"
            >
              {SERVICES_PAGE.heroDesktopLines[1]}
            </div>
          </div>
 
          <!-- Text for Cutout 3: LE OFERIM -->
          <div
            class="absolute left-[4%] top-[60.5vh] -translate-y-1/2 overflow-hidden"
          >
            <div
              class="font-serif text-[clamp(3.5rem,7vw,8rem)] leading-none text-primary uppercase whitespace-nowrap pl-4 desktop-headline-text opacity-0"
            >
              {SERVICES_PAGE.heroDesktopLines[2]}
            </div>
          </div>
        </div>
      </div>
    </div>
 
    <!-- SVG Background Container -->
    <div
      class="absolute inset-0 w-full h-full flex justify-center items-center pointer-events-none"
    >
      <svg
        id="servicesHeroSVG"
        width="100%"
        height="100%"
        viewBox="0 0 1920 1080"
        preserveAspectRatio="xMidYMid slice"
        class="w-full h-full"
        style="transform-origin: center center;"
      >
        <defs>
          <clipPath id="servicesHeroClip">
            <path id="servicesHeroPath" d=""></path>
          </clipPath>
        </defs>
 
        <image
          href="/Poze JL Custom Design - Site/Services/Hero.webp"
          x="0"
          y="0"
          width="1920"
          height="1080"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#servicesHeroClip)"
        />
      </svg>
    </div>
 
    <!-- Overlay: Right Text (Hidden on Mobile) -->
    <!-- MOBILE TEXT (Moved here for Z-Index/Visibility) -->
    <div
      class="md:hidden absolute inset-0 flex flex-col justify-between px-6 pt-40 pb-24 z-30 pointer-events-auto"
    >
      <div
        class="font-serif text-[16vw] sm:text-7xl text-white leading-[1.05]"
        aria-hidden="true"
      >
        {
          SERVICES_PAGE.heroMobileLines.map((line) => (
            <span class="block whitespace-nowrap">{line}</span>
          ))
        }
      </div>
 
      <!-- Bottom Content Group -->
      <div class="flex flex-col items-start gap-8">
        <p
          class="font-sans text-lg font-light text-white/90 leading-relaxed max-w-xs"
        >
          {SERVICES_PAGE.heroSubtitle}
        </p>
        <div>
          <a
            href="/contact"
            class="inline-block bg-white text-primary px-8 py-3 rounded-full font-medium hover:bg-accent hover:text-white transition-colors shadow-lg"
          >
            {SERVICES_PAGE.heroCta}
          </a>
        </div>
      </div>
    </div>
 
    <!-- Overlay: Bottom-Right Content Card (Hidden on Mobile) -->
    <div
      class="hidden md:block absolute bottom-[14vh] xl:bottom-[18vh] 2xl:bottom-[20vh] right-[4%] xl:right-[10%] 2xl:right-[15%] w-96 2xl:w-[32rem] bg-white rounded-3xl p-8 2xl:p-10 shadow-2xl z-20 pointer-events-auto opacity-0 hero-overlay-element"
    >
      <h3
        class="text-primary font-serif text-lg md:text-xl 2xl:text-3xl font-normal leading-relaxed mb-8"
      >
        {SERVICES_PAGE.heroSubtitle}
      </h3>
      <a
        href="/contact"
        class="inline-block bg-primary text-white px-8 py-3 2xl:px-10 2xl:py-4 2xl:text-lg rounded-full font-medium hover:bg-accent transition-all duration-300 shadow-lg"
      >
        {SERVICES_PAGE.heroCta}
      </a>
    </div>


  </div>

  <ServicesGridV2 
    items={SERVICES_PAGE.process}
    title="Ce putem face pentru tine"
    description="De la consultanță și proiectare 3D la execuție impecabilă, suntem partenerul tău pentru un interior deosebit."
  />

  <PortfolioCategoriesHover 
    id="services-products"
    title="Categorii de Mobilier"
    items={SERVICES_PAGE.services} 
  />

  <FaqSection />

  <ServicesCTA />

  <Footer />

  <script>
    import { initServicesHeroAnimations } from "../scripts/services-hero-animation";
    initServicesHeroAnimations();
  </script>
</Layout>
