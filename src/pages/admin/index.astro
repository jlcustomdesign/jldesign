---
import { getAuth } from '../../lib/admin/auth';
import AdminApp from '../../components/admin/AdminApp';
import '../../styles/admin.css';
import '../../styles/offer.css';

export const prerender = false;

const auth = await getAuth(Astro);
const user = auth.user ? { name: auth.user.name, login: auth.user.login, avatar: auth.user.avatar_url } : undefined;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · JL Custom Design</title>
  </head>
  <body style="margin:0;background:#f6f3ec;">
    {auth.ok ? (
      <AdminApp client:only="react" user={user} />
    ) : (
      <div class="adm">
        <div class="adm-login">
          <div class="adm-login-brand">JL Custom Design</div>
          <div class="adm-login-line"></div>
          <p class="adm-login-msg">
            {auth.reason === 'no-access'
              ? 'Contul tău GitHub nu are acces de scriere la acest site. Cere administratorului să te adauge drept colaborator.'
              : 'Autentifică-te pentru a gestiona conținutul site-ului.'}
          </p>
          <a class="adm-login-btn" href="/api/keystatic/github/login?from=/admin">
            <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            Continuă cu GitHub
          </a>
        </div>
      </div>
    )}
  </body>
</html>
