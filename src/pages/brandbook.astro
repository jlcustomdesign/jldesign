---
import Layout from "../layouts/Layout.astro";
import BubbleButton from "../components/ui/BubbleButton.astro";
import { BRANDBOOK_PAGE } from "../config/content";

const colors = BRANDBOOK_PAGE.colors;
const typography = BRANDBOOK_PAGE.typography;
---

<Layout title={BRANDBOOK_PAGE.title} description={BRANDBOOK_PAGE.description} hideNavbar={true} hideContact={true}>
  <main class="bg-secondary min-h-screen text-primary overflow-x-hidden">
    <!-- Section 1: Intro / Concept -->
    <section class="min-h-screen flex flex-col justify-center px-6 md:px-20 py-20 relative overflow-hidden">
      <div class="absolute top-10 right-10 z-20 opacity-40 font-mono text-xs uppercase tracking-widest reveal-item">
        {BRANDBOOK_PAGE.madeByLabel} - <a href={BRANDBOOK_PAGE.madeByLinkUrl} class="font-black hover:text-accent transition-colors underline decoration-accent/30">{BRANDBOOK_PAGE.madeByLinkLabel}</a>
      </div>
      
      <div class="max-w-6xl relative z-10">
        <small class="uppercase tracking-[0.4em] font-black text-accent mb-10 block reveal-item font-sans">{BRANDBOOK_PAGE.versionLabel}</small>
        
        <h1 class="text-7xl md:text-[10rem] lg:text-[12rem] font-serif mb-16 leading-[0.8] reveal-item tracking-tighter uppercase">
          {BRANDBOOK_PAGE.heroTitleMain} <br /> <span class="italic text-accent">{BRANDBOOK_PAGE.heroTitleAccent}</span>
        </h1>

        <div class="space-y-12 reveal-item">
            <h2 class="text-4xl md:text-6xl font-serif leading-tight opacity-90">
              {BRANDBOOK_PAGE.visionLine1} <br /> <span class="italic text-accent">{BRANDBOOK_PAGE.visionLine2}</span> {BRANDBOOK_PAGE.visionLine3}
            </h2>
            <p class="text-xl md:text-2xl max-w-2xl leading-relaxed opacity-60 font-sans">
              {BRANDBOOK_PAGE.introParagraph}
            </p>
        </div>
      </div>
    </section>

    <!-- Section 2: Colors -->
    <section class="py-32 px-6 md:px-20 bg-black text-white rounded-t-[4rem] relative z-20">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-4xl md:text-6xl font-serif mb-20 text-accent reveal-item">{BRANDBOOK_PAGE.paletteTitle}</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {colors.map((c) => (
            <div class={`group relative p-8 rounded-3xl aspect-[4/5] flex flex-col justify-between transition-transform duration-500 hover:scale-105 reveal-item`} style={`background-color: ${c.hex}`}>
              <div class={c.text}>
                <h3 class="text-2xl font-bold uppercase tracking-widest font-sans">{c.name}</h3>
                <p class="opacity-60 text-sm mt-2 font-sans">{c.usage}</p>
              </div>
              <div class={c.text}>
                <code class="text-lg block font-mono mb-1">{c.hex}</code>
                <code class="text-xs block font-mono opacity-50 font-sans">RGB: {c.rgb}</code>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 3: Typography -->
    <section class="py-32 px-6 md:px-20 bg-secondary relative z-20">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-4xl md:text-6xl font-serif mb-20 reveal-item">{BRANDBOOK_PAGE.typographyTitle}</h2>
        
        <div class="space-y-24">
          <div class="pb-20 border-b border-black/10">
             <span class="text-accent uppercase tracking-widest font-black text-xs block mb-4 font-sans">{BRANDBOOK_PAGE.primaryFaceLabel}</span>
             <h3 class="text-7xl md:text-[12rem] font-serif leading-none reveal-item">{BRANDBOOK_PAGE.primaryFaceValue}</h3>
             <div class="flex flex-wrap gap-4 mt-6">
               {
                BRANDBOOK_PAGE.primaryTags.map((tag) => (
                  <span class="px-3 py-1 border border-black/20 rounded-full text-xs uppercase font-bold font-sans">{tag}</span>
                ))
               }
             </div>
          </div>

          <div class="grid gap-16">
            {typography.map((t) => (
              <div class="flex flex-col md:flex-row md:items-baseline gap-4 md:gap-20 border-b border-black/5 pb-10 group reveal-item">
                <span class="w-16 font-mono text-sm opacity-40 uppercase font-sans">{t.tag}</span>
                <div class="flex-1">
                  <p class={`${t.font} ${t.uppercase ? 'uppercase' : ''} transition-all duration-300 group-hover:text-accent`} 
                     style={`font-size: ${t.size}; font-weight: ${t.weight}; letter-spacing: ${t.tracking};`}>
                    {BRANDBOOK_PAGE.specimenTemplate.replace("{tag}", t.tag)}
                  </p>
                </div>
                <div class="text-right opacity-40 font-mono text-xs hidden lg:block font-sans">
                  {t.size} / {t.weight} weight / {t.tracking} LS
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: UI Components -->
    <section class="py-32 px-6 md:px-20 bg-[#1A1A1A] text-white rounded-b-[4rem] relative z-20">
        <div class="max-w-7xl mx-auto">
        <h2 class="text-4xl md:text-6xl font-serif mb-20 text-accent reveal-item">{BRANDBOOK_PAGE.dynamicComponentsTitle}</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
                <div class="space-y-12">
                   <div class="reveal-item">
                     <p class="text-sm uppercase tracking-widest text-[#FFC800] mb-8 font-black font-sans">{BRANDBOOK_PAGE.interactiveStatesLabel}</p>
                      <div class="flex flex-wrap gap-6">
                       <BubbleButton href="#" variant="primary">{BRANDBOOK_PAGE.componentButtons[0]}</BubbleButton>
                       <BubbleButton href="#" variant="dark">{BRANDBOOK_PAGE.componentButtons[1]}</BubbleButton>
                       <BubbleButton href="#" variant="hero-glass">{BRANDBOOK_PAGE.componentButtons[2]}</BubbleButton>
                      </div>
                   </div>
                   
                   <div class="pt-20 reveal-item">
                     <p class="text-sm uppercase tracking-widest text-[#FFC800] mb-8 font-black font-sans">{BRANDBOOK_PAGE.radiiLabel}</p>
                      <div class="w-full max-w-sm h-32 bg-secondary/10 border border-white/20 rounded-2xl flex items-center justify-center">
                      <span class="text-xs opacity-50 uppercase tracking-widest font-sans">{BRANDBOOK_PAGE.roundedLabel}</span>
                      </div>
                   </div>
                </div>

                <div class="relative aspect-square bg-secondary/5 rounded-[4rem] flex items-center justify-center p-20 reveal-item overflow-hidden">
                  <div class="text-center group">
                    <div class="w-24 h-24 bg-accent rounded-full mx-auto mb-8 transition-transform duration-700 group-hover:scale-[3.5]"></div>
                    <h3 class="text-2xl font-serif relative z-10 mix-blend-difference">{BRANDBOOK_PAGE.interactionModelTitle}</h3>
                    <p class="text-sm opacity-50 mt-4 max-w-xs mx-auto relative z-10 mix-blend-difference font-sans">{BRANDBOOK_PAGE.interactionModelText}</p>
                  </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 5: Conclusion / Ending -->
    <section class="py-40 px-6 md:px-20 text-center relative overflow-hidden">
        <div class="max-w-4xl mx-auto relative z-10">
        <h2 class="text-5xl md:text-7xl font-serif mb-10 reveal-item">{BRANDBOOK_PAGE.endingTitle}</h2>
            <p class="text-xl opacity-60 leading-relaxed mb-12 reveal-item font-sans">
          {BRANDBOOK_PAGE.endingParagraph}
            </p>
            <div class="w-24 h-px bg-accent mx-auto mb-12 reveal-item"></div>
        <p class="text-sm uppercase tracking-[0.5em] font-black reveal-item font-sans">{BRANDBOOK_PAGE.endingYearLabel}{new Date().getFullYear()}</p>
        </div>
    </section>

    <!-- Footer of Brandbook -->
    <section class="py-10 text-center border-t border-black/5">
      <p class="text-[10px] opacity-30 uppercase tracking-[0.5em] font-sans">{BRANDBOOK_PAGE.footerLabel}</p>
    </section>
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initBrandbookReveal() {
    const isPrintMode = window.location.search.includes('print=true');
    const reveals = document.querySelectorAll(".reveal-item");
    
    reveals.forEach((el, i) => {
      if (isPrintMode) {
        gsap.set(el, { opacity: 1, y: 0 });
        return;
      }

      gsap.fromTo(el, 
        { opacity: 0, y: 30 },
        { 
          opacity: 1, 
          y: 0, 
          duration: 1.2, 
          ease: "expo.out",
          scrollTrigger: {
            trigger: el,
            start: "top 90%",
            toggleActions: "play none none none"
          }
        }
      );
    });
  }

  document.addEventListener("astro:page-load", initBrandbookReveal);
  initBrandbookReveal();
</script>

<style>
  /* Base styles for the brandbook */
  html {
    scroll-behavior: smooth;
  }
  
  ::selection {
    background: #FFC800;
    color: black;
  }

  /* Custom font specimen adjustments */
  h1, h2, h3 {
    letter-spacing: -0.01em;
  }
</style>
