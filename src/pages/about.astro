---
import Layout from "../layouts/Layout.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import BubbleButton from "../components/ui/BubbleButton.astro";

const placeholderImage = "/Images/placeholder-vertical.jpg"; // Using a placeholder path, will fallback visually if missing or user needs to add it
---

<Layout title="Despre Noi | JL Mobila">
  <main class="w-full relative z-10">
    <!-- Hero Section -->
    <!-- Hero Section -->
    <section
      id="about-hero-section"
      class="min-h-screen lg:min-h-[110vh] flex flex-col justify-center bg-secondary px-4 md:px-8 overflow-hidden relative pb-10 lg:pb-12"
      style="min-height: 110vh !important;"
    >
      <!-- Background SVG Container (COMMENTED OUT) -->
      <!-- <div
        id="about-hero-bg"
        class="absolute inset-0 z-0 overflow-hidden flex justify-center items-center pointer-events-none"
      >
        <svg
          id="aboutHeroSVG"
          xmlns="http://www.w3.org/2000/svg"
          width="100%"
          height="100%"
          preserveAspectRatio="xMidYMid meet"
          class="w-[98%] h-full opacity-0"
          style="transform-origin: center center;"
        >
          <path id="aboutHeroPath" fill="white" fill-opacity="1"></path>
        </svg>
      </div> -->

      <div id="about-hero-content" class="container mx-auto h-[80vh] w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 h-full relative">
          <!-- Left: Title Bottom Left -->
          <div
            class="order-2 lg:order-1 lg:col-span-5 flex flex-col justify-end pb-0 relative z-20"
          >
            <div class="space-y-6">
              <p
                class="text-primary/60 text-lg md:text-xl max-w-md reveal-text"
                data-reveal="slide"
              >
                Our family's dedication to this noble material reflects a deep
                respect for its history and potential.
              </p>
              <h1
                id="about-hero-title"
                class="font-serif text-[12vw] lg:text-[10rem] leading-[0.8] text-primary whitespace-nowrap opacity-0 -ml-1 md:-ml-2 lg:-ml-3 -mb-1 md:-mb-2 lg:-mb-4"
                style="transform: translateY(100%);"
              >
                DESPRE NOI
              </h1>
            </div>
          </div>

          <!-- Right: 4 Slices Image (Continuous) -->
          <div
            class="order-1 lg:order-2 lg:col-span-7 h-full grid grid-cols-4 gap-4 z-10"
          >
            <!-- Slice 1 (Left) - SHORTENED -->
            <div
              class="relative overflow-hidden h-[75%] lg:h-[70%] w-full reveal-roll rounded-2xl"
              data-delay="0.1"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/hero-image.jpg"
                class="absolute inset-x-0 w-[400%] max-w-none h-[142.86%] object-cover top-0 left-0"
                alt="Slice 1"
              />
            </div>
            <!-- Slice 2 (Center Left) - SHORTENED -->
            <div
              class="relative overflow-hidden h-[75%] lg:h-[70%] w-full reveal-roll rounded-2xl"
              data-delay="0.3"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/hero-image.jpg"
                class="absolute inset-x-0 w-[400%] max-w-none h-[142.86%] object-cover top-0 -left-[100%]"
                alt="Slice 2"
              />
            </div>
            <!-- Slice 3 (Center Right) - FULL -->
            <div
              class="relative overflow-hidden h-full w-full reveal-roll rounded-2xl"
              data-delay="0.5"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/hero-image.jpg"
                class="absolute inset-x-0 w-[400%] max-w-none h-full object-cover top-0 -left-[200%]"
                alt="Slice 3"
              />
            </div>
            <!-- Slice 4 (Right) - FULL -->
            <div
              class="relative overflow-hidden h-full w-full reveal-roll rounded-2xl"
              data-delay="0.7"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/hero-image.jpg"
                class="absolute inset-x-0 w-[400%] max-w-none h-full object-cover top-0 -left-[300%]"
                alt="Slice 4"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Story / Values Section -->
    <section
      class="py-24 bg-secondary rounded-t-[3rem] relative z-10 -mt-10 min-h-screen flex flex-col justify-center"
      id="about-story-section"
    >
      <div class="container mx-auto px-4 md:px-8">
        <div class="max-w-4xl mx-auto">
          <span
            class="block text-accent uppercase tracking-[0.2em] text-sm font-bold mb-8 text-center md:text-left reveal-text"
            data-reveal="perspective"
            data-reveal-blur
            style="opacity: 0;">Filozofia Noastră</span
          >

          <div
            class="prose prose-lg md:prose-xl prose-headings:font-serif prose-headings:font-normal text-primary/80"
          >
            <h2
              class="text-4xl md:text-5xl text-primary mb-12 reveal-text"
              data-reveal="perspective"
              data-reveal-blur
              style="opacity: 0;"
            >
              Calitatea nu este un act, ci un obicei.
            </h2>

            <p
              class="mb-8 reveal-text"
              data-reveal="perspective"
              data-reveal-blur
              style="opacity: 0;"
            >
              Într-o lume dominată de "fast furniture", noi am ales calea opusă.
              Credem în piese care îmbătrânesc frumos, în materiale care se simt
              bine la atingere și în mecanisme care funcționează impecabil și
              peste 20 de ani.
            </p>

            <p
              class="reveal-text"
              data-reveal="perspective"
              data-reveal-blur
              style="opacity: 0;"
            >
              Fiecare proiect este o colaborare strânsă între client și echipa
              noastră de designeri. Nu vindem mobilă din stoc; transformăm
              viziunea ta în realitate tangibilă, milimetru cu milimetru.
            </p>
          </div>

          <!-- Simple Stats Grid -->
          <div
            class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-12 border-t border-gray-100 pt-12"
            id="about-stats-grid"
          >
            <div class="stat-item opacity-0">
              <span
                class="stat-number block text-4xl md:text-5xl font-serif text-accent mb-2"
                >15+</span
              >
              <span class="text-sm uppercase tracking-wider text-gray-500"
                >Ani de experiență</span
              >
            </div>
            <div class="stat-item opacity-0">
              <span
                class="stat-number block text-4xl md:text-5xl font-serif text-accent mb-2"
                >500+</span
              >
              <span class="text-sm uppercase tracking-wider text-gray-500"
                >Proiecte livrate</span
              >
            </div>
            <div class="stat-item opacity-0">
              <span
                class="stat-number block text-4xl md:text-5xl font-serif text-accent mb-2"
                >100%</span
              >
              <span class="text-sm uppercase tracking-wider text-gray-500"
                >Dedicare</span
              >
            </div>
            <div class="stat-item opacity-0">
              <span
                class="stat-number block text-4xl md:text-5xl font-serif text-accent mb-2"
                >24h</span
              >
              <span class="text-sm uppercase tracking-wider text-gray-500"
                >Suport Rapid</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Atelier / Craftsmanship Section -->
    <section
      class="py-24 bg-secondary text-primary relative overflow-hidden"
      id="about-atelier-section"
    >
      <div class="container mx-auto px-4 md:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <!-- Text Content -->
          <div class="lg:col-span-5 space-y-8">
            <span
              class="block text-accent uppercase tracking-[0.2em] text-sm font-bold reveal-text"
              data-reveal="slide">Atelierul Nostru</span
            >
            <h2
              class="font-serif text-4xl md:text-5xl text-primary leading-tight reveal-text"
              data-reveal="perspective"
            >
              Măiestria Detaliului
            </h2>
            <p
              class="text-primary/80 text-lg leading-relaxed reveal-text"
              data-reveal="perspective"
              data-reveal-delay="0.1"
            >
              Aici, tehnologia întâlnește tradiția. Nu folosim scurtături.
              Fiecare piesă este finisată manual, verificată și testată pentru a
              rezista generațiilor.
            </p>
            <p
              class="text-primary/80 text-lg leading-relaxed reveal-text"
              data-reveal="perspective"
              data-reveal-delay="0.2"
            >
              Lemn masiv, furniruri rare și feronerie de top – ingredientele
              care transformă o simplă mobilă într-o moștenire de familie.
            </p>
          </div>

          <!-- Visual Grid -->
          <div class="lg:col-span-7 grid grid-cols-2 gap-4 md:gap-8">
            <div class="mt-12 md:mt-0 space-y-4">
              <div
                class="aspect-[3/4] rounded-2xl overflow-hidden reveal-image video-trigger"
              >
                <img
                  src="/Images/Proiecte-JL Custom Design-07.jpg"
                  class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-700"
                  alt="Detail 1"
                />
              </div>
            </div>
            <div class="-mt-12 md:-mt-24 space-y-4">
              <div
                class="aspect-[3/4] rounded-2xl overflow-hidden reveal-image"
                data-delay="0.2"
              >
                <img
                  src="/Images/hero-image.jpg"
                  class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity duration-700"
                  alt="Detail 2"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";
      import { initTextAnimations } from "../utils/RevealAnimationHandler";
      import { rectangle, cross } from "../scripts/hero-animation";

      gsap.registerPlugin(ScrollTrigger, MorphSVGPlugin);

      let ctx: gsap.Context;

      function initAboutAnimations() {
        // 1. Initialize Global Text Animations (Perspective Blur)
        initTextAnimations();

        // 2. Custom GSAP for Non-Text Elements (Images, Backgrounds, Stats)
        if (ctx) ctx.revert();

        ctx = gsap.context((self) => {
          const masterTl = gsap.timeline({ defaults: { ease: "power3.out" } });

          // --- Background SVG Morph Animation ---
          const svg = document.querySelector("#aboutHeroSVG");
          const path = document.querySelector("#aboutHeroPath");

          if (svg && path) {
            const heroSection = document.querySelector("#about-hero-section");
            let currentWidth = heroSection
              ? heroSection.clientWidth
              : window.innerWidth;
            let currentHeight = heroSection
              ? heroSection.clientHeight
              : window.innerHeight;
            const widthTarget = 1110;

            const simpleRect = (w: number, h: number) => {
              const r = 32; // Rounded corners
              const mx = 20;
              const mT = 50;
              const mB = 120;
              const activeW = w - 2 * mx;
              const activeH = h - (mT + mB);

              // Draw rounded rect with separate margins
              return `M${mx + r},${mT} h${activeW - 2 * r} a${r},${r} 0 0 1 ${r},${r} v${activeH - 2 * r} a${r},${r} 0 0 1 -${r},${r} h-${activeW - 2 * r} a${r},${r} 0 0 1 -${r},-${r} v-${activeH - 2 * r} a${r},${r} 0 0 1 ${r},-${r} z`;
            };

            const setSvgDimensions = (width: number, height: number) => {
              svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
              path.setAttribute("d", rectangle(width, height));
            };

            setSvgDimensions(currentWidth, currentHeight);

            // Initial State
            gsap.set(svg, {
              opacity: 0,
              scale: 1.15,
              transformOrigin: "center center",
            });

            // Animate In: Scale Down + Morph + Fade In
            masterTl
              .to(svg, {
                opacity: 1,
                scale: 1,
                duration: 2.5,
                ease: "elastic.out(1, 0.75)",
              })
              .to(
                path,
                {
                  duration: 2.5,
                  morphSVG: simpleRect(currentWidth, currentHeight),
                  ease:
                    currentWidth > widthTarget
                      ? "elastic.out(1, 0.75)"
                      : "back.out(2)",
                },
                "<",
              );

            // Resize Listener
            let resizeTimeout: ReturnType<typeof setTimeout>;
            const handleResize = () => {
              clearTimeout(resizeTimeout);
              resizeTimeout = setTimeout(() => {
                currentWidth = heroSection
                  ? heroSection.clientWidth
                  : window.innerWidth;
                currentHeight = heroSection
                  ? heroSection.clientHeight
                  : window.innerHeight;
                setSvgDimensions(currentWidth, currentHeight);
                // Re-morph to cross on resize if needed, or just reset to rectangle
                // For simplicity, we'll just reset to rectangle on resize.
                // If the morph should re-run, more complex logic is needed.
              }, 250); // Debounce resize
            };
            window.addEventListener("resize", handleResize);

            // Clean up resize listener when context reverts
            self.add(() => window.removeEventListener("resize", handleResize));
          }

          // --- Hero Card Reveal (Decoupled & Robust) ---
          const cardTl = gsap.timeline({ delay: 0.5 });

          // Animate TO visible state (Start state in HTML)
          cardTl.to("#about-hero-image", {
            scale: 1,
            opacity: 1,
            duration: 1.4,
            ease: "expo.out",
          });

          // Stats Reveal (Keeping custom stagger for grid)
          gsap.fromTo(
            ".stat-item",
            { y: 30, opacity: 0 }, // Init from invisible
            {
              y: 0,
              opacity: 1,
              duration: 1,
              stagger: 0.1,
              ease: "power2.out",
              scrollTrigger: {
                trigger: "#about-stats-grid",
                start: "top 95%", // Trigger earlier
              },
            },
          );

          // Stats Counter Animation
          const statNumbers = document.querySelectorAll(".stat-number");
          statNumbers.forEach((stat) => {
            const originalText = stat.textContent || "";
            const endValue = parseInt(originalText.replace(/\D/g, "")) || 0;
            const suffix = originalText.replace(/[0-9]/g, "");

            // Reset text immediately to start value to prevent "reload" flash
            stat.textContent = "0" + suffix;

            const counter = { val: 0 };

            gsap.to(counter, {
              val: endValue,
              duration: 2.5,
              ease: "power2.out",
              scrollTrigger: {
                trigger: "#about-stats-grid",
                start: "top 95%",
              },
              onUpdate: () => {
                stat.textContent = Math.floor(counter.val) + suffix;
              },
            });
          });

          // Image Reveal Animation (Atelier)
          const revealImageContainers =
            document.querySelectorAll(".reveal-image");
          revealImageContainers.forEach((container) => {
            const img = container.querySelector("img");
            // @ts-ignore
            const delay = parseFloat(container.dataset.delay || 0);

            // Animate Container (Fade Up)
            gsap.fromTo(
              container,
              { y: 50, opacity: 0 },
              {
                y: 0,
                opacity: 1,
                duration: 1,
                ease: "power2.out",
                delay: delay,
                scrollTrigger: {
                  trigger: container,
                  start: "top 85%",
                },
              },
            );

            // Animate Image (Zoom Out)
            if (img) {
              gsap.fromTo(
                img,
                { scale: 1.2 },
                {
                  scale: 1,
                  duration: 1.5,
                  ease: "power2.out",
                  delay: delay,
                  scrollTrigger: {
                    trigger: container,
                    start: "top 85%",
                  },
                },
              );
            }
          });

          // Slice Reveal Animation (Roll Down)
          const revealRollContainers =
            document.querySelectorAll(".reveal-roll");
          if (revealRollContainers.length > 0) {
            gsap.fromTo(
              revealRollContainers,
              { clipPath: "inset(0 0 100% 0)" },
              {
                clipPath: "inset(0 0 0% 0)",
                duration: 1.5,
                ease: "power2.out",
                stagger: 0.2,
                scrollTrigger: {
                  trigger: "#about-hero-section",
                  start: "top 80%",
                },
              },
            );
          }

          // Title Reveal Animation (Clean Slide Up)
          const heroTitle = document.querySelector("#about-hero-title");
          if (heroTitle) {
            gsap.to(heroTitle, {
              y: 0,
              opacity: 1,
              duration: 1.5,
              ease: "power3.out",
              delay: 0.2, // Sync with slices
              scrollTrigger: {
                trigger: "#about-hero-section",
                start: "top 80%",
              },
            });
          }

          const heroSection = document.querySelector("#about-hero-section");
          const heroContent = document.querySelector("#about-hero-content");

          if (heroSection && heroContent) {
            // Unified parallax behavior for all devices (Mobile Parallax Enabled)

            // Background Parallax (Layered Depth - Not Glued)
            const heroBg = document.querySelector("#about-hero-bg");
            if (heroBg) {
              gsap.to(heroBg, {
                scale: 0.94, // Consistent scale
                opacity: 0,
                filter: "blur(8px)",
                ease: "none",
                scrollTrigger: {
                  trigger: heroSection,
                  start: "bottom bottom",
                  end: "bottom top",
                  scrub: 0.5,
                  invalidateOnRefresh: true,
                },
              });
            }

            gsap.to(heroContent, {
              scale: 0.9,
              filter: "blur(8px)",
              opacity: 0,
              ease: "none",
              scrollTrigger: {
                trigger: heroSection,
                start: "bottom bottom",
                end: "bottom top",
                scrub: 0.5,
                pin: true, // Enabled on all devices
                pinSpacing: false,
                invalidateOnRefresh: true,
              },
            });
          }
        });
      }

      // Initialize on load (MPA style)
      if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
      ) {
        setTimeout(initAboutAnimations, 100);
      } else {
        document.addEventListener("DOMContentLoaded", initAboutAnimations);
      }

      // Support for View Transitions
      document.addEventListener("astro:page-load", initAboutAnimations);
      document.addEventListener("astro:before-swap", () => ctx?.revert());
    </script>

    <!-- FAQ Section -->
    <FaqSection />
  </main>

  <!-- Footer Slot -->
  <Footer slot="footer" />
</Layout>

<style is:global>
  /* Ensure body is transparent so fixed footer behind is visible */
  body {
    background-color: transparent !important;
  }
</style>
