---
import Layout from "../layouts/Layout.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import BubbleButton from "../components/ui/BubbleButton.astro";

const placeholderImage = "/Images/placeholder-vertical.jpg"; // Using a placeholder path, will fallback visually if missing or user needs to add it
---

<Layout title="Despre Noi | JL Mobila">
  <main class="w-full relative z-10">
    <!-- Hero Section -->
    <!-- Hero Section -->
    <section
      id="about-hero-section"
      class="min-h-screen lg:min-h-[110vh] flex flex-col justify-center px-4 md:px-8 overflow-hidden relative pb-8 lg:pb-12"
    >
      <!-- Background SVG Container (COMMENTED OUT) -->
      <!-- <div
        id="about-hero-bg"
        class="absolute inset-0 z-0 overflow-hidden flex justify-center items-center pointer-events-none"
      >
        <svg
          id="aboutHeroSVG"
          xmlns="http://www.w3.org/2000/svg"
          width="100%"
          height="100%"
          preserveAspectRatio="xMidYMid meet"
          class="w-[98%] h-full opacity-0"
          style="transform-origin: center center;"
        >
          <path id="aboutHeroPath" fill="white" fill-opacity="1"></path>
        </svg>
      </div> -->

      <div
        id="about-hero-content"
        class="container mx-auto h-auto lg:h-[80vh] w-full pt-24 lg:pt-0"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 h-full relative"
        >
          <!-- Left: Title Bottom Left -->
          <div
            class="order-2 lg:order-1 lg:col-span-5 flex flex-col justify-start lg:justify-end pb-8 lg:pb-0 relative z-20"
          >
            <div class="space-y-6">
              <p
                class="text-primary/60 text-lg md:text-xl max-w-md about-hero-subtitle"
              >
                Our family's dedication to this noble material reflects a deep
                respect for its history and potential.
              </p>
              <h1
                id="about-hero-title"
                class="font-serif text-[18vw] lg:text-[10rem] leading-[0.8] text-primary whitespace-nowrap opacity-0 -ml-1 md:-ml-2 lg:-ml-3"
                style="transform: translateY(100%);"
              >
                DESPRE NOI
              </h1>
            </div>
          </div>

          <!-- Right: 4 Slices Image (Continuous) -->
          <div
            class="order-1 lg:order-2 lg:col-span-7 h-[50vh] lg:h-full grid grid-cols-4 gap-3 md:gap-4 z-10"
          >
            <!-- Slice 1 (Left) -->
            <div
              class="relative overflow-hidden h-full lg:h-[70%] w-full reveal-roll rounded-xl lg:rounded-2xl"
              data-delay="0.1"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/optimized/hero-image.webp"
                class="absolute inset-x-0 w-[400%] max-w-none h-full lg:h-[142.86%] object-cover top-0 left-0"
                alt="Slice 1"
              />
            </div>
            <!-- Slice 2 (Center Left) -->
            <div
              class="relative overflow-hidden h-full lg:h-[70%] w-full reveal-roll rounded-xl lg:rounded-2xl"
              data-delay="0.3"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/optimized/hero-image.webp"
                class="absolute inset-x-0 w-[400%] max-w-none h-full lg:h-[142.86%] object-cover top-0 -left-[100%]"
                alt="Slice 2"
              />
            </div>
            <!-- Slice 3 (Center Right) -->
            <div
              class="relative overflow-hidden h-full w-full reveal-roll rounded-xl lg:rounded-2xl"
              data-delay="0.5"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/optimized/hero-image.webp"
                class="absolute inset-x-0 w-[400%] max-w-none h-full object-cover top-0 -left-[200%]"
                alt="Slice 3"
              />
            </div>
            <!-- Slice 4 (Right) -->
            <div
              class="relative overflow-hidden h-full w-full reveal-roll rounded-xl lg:rounded-2xl"
              data-delay="0.7"
              style="clip-path: inset(0 0 100% 0);"
            >
              <img
                src="/Images/optimized/hero-image.webp"
                class="absolute inset-x-0 w-[400%] max-w-none h-full object-cover top-0 -left-[300%]"
                alt="Slice 4"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Story / Values Section: Geometric Bento -->
    <section
      class="py-24 md:py-32 bg-secondary text-primary relative z-10 -mt-10 rounded-t-[3rem] overflow-hidden"
      id="about-story-section"
    >
      <div class="container mx-auto px-4 md:px-8">
        <!-- Bento Grid -->
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 auto-rows-min"
        >
          <!-- Cell 1: Header & Quote (Large Block) -->
          <div
            class="lg:col-span-8 p-8 md:p-12 bg-white rounded-3xl relative overflow-hidden group border border-primary/5 bento-card"
          >
            <div
              class="absolute top-0 right-0 w-32 h-32 bg-secondary rounded-bl-full -mr-8 -mt-8 opacity-50 transition-transform duration-700 group-hover:scale-110"
            >
            </div>

            <span
              class="block text-accent uppercase tracking-[0.2em] text-sm font-bold mb-8 relative z-10"
              >Filozofia Noastră</span
            >
            <h2
              class="text-3xl md:text-5xl lg:text-6xl font-serif text-primary mb-8 leading-tight relative z-10"
            >
              Calitatea nu este un act, ci un obicei.
            </h2>
            <div
              class="h-1 w-24 bg-accent mt-8 transform origin-left transition-all duration-700 group-hover:w-full"
            >
            </div>
          </div>

          <!-- Cell 2: Stat 1 (Square) -->
          <div
            class="lg:col-span-4 p-8 bg-[#1a1a1a] text-white rounded-3xl flex flex-col justify-center items-center text-center bento-card group relative overflow-hidden"
          >
            <span
              class="text-6xl md:text-7xl font-serif text-accent mb-2 block scale-100 group-hover:scale-110 transition-transform duration-500 stat-number"
              >15+</span
            >
            <span class="text-sm uppercase tracking-widest text-white/60"
              >Ani de experiență</span
            >
            <div
              class="absolute inset-0 bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
          </div>

          <!-- Cell 3: Manifesto (Medium Block) -->
          <div
            class="lg:col-span-5 p-8 md:p-10 bg-secondary border border-primary/10 rounded-3xl flex flex-col justify-center relative bento-card group"
          >
            <p class="text-lg md:text-xl text-primary/80 leading-relaxed">
              Într-o lume dominată de "fast furniture", noi am ales calea opusă.
              Credem în piese care îmbătrânesc frumos, în materiale care se simt
              bine la atingere.
            </p>
          </div>

          <!-- Cell 4: Stat 2 (Rectangle) -->
          <div
            class="lg:col-span-3 p-8 bg-white border border-primary/5 rounded-3xl flex flex-col justify-between bento-card hover:shadow-lg transition-shadow duration-300"
          >
            <span
              class="text-sm uppercase tracking-widest text-primary/40 block text-right"
              >Proiecte</span
            >
            <span
              class="text-5xl md:text-6xl font-serif text-primary block stat-number"
              >500+</span
            >
            <div
              class="w-full bg-secondary h-1 mt-4 rounded-full overflow-hidden"
            >
              <div class="bg-primary h-full w-[85%]"></div>
            </div>
          </div>

          <!-- Cell 5: Stat 3 & 4 (Combined or Split) -->
          <div class="lg:col-span-4 grid grid-cols-2 gap-4">
            <div
              class="p-6 bg-white rounded-3xl border border-primary/5 flex flex-col justify-center items-center text-center bento-card"
            >
              <span class="text-4xl font-serif text-primary mb-1 stat-number"
                >100%</span
              >
              <span class="text-[10px] uppercase tracking-wider text-primary/60"
                >Dedicare</span
              >
            </div>
            <div
              class="p-6 bg-[#d4af37] text-white rounded-3xl flex flex-col justify-center items-center text-center bento-card relative overflow-hidden"
            >
              <span
                class="text-4xl font-serif text-white mb-1 relative z-10 stat-number"
                >24h</span
              >
              <span
                class="text-[10px] uppercase tracking-wider text-white/80 relative z-10"
                >Suport Rapid</span
              >
            </div>
          </div>

          <!-- Cell 6: Collaboration Text -->
          <div
            class="lg:col-span-12 p-10 md:p-16 bg-white rounded-3xl border border-primary/5 mt-4 relative overflow-hidden bento-card items-center flex flex-col md:flex-row gap-8 md:gap-16"
          >
            <div class="md:w-1/2 relative z-10">
              <h3 class="text-2xl md:text-4xl font-serif text-primary mb-4">
                Nu vindem mobilă din stoc.
              </h3>
            </div>
            <div class="md:w-1/2 relative z-10">
              <p class="text-2xl md:text-3xl text-primary/80 leading-relaxed">
                Fiecare proiect este o colaborare strânsă între client și echipa
                noastră de designeri. Transformăm viziunea ta în realitate
                tangibilă, milimetru cu milimetru.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Atelier / Craftsmanship Section: Hyper-Minimalist -->
    <section
      class="py-32 md:py-48 bg-secondary text-primary relative z-10"
      id="about-atelier-section"
    >
      <div class="container mx-auto px-4 md:px-8">
        <!-- 1. Header (Centered) -->
        <div
          class="flex flex-col items-center text-center mb-20 md:mb-32 max-w-5xl mx-auto"
        >
          <h2
            class="text-[11vw] md:text-7xl lg:text-8xl font-serif font-bold text-primary leading-[1.05] uppercase mb-12 flex flex-col items-center text-center w-full"
          >
            <span class="scrub-words whitespace-nowrap block">Nu producem</span>
            <span class="scrub-words whitespace-nowrap block mt-1 md:mt-2"
              >doar mobilă.</span
            >
            <span class="scrub-words whitespace-nowrap block mt-1 md:mt-2"
              >creăm liniște.</span
            >
          </h2>
          <p
            class="text-3xl md:text-4xl lg:text-5xl text-primary/80 leading-relaxed scrub-words max-w-3xl"
          >
            În atelierul nostru, timpul curge altfel. Lemnul este lăsat să
            respire.
          </p>
        </div>

        <!-- 2. Grid (Image + Dark Card) -->
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 min-h-[80vh]"
        >
          <!-- Left: Image -->
          <div
            class="relative overflow-hidden rounded-[2.5rem] w-full h-[60vh] lg:h-auto reveal-image aspect-[4/5] lg:aspect-auto"
          >
            <img
              src="/Images/optimized/Proiecte-JL-Custom-Design-09.webp"
              alt="Workshop Detail"
              class="absolute inset-0 w-full h-full object-cover scale-105 transition-transform duration-[3s] hover:scale-100"
            />
          </div>

          <!-- Right: Dark Card -->
          <div
            class="bg-primary text-secondary rounded-[2.5rem] p-10 md:p-16 flex flex-col justify-between reveal-image min-h-[50vh] lg:min-h-0 relative"
            data-delay="0.2"
          >
            <div class="space-y-8 relative z-10">
              <span
                class="uppercase tracking-[0.2em] text-sm font-bold opacity-60"
                >Atelierul Nostru</span
              >
              <p
                class="text-4xl md:text-5xl lg:text-6xl font-serif leading-[1.3] scrub-words"
              >
                Fiecare îmbinare este o promisiune de durabilitate onorată
                manual.
              </p>
            </div>

            <div class="mt-24 flex flex-col items-start gap-8 relative z-10">
              <p class="text-lg opacity-60 max-w-md">
                Rezultatul? O colecție de piese care vorbesc de la sine. Nu doar
                mobilă, ci moștenire.
              </p>
              <BubbleButton
                href="/portfolio"
                variant="primary"
                class="!bg-secondary !text-primary !border-none hover:!bg-white"
              >
                Vezi Proiectele
              </BubbleButton>
            </div>
          </div>
        </div>
      </div>
    </section>
    <FaqSection />
  </main>

  <Footer slot="footer" />
</Layout>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";
  import { initTextAnimations } from "../utils/RevealAnimationHandler";
  import { rectangle, cross } from "../scripts/hero-animation";

  gsap.registerPlugin(ScrollTrigger, MorphSVGPlugin);

  let ctx: gsap.Context;

  function initAboutAnimations() {
    // 1. Initialize Global Text Animations (Perspective Blur) - Scoped to Main
    const main = document.querySelector("main");
    if (main) initTextAnimations(main as HTMLElement);

    // 2. Custom GSAP for Non-Text Elements (Images, Backgrounds, Stats)
    if (ctx) ctx.revert();

    ctx = gsap.context((self) => {
      // --- Scrub Words Animation (Optimized) ---
      const scrubWordContainers = document.querySelectorAll(".scrub-words");
      scrubWordContainers.forEach((container) => {
        const text = container.textContent.trim().replace(/\s+/g, " "); // Normalize spaces
        container.innerHTML = text
          .split(" ")
          .map(
            (word) =>
              `<span class="inline-block overflow-hidden pb-4 align-top"><span class="word-inner inline-block opacity-0 will-change-transform">${word}&nbsp;</span></span>`,
          )
          .join("");

        const words = container.querySelectorAll(".word-inner");

        // Performance: Hint browser before animation starts
        gsap.set(words, { willChange: "transform, opacity", yPercent: 120 });

        gsap.to(words, {
          yPercent: 0,
          opacity: 1,
          stagger: 0.05,
          ease: "power2.out",
          force3D: true, // GPU acceleration
          scrollTrigger: {
            trigger: container,
            start: "top 92%", // Slightly delayed start for paint separation
            end: "bottom 60%",
            scrub: 1,
          },
        });
      });

      // --- Scrub Button Animation ---
      const scrubButtons = document.querySelectorAll(".scrub-button");
      scrubButtons.forEach((btn) => {
        gsap.to(btn, {
          opacity: 1,
          y: 0,
          ease: "none",
          scrollTrigger: {
            trigger: btn,
            start: "top 95%", // Trigger lower
            end: "bottom 80%",
            scrub: 1,
          },
        });
      });

      // --- Scrub Fade (Generic) ---
      gsap.utils.toArray(".scrub-fade").forEach((el: any) => {
        gsap.fromTo(
          el,
          { opacity: 0, y: 30 },
          {
            opacity: 1,
            y: 0,
            ease: "none",
            scrollTrigger: {
              trigger: el,
              start: "top 95%",
              end: "bottom 80%",
              scrub: 1,
            },
          },
        );
      });

      // --- Scrub Card (Banner) ---
      const scrubCards = document.querySelectorAll(".scrub-card");
      scrubCards.forEach((card) => {
        gsap.to(card, {
          opacity: 1,
          y: 0,
          ease: "none",
          scrollTrigger: {
            trigger: card,
            start: "top 95%",
            end: "center 80%", // Faster reveal
            scrub: 1,
          },
        });
      });

      // --- Fancy Card Scrub Reveal (Right to Left) ---
      const fancyCards = document.querySelectorAll(".fancy-card");
      fancyCards.forEach((card) => {
        const img = card.querySelector(".fancy-image");

        // Optimization: Hint browser
        gsap.set(card, { willChange: "opacity, transform" });

        // Scrub Reveal (Opacity + Slide Left)
        gsap.fromTo(
          card,
          { x: 150, opacity: 0 },
          {
            x: 0,
            opacity: 1,
            ease: "none",
            scrollTrigger: {
              trigger: card,
              start: "top 95%",
              end: "center 65%",
              scrub: 1,
            },
          },
        );

        // Parallax (kept subtle)
        if (img) {
          gsap.fromTo(
            img,
            { scale: 1.15, yPercent: -5 },
            {
              scale: 1,
              yPercent: 5,
              ease: "none",
              scrollTrigger: {
                trigger: card,
                start: "top bottom",
                end: "bottom top",
                scrub: 0.5,
              },
            },
          );
        }
      });

      const masterTl = gsap.timeline({
        defaults: { ease: "power3.out" },
      });

      // Background Parallax
      const heroBg = document.querySelector("#about-hero-bg");
      let currentWidth = window.innerWidth;
      let currentHeight = window.innerHeight;

      if (heroBg) {
        // Function to set dimensions based on hero section size
        const setSvgDimensions = (w: number, h: number) => {
          // We want the SVG to cover the area.
          // Logic is handled by CSS mostly, but we can ensure layout here if needed.
          // For now, rely on CSS (w-full h-full object-cover like behavior)
        };

        let resizeTimer: ReturnType<typeof setTimeout>;
        const handleResize = () => {
          // Debounce resize
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            const heroSection = document.querySelector("#about-hero-section");
            currentWidth = heroSection
              ? heroSection.clientWidth
              : window.innerWidth;
            currentHeight = heroSection
              ? heroSection.clientHeight
              : window.innerHeight;
            setSvgDimensions(currentWidth, currentHeight);
          }, 250); // Debounce resize
        };
        window.addEventListener("resize", handleResize);
        self.add(() => window.removeEventListener("resize", handleResize));

        // Initial state for heroBg (assuming it's an SVG or similar)
        gsap.set(heroBg, {
          opacity: 0,
          scale: 1.15,
          transformOrigin: "center center",
        });

        // Animate In: Scale Down + Fade In
        masterTl.to(heroBg, {
          opacity: 1,
          scale: 1,
          duration: 2.5,
          ease: "elastic.out(1, 0.75)",
        });
      }

      // --- Hero Card Reveal (Decoupled & Robust) ---
      const cardTl = gsap.timeline({ delay: 0.5 });

      // Animate TO visible state (Start state in HTML)
      cardTl.to("#about-hero-image", {
        scale: 1,
        opacity: 1,
        duration: 1.4,
        ease: "expo.out",
      });

      // Stats Reveal (Keeping custom stagger for grid)
      gsap.fromTo(
        ".stat-item",
        { y: 30, opacity: 0 }, // Init from invisible
        {
          y: 0,
          opacity: 1,
          duration: 1,
          stagger: 0.1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: "#about-stats-grid",
            start: "top 95%", // Trigger earlier
          },
        },
      );

      // --- Philosophy Section (Bento Grid) ---
      const bentoCards = document.querySelectorAll(".bento-card");
      if (bentoCards.length > 0) {
        bentoCards.forEach((card, i) => {
          gsap.set(card, { willChange: "transform, opacity" });

          // "Construction" Effect Simplified for 60fps (No Scrub)
          gsap.from(card, {
            y: 80,
            opacity: 0,
            duration: 1.2,
            ease: "power2.out",
            force3D: true, // GPU acceleration
            scrollTrigger: {
              trigger: card,
              start: "top 90%", // Start when it enters viewport
              toggleActions: "play none none reverse",
            },
          });
        });
      }

      // Stats Counter Animation
      const statNumbers = document.querySelectorAll(".stat-number");
      statNumbers.forEach((stat) => {
        const originalText = stat.textContent || "";
        const endValue = parseInt(originalText.replace(/\D/g, "")) || 0;
        const suffix = originalText.replace(/[0-9]/g, "");

        // Reset text immediately to start value to prevent "reload" flash
        stat.textContent = "0" + suffix;

        const counter = { val: 0 };

        gsap.to(counter, {
          val: endValue,
          duration: 2.5,
          ease: "power2.out",
          scrollTrigger: {
            trigger: "#about-story-section", // Changed to story section
            start: "top 75%",
          },
          onUpdate: () => {
            stat.textContent = Math.floor(counter.val) + suffix;
          },
        });
      });

      const revealImageContainers = document.querySelectorAll(".reveal-image");
      revealImageContainers.forEach((container) => {
        gsap.set(container, { willChange: "transform, opacity" }); // Hint browser

        gsap.fromTo(
          container,
          { y: 50, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1.2,
            ease: "power2.out",
            force3D: true, // GPU acceleration
            scrollTrigger: {
              trigger: container,
              start: "top 88%", // Paint separation
            },
          },
        );
      });

      // Slice Reveal Animation (Roll Down)
      const revealRollContainers = document.querySelectorAll(".reveal-roll");
      if (revealRollContainers.length > 0) {
        gsap.fromTo(
          revealRollContainers,
          { clipPath: "inset(0 0 100% 0)" },
          {
            clipPath: "inset(0 0 0% 0)",
            duration: 1.5,
            ease: "power2.out",
            stagger: 0.2,
            scrollTrigger: {
              trigger: "#about-hero-section",
              start: "top 80%",
            },
          },
        );
      }

      // Title & Subtitle Reveal Animation (Clean Slide Up)
      const heroTitle = document.querySelector("#about-hero-title");
      const heroSubtitle = document.querySelector(".about-hero-subtitle");

      if (heroTitle) {
        gsap.to(heroTitle, {
          y: 0,
          opacity: 1,
          duration: 1.5,
          ease: "power3.out",
          delay: 0.2,
          force3D: true,
        });
      }

      if (heroSubtitle) {
        gsap.fromTo(
          heroSubtitle,
          { y: 30, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1.5,
            ease: "power3.out",
            delay: 0.4,
            force3D: true,
          },
        );
      }

      const heroSection = document.querySelector("#about-hero-section");
      const heroContent = document.querySelector("#about-hero-content");

      if (heroSection && heroContent) {
        // Unified parallax behavior for all devices (Mobile Parallax Enabled)

        // Background Parallax (Layered Depth - Not Glued)
        const heroBg = document.querySelector("#about-hero-bg");
        if (heroBg) {
          gsap.to(heroBg, {
            scale: 0.94, // Consistent scale
            opacity: 0,
            filter: "blur(8px)",
            ease: "none",
            scrollTrigger: {
              trigger: heroSection,
              start: "bottom bottom",
              end: "bottom top",
              scrub: 0.5,
              invalidateOnRefresh: true,
            },
          });
        }

        gsap.to(heroContent, {
          scale: 0.9,
          filter: "blur(8px)",
          opacity: 0,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "bottom bottom",
            end: "bottom top",
            scrub: 0.5,
            pin: true, // Enabled on all devices
            pinSpacing: false,
            invalidateOnRefresh: true,
          },
        });
      }
    });
  }

  // Initialize on load (MPA style)
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    setTimeout(initAboutAnimations, 100);
  } else {
    document.addEventListener("DOMContentLoaded", initAboutAnimations);
  }

  // Support for View Transitions
  document.addEventListener("astro:page-load", initAboutAnimations);
  document.addEventListener("astro:before-swap", () => ctx?.revert());
</script>

<style is:global>
  <style is:global>
  /* 
    Ensure body is transparent so fixed footer behind is visible. 
    Also setting html to #050505 to ensure the Safari bottom bar matches the dark footer, not the cream sections.
  */
  html {
    background-color: #050505 !important;
  }
  body {
    background-color: transparent !important;
  }
</style>
