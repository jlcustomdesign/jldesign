---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SITE, absoluteUrl } from "../../config/site";
import { BLOG_PAGE, BREADCRUMBS } from "../../config/content";
import { preferWebp } from "../../utils/prefer-webp";

// In server mode, we get the slug from the URL params
const { slug } = Astro.params;

const posts = await getCollection("blog");
const post = posts.find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect("/blog");
}

const { Content } = await post.render();
const coverImage = preferWebp(post.data.coverImage) || SITE.defaultOgImage;

const categoryLabels = BLOG_PAGE.categoryLabels as Record<string, string>;

// Article JSON-LD schema for Google rich snippets
const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  image: absoluteUrl(coverImage),
  author: {
    "@type": "Organization",
    name: post.data.author || SITE.name,
    url: SITE.url,
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    logo: {
      "@type": "ImageObject",
      url: absoluteUrl(SITE.logo),
    },
  },
  datePublished: post.data.publishedDate,
  dateModified: post.data.publishedDate,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": absoluteUrl(`/blog/${post.slug}`),
  },
});

const formattedDate = new Date(post.data.publishedDate).toLocaleDateString(
  "ro-RO",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
const publishDateString = new Date(post.data.publishedDate).toISOString();
---

<Layout
  title={`${post.data.title} | Blog ${SITE.name}`}
  description={post.data.description}
  image={coverImage}
  type="article"
  breadcrumbs={[
    { name: BREADCRUMBS.home, url: "/" },
    { name: BREADCRUMBS.blog, url: "/blog" },
    { name: post.data.title, url: `/blog/${post.slug}` },
  ]}
>
  <main class="bg-secondary min-h-screen">
    <!-- Article JSON-LD -->
    <script type="application/ld+json" set:html={articleSchema} />

    <article class="max-w-5xl xl:max-w-6xl mx-auto px-4 md:px-8 xl:px-12 pt-32 pb-24">
      <!-- Header -->
      <header class="mb-10 max-w-4xl">
        <div class="flex items-center gap-3 mb-4">
          <a
            href="/blog"
            class="text-xs font-bold uppercase tracking-widest text-accent hover:text-primary transition-colors"
          >
            {BLOG_PAGE.backLink}
          </a>
          <span class="text-primary/20">|</span>
          <span
            class:list={[
              "text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full",
              post.data.category === "ghid"
                ? "bg-accent text-primary"
                : "bg-secondary text-accent",
            ]}
          >
            {categoryLabels[post.data.category] || post.data.category}
          </span>
        </div>
        <h1
          class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-tight mb-4"
        >
          {post.data.title}
        </h1>
        <p class="text-primary/60 text-lg md:text-xl mb-6">
          {post.data.description}
        </p>
        <div class="flex items-center gap-4 text-sm text-primary/50">
          <span
            >{BLOG_PAGE.authorPrefix} <strong class="text-primary/70">{post.data.author}</strong
            ></span
          >
          <span>•</span>
          <time datetime={publishDateString}>{formattedDate}</time>
        </div>
      </header>

      <!-- Cover Image -->
      {
        coverImage && (
          <figure class="mb-12">
            <img
              src={coverImage}
              alt={post.data.coverImageAlt}
              class="w-full max-h-[650px] object-cover rounded-2xl shadow-lg"
              loading="eager"
            />
            <figcaption class="mt-3 text-sm text-primary/40 text-center">
              {post.data.coverImageAlt}
            </figcaption>
          </figure>
        )
      }

      <!-- Markdoc Content -->
      <div
        class="prose prose-lg md:prose-xl prose-stone max-w-none
        prose-headings:font-serif prose-headings:text-primary
        prose-p:text-primary/80 prose-p:leading-relaxed
        prose-a:text-accent prose-a:no-underline hover:prose-a:underline
        prose-img:rounded-xl prose-img:shadow-md
        prose-strong:text-primary
        prose-blockquote:border-accent prose-blockquote:text-primary/70"
      >
        <Content />
      </div>

      <!-- Back to Blog -->
      <div class="mt-16 pt-8 border-t border-primary/10">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-accent font-medium hover:text-primary transition-colors"
        >
          {BLOG_PAGE.backToList}
        </a>
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /* Blog article markdown rendering styles */
  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }
  .prose ul {
    list-style-type: disc !important;
    padding-left: 1.75rem !important;
    margin-top: 1rem !important;
    margin-bottom: 1.5rem !important;
  }
  .prose ol {
    list-style-type: decimal !important;
    padding-left: 1.75rem !important;
    margin-top: 1rem !important;
    margin-bottom: 1.5rem !important;
  }
  .prose li {
    margin-bottom: 0.5rem !important;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.85);
  }
  .prose hr {
    margin: 2.5rem 0 !important;
    border: 0 !important;
    border-top: 1px solid rgba(0, 0, 0, 0.15) !important;
  }
  .prose blockquote {
    border-left: 3px solid var(--color-accent, #FFC800) !important;
    padding-left: 1.25rem !important;
    margin: 1.75rem 0 !important;
    font-style: italic;
    color: rgba(0, 0, 0, 0.7);
  }
  .prose h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary, #000000);
  }
  .prose h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary, #000000);
  }
</style>
