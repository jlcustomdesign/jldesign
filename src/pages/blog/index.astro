---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import { BLOG_PAGE, BREADCRUMBS } from "../../config/content";
import { preferWebp } from "../../utils/prefer-webp";

const posts = await getCollection("blog");

// Sort by publishedDate descending (newest first)
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.publishedDate).getTime();
  const dateB = new Date(b.data.publishedDate).getTime();
  return dateB - dateA;
}).map((post) => ({
  ...post,
  data: {
    ...post.data,
    coverImage: preferWebp(post.data.coverImage),
  },
}));

const categoryLabels = BLOG_PAGE.categoryLabels as Record<string, string>;
---

<Layout
  title={BLOG_PAGE.title}
  description={BLOG_PAGE.description}
  breadcrumbs={[
    { name: BREADCRUMBS.home, url: "/" },
    { name: BREADCRUMBS.blog, url: "/blog" },
  ]}
>
  <main class="bg-secondary min-h-screen">
    <!-- Semantic keywords for AI engines (GEO) -->
    <div class="sr-only">
      {
        Array.isArray(BLOG_PAGE.seoFabric) ? (
          (BLOG_PAGE.seoFabric as string[]).map((paragraph: string) => <p>{paragraph}</p>)
        ) : (
          <p>{BLOG_PAGE.seoFabric}</p>
        )
      }
    </div>

    <!-- Hero -->
    <section class="pt-32 pb-16 px-4 md:px-8 max-w-6xl mx-auto">
      <h1
        class="font-serif text-5xl md:text-7xl text-primary leading-none mb-6"
      >
        {BLOG_PAGE.heroTitle}
      </h1>
      <p class="text-primary/70 text-lg md:text-xl max-w-2xl">
        {BLOG_PAGE.heroSubtitle}
      </p>
    </section>

    <!-- Blog Grid -->
    <section class="px-4 md:px-8 pb-24 max-w-6xl mx-auto">
      {
        sortedPosts.length === 0 ? (
          <div class="text-center py-24">
            <p class="text-primary/50 text-lg">{BLOG_PAGE.emptyState}</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {sortedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="group block bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300"
              >
                {post.data.coverImage && (
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={post.data.coverImage}
                      alt={post.data.coverImageAlt}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-6">
                  <div class="flex items-center gap-3 mb-3">
                    <span
                      class:list={[
                        "text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full",
                        post.data.category === "ghid"
                          ? "bg-accent text-primary"
                          : "bg-secondary text-accent",
                      ]}
                    >
                      {categoryLabels[post.data.category] || post.data.category}
                    </span>
                    <span class="text-xs text-primary/40">
                      {new Date(post.data.publishedDate).toLocaleDateString(
                        "ro-RO",
                        {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        },
                      )}
                    </span>
                  </div>
                  <h2 class="font-serif text-xl text-primary leading-snug mb-2 group-hover:text-accent transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-sm text-primary/60 line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </section>
  </main>
  <Footer slot="footer" />
</Layout>
