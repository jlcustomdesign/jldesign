---
import "../styles/global.css";

const heroImage = "/Images/optimized/hero-image.webp";
---

<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Test Simultaneous Reveal</title>
  </head>
  <body class="bg-secondary text-white overflow-hidden">
    <section
      class="relative w-screen h-screen flex items-center justify-center"
    >
      <!-- Background SVG Container -->
      <div
        class="absolute inset-0 z-0 overflow-hidden flex justify-center items-center"
      >
        <svg
          id="mySVG"
          xmlns="http://www.w3.org/2000/svg"
          width="100%"
          height="100%"
          viewBox="0 0 1920 1080"
          preserveAspectRatio="xMidYMid meet"
          class="w-full h-full opacity-0"
          style="transform-origin: center center;"
        >
          <defs>
            <clipPath id="heroClip">
              <!-- This path will be morphed by the script -->
              <path id="heroPath" fill="white"></path>
            </clipPath>
          </defs>
          <!-- Image masked by the path -->
          <image
            href={heroImage}
            width="100%"
            height="100%"
            preserveAspectRatio="xMidYMid slice"
            clip-path="url(#heroClip)"
            image-rendering="optimizeQuality"
          />
          <!-- Overlay for text contrast -->
          <rect
            width="100%"
            height="100%"
            fill="black"
            opacity="0.3"
            clip-path="url(#heroClip)"></rect>
        </svg>
      </div>

      <div class="relative z-10 text-center pointer-events-none">
        <h1 class="text-4xl md:text-6xl font-serif mb-4">Test Page</h1>
        <p class="text-xl opacity-80 debug-status">Initializing...</p>
      </div>
    </section>

    <script>
      import { initHeroAnim } from "../scripts/simultaneous-reveal";

      // Initialize with hero-anim-2.svg
      // Note: The script has hardcoded logic for specific path IDs (step-3)
      // which exist in hero-anim-2.svg based on my research.
      initHeroAnim("/svg1.svg").then(() => {
        const status = document.querySelector(".debug-status");
        if (status) status.textContent = "Animation Initialized";
      });
    </script>
  </body>
</html>
