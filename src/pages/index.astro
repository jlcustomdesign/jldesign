---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import AboutSection from "../components/AboutSection.astro";
import ServicesSectionV2 from "../components/ServicesSectionV2.astro";
import PortfolioSection from "../components/PortfolioSection.astro";
import ProcessSectionV2 from "../components/ProcessSectionV2.astro";
import BlogPreview from "../components/BlogPreview.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import { HOME } from "../config/content";
---

<Layout title={HOME.title} description={HOME.description.replace('21', String(new Date().getFullYear() - 2005))}>
  <main>
    <!-- Semantic keyword fabric for AI engines (GEO) -->
    <div class="sr-only">
      {HOME.seoFabric.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <HeroSection />
    <ServicesSectionV2 />
    <PortfolioSection />
    <AboutSection />

    <!-- Visible local-SEO text: real copy for users and crawlers, not hidden sr-only -->
    <section class="py-24 bg-secondary" data-theme="light">
      <div class="container mx-auto px-4 md:px-8 max-w-4xl">
        <h2 class="font-serif text-4xl md:text-5xl text-primary mb-8">
          Mobilă la comandă în Brașov
        </h2>
        <p class="text-lg md:text-xl text-primary/80 leading-relaxed mb-6">
          JL Custom Design este un atelier de mobilă la comandă din Brașov,
          cu peste 20 de ani de experiență în mobilier personalizat. Realizăm
          proiecte complete — de la consultanță și măsurători la fața locului,
          la proiectare 3D, producție în atelier propriu și montaj profesional —
          în Brașov și în toată zona centrală a României.
        </p>
        <p class="text-lg md:text-xl text-primary/80 leading-relaxed mb-6">
          Executăm
          <a href="/bucatarii-la-comanda-brasov" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">bucătării la comandă</a>,
          <a href="/dressinguri-la-comanda-brasov" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">dressinguri și dulapuri</a>,
          <a href="/mobila-dormitor-brasov" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">mobilier de dormitor</a>,
          <a href="/mobilier-living-brasov" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">living și biblioteci</a>,
          <a href="/mobila-baie-brasov" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">mobilă de baie</a> și
          <a href="/mobilier-birouri-brasov" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">mobilier pentru birouri și spații comerciale</a>,
          din materiale premium — MDF vopsit, PAL melaminat Egger, lemn masiv
          și furnir natural — cu feronerie Blum, Hettich și Hafele.
        </p>
        <p class="text-lg md:text-xl text-primary/80 leading-relaxed">
          Descoperă <a href="/services" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">serviciile noastre</a>,
          vezi <a href="/portfolio" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">portofoliul de proiecte finalizate</a>
          sau <a href="/contact" class="underline decoration-accent underline-offset-4 hover:text-accent transition-colors">cere o ofertă personalizată</a>.
        </p>
      </div>
    </section>

    <ProcessSectionV2 />
    <BlogPreview />
    <FaqSection />
  </main>
  <Footer slot="footer" />
</Layout>

<script>
  import { initThemeTransition } from "../scripts/theme-transition";
  document.addEventListener("astro:page-load", initThemeTransition);
  // Run immediately mostly for dev HMR or initial load if event misses
  initThemeTransition();
</script>
