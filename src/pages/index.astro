---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import AboutSection from "../components/AboutSection.astro";
import ServicesSectionV2 from "../components/ServicesSectionV2.astro";
import PortfolioSection from "../components/PortfolioSection.astro";
import ProcessSectionV2 from "../components/ProcessSectionV2.astro";
import BlogPreview from "../components/BlogPreview.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import { HOME } from "../config/content";
---

<Layout title={HOME.title} description={HOME.description}>
  <main>
    <!-- Semantic keyword fabric for AI engines (GEO) -->
    <div class="sr-only">
      {HOME.seoFabric.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <HeroSection />
    <AboutSection />
    <ServicesSectionV2 />
    <PortfolioSection />
    <ProcessSectionV2 />
    <BlogPreview />
    <FaqSection />
  </main>
  <Footer slot="footer" />
</Layout>

<script>
  import { initThemeTransition } from "../scripts/theme-transition";
  
  const init = () => {
    // Optimization: Defer theme tracking to allow Hero/FCP to stabilize
    const deferFn = window.requestIdleCallback || ((cb) => setTimeout(cb, 500));
    deferFn(() => initThemeTransition());
  };

  document.addEventListener("astro:page-load", init);
  // Also run on first load
  if (document.readyState === 'complete') {
    init();
  } else {
    window.addEventListener('load', init);
  }
</script>
