---
const currentYear = new Date().getFullYear();
import BubbleButton from "./ui/BubbleButton.astro";
import { FOOTER } from "../config/content";
---

<footer
  class="bg-secondary pt-8 pb-[calc(1rem+env(safe-area-inset-bottom))] md:pt-16 md:pb-[calc(2rem+env(safe-area-inset-bottom))] px-4 md:px-8 relative overflow-hidden pointer-events-auto z-50"
  data-theme="light"
  id="main-footer"
>
  <div class="container mx-auto relative z-10">
    <!-- Big Footer Card -->
    <div
      class="footer-card bg-primary text-white rounded-[2.5rem] p-6 md:p-8 lg:p-10 relative overflow-hidden shadow-2xl pointer-events-auto"
      style="will-change: transform"
    >
      <!-- Background Texture REMOVED as requested -->

      <!-- Main Content Grid -->
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative z-10 items-center"
      >
        <!-- Left Column: CTA & Brand -->
        <div
          class="lg:col-span-7 flex flex-col justify-center h-full text-center lg:text-left items-center lg:items-start"
        >
          <div>
            <h2
              class="font-serif text-3xl md:text-5xl lg:text-6xl leading-none mb-6"
              set:html={FOOTER.headline}
            />
          </div>

          <!-- Call Buttons using BubbleButton -->
          <div
            class="flex flex-wrap gap-3 mt-6 md:mt-8 justify-center lg:justify-start"
          >
            <BubbleButton
              href={FOOTER.contactPhoneHref}
              variant="primary"
              class="px-8 py-4 text-base"
            >
              {FOOTER.ctaPrimary}
            </BubbleButton>

            <BubbleButton
              href="/contact"
              variant="outline-white"
              class="px-8 py-4 text-base hover:border-accent"
            >
              {FOOTER.ctaSecondary}
            </BubbleButton>
          </div>
        </div>

        <!-- Right Column: Navigation -->
        <!-- Added mt-12 for downward spacing as requested -->
        <div
          class="lg:col-span-5 flex flex-col items-center lg:items-end justify-between h-full mt-8 lg:mt-24"
        >
          <div
            class="grid grid-cols-2 gap-6 lg:gap-12 text-center lg:text-right w-full lg:w-auto"
          >
            <!-- Menu -->
            <div class="space-y-4">
              <h3
                class="text-accent text-xs font-bold uppercase tracking-widest"
              >
                {FOOTER.menuTitle}
              </h3>
              <ul class="space-y-2 font-medium text-base text-white/80">
                {
                  FOOTER.menuLinks.map((link) => (
                    <li>
                      <a href={link.href} class="hover:text-white transition-colors"
                        >{link.name}</a
                      >
                    </li>
                  ))
                }
              </ul>
            </div>

            <!-- Contact -->
            <div class="space-y-4">
              <h3
                class="text-accent text-xs font-bold uppercase tracking-widest"
              >
                {FOOTER.contactTitle}
              </h3>
              <ul class="space-y-2 text-white/70 text-sm">
                <li>{FOOTER.contactLocation}</li>
                <li>
                  <a
                    href={FOOTER.contactPhoneHref}
                    class="hover:text-white transition-colors"
                    >{FOOTER.contactPhone}</a
                  >
                </li>
                <li>
                  <a
                    href={FOOTER.contactEmailHref}
                    class="hover:text-white transition-colors"
                    >{FOOTER.contactEmail}</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="w-full h-px bg-white/10 my-6 md:my-8"></div>

      <!-- Bottom Bar -->
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/60"
      >
        <p>&copy; {currentYear} {FOOTER.copyright}</p>

        <p class="text-center md:text-left">
          {FOOTER.designCredit}
          <a
            href={FOOTER.designCreditUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-accent font-medium transition-colors"
          >
            {FOOTER.designCreditLink}
          </a>
        </p>

        <div class="flex gap-6">
          <a href="#" class="hover:text-white transition-colors"
            >{FOOTER.privacyLink}</a
          >
          <a href="#" class="hover:text-white transition-colors"
            >{FOOTER.termsLink}</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer styles cleaned up */
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initFooterParallax() {
    const footer = document.querySelector("#main-footer") as HTMLElement;
    // We target #smooth-content for appending if needed
    const smoothContent = document.querySelector("#smooth-content");
    const main = document.querySelector("main") as HTMLElement;

    if (!footer || !main) return;

    // Flag to prevent multiple inits, but we allow re-init on resize now
    if (!footer.dataset.parallaxInitialized) {
      footer.dataset.parallaxInitialized = "true";
    }

    const isMobile = window.innerWidth < 1024 || "ontouchstart" in window;

    const updateFooterLayout = () => {
      // UNCONDITIONAL RELATIVE MODE
      // Logic: Always treat footer as part of the scroll flow to guarantee clickability.

      const h = footer.offsetHeight;

      // 1. DOM: Already inside smooth-content via Layout.astro

      // 2. Styles (Nuclear Option)
      footer.style.position = "relative";
      footer.style.width = "100%";
      footer.style.zIndex = "9999"; // Nuclear Z-Index
      footer.style.pointerEvents = "auto";
      footer.style.left = "auto";
      footer.style.bottom = "auto";
      footer.style.height = "auto";
      // Removed forced margins to eliminate white line gap
      footer.style.clear = "both";

      // 3. Cleanup Parallax Spacer (if it exists from old logic)
      const spacer = document.getElementById("footer-spacer");
      if (spacer) {
        spacer.style.display = "none";
        spacer.remove(); // Remove it entirely to be safe
      }

      // 4. Reset Parallax Transform
      const footerCard = footer.querySelector(".footer-card");
      if (footerCard) {
        gsap.set(footerCard, { y: 0, scale: 1, filter: "none" });
      }

      // Force refresh multiple times to handle async layout shifts
      ScrollTrigger.refresh();
      setTimeout(() => ScrollTrigger.refresh(), 100);
      setTimeout(() => ScrollTrigger.refresh(), 500);
    };

    // Run Updates
    requestAnimationFrame(updateFooterLayout);

    let lastWidth = window.innerWidth;
    let lastHeight = window.innerHeight;

    window.addEventListener("resize", () => {
      const currentWidth = window.innerWidth;
      const currentHeight = window.innerHeight;

      // Re-run on width change or significant height change
      if (
        Math.abs(currentWidth - lastWidth) > 50 ||
        Math.abs(currentHeight - lastHeight) > 100
      ) {
        lastWidth = currentWidth;
        lastHeight = currentHeight;
        requestAnimationFrame(updateFooterLayout);
      }
    });
  }

  document.addEventListener("astro:page-load", initFooterParallax);
  if (document.readyState === "complete") initFooterParallax();
  else window.addEventListener("load", initFooterParallax);
</script>
