---
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-secondary pt-20 pb-10 px-4 md:px-8 relative"
  data-theme="light"
  id="main-footer"
>
  <div class="container mx-auto h-full flex flex-col justify-center">
    <!-- Big Card -->
    <div
      class="footer-card bg-primary rounded-[2.5rem] p-12 md:p-20 text-white relative overflow-hidden shadow-2xl w-full"
      data-theme="dark"
      style="will-change: transform, filter;"
    >
      <!-- Decorative Glow -->
      <div
        class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent/10 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/2 pointer-events-none"
      >
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 relative z-10"
      >
        <!-- Brand & CTA -->
        <div class="lg:col-span-7 flex flex-col justify-between h-full">
          <div>
            <h2
              class="font-serif text-4xl md:text-5xl lg:text-6xl xl:text-7xl mb-8 leading-tight"
            >
              Să construim ceva <br />
              <span class="text-accent">remarcabil.</span>
            </h2>
            <a
              href="/contact"
              class="inline-flex items-center gap-4 text-xl md:text-2xl font-medium group hover:text-accent transition-colors"
            >
              <span
                class="border-b border-white/30 pb-1 group-hover:border-accent transition-colors"
                >Discută cu noi</span
              >
              <span
                class="group-hover:translate-x-2 transition-transform duration-300"
                >→</span
              >
            </a>
          </div>
        </div>

        <!-- Links -->
        <div class="lg:col-span-2 lg:col-start-8">
          <h4
            class="text-accent uppercase tracking-wider text-sm font-semibold mb-6"
          >
            Meniu
          </h4>
          <ul class="space-y-4">
            <li>
              <a
                href="/"
                class="text-white/70 hover:text-accent transition-colors relative group inline-block"
                >Acasă
                <span
                  class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
                ></span>
              </a>
            </li>
            <li>
              <a
                href="/about"
                class="text-white/70 hover:text-accent transition-colors relative group inline-block"
                >Despre Noi
                <span
                  class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
                ></span>
              </a>
            </li>
            <li>
              <a
                href="/services"
                class="text-white/70 hover:text-accent transition-colors relative group inline-block"
                >Servicii
                <span
                  class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
                ></span>
              </a>
            </li>
            <li>
              <a
                href="/portfolio"
                class="text-white/70 hover:text-accent transition-colors relative group inline-block"
                >Portofoliu
                <span
                  class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
                ></span>
              </a>
            </li>
            <li>
              <a
                href="/contact"
                class="text-white/70 hover:text-accent transition-colors relative group inline-block"
                >Contact
                <span
                  class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
                ></span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Socials & Contact -->
        <div class="lg:col-span-3">
          <h4
            class="text-accent uppercase tracking-wider text-sm font-semibold mb-6"
          >
            Contact
          </h4>
          <ul class="space-y-4 mb-10">
            <li class="text-white/70">
              Strada Exemplului Nr. 10,<br />București, Sector 1
            </li>
            <li>
              <a
                href="tel:+40700000000"
                class="text-white/70 hover:text-accent transition-colors relative group inline-block"
                >+40 700 000 000
                <span
                  class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
                ></span>
              </a>
            </li>
            <li>
              <a
                href="mailto:contact@jlmobila.ro"
                class="text-white/70 hover:text-accent transition-colors relative group inline-block"
                >contact@jlmobila.ro
                <span
                  class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
                ></span>
              </a>
            </li>
          </ul>

          <div class="flex gap-4">
            <!-- Social Icons placeholders -->
            <a
              href="#"
              class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-primary transition-all"
              >FB</a
            >
            <a
              href="#"
              class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-white hover:text-primary transition-all"
              >IG</a
            >
          </div>
        </div>
      </div>

      <div
        class="border-t border-white/10 mt-20 pt-8 flex flex-col md:flex-row justify-between items-center text-white/40 text-sm"
      >
        <p>&copy; {currentYear} JL Mobila. Toate drepturile rezervate.</p>
        <div class="flex gap-6 mt-4 md:mt-0">
          <a href="#" class="hover:text-accent relative group inline-block"
            >Termeni și Condiții
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
          <a href="#" class="hover:text-accent relative group inline-block"
            >Politica de Confidențialitate
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"
            ></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initFooterParallax() {
    const footer = document.querySelector("#main-footer") as HTMLElement;
    const main = document.querySelector("main") as HTMLElement;

    if (!footer || !main) return;
    // Avoid double init
    if (footer.dataset.parallaxInitialized) return;
    footer.dataset.parallaxInitialized = "true";

    const isMobile = window.innerWidth < 1024 || "ontouchstart" in window;

    // 1. Setup Logic
    // 1. Setup Logic wrapped in a function to handle Resize correctly
    const updateFooterLayout = () => {
      const h = footer.offsetHeight;
      const viewportH = window.innerHeight;

      // Re-check conditions on resize
      // We use window.innerWidth check inside to handle orientation changes
      const currentIsMobile =
        window.innerWidth < 1024 || "ontouchstart" in window;
      const shouldDisableParallax = currentIsMobile || h > viewportH;

      let spacer = document.getElementById("footer-spacer");
      if (!spacer) {
        spacer = document.createElement("div");
        spacer.id = "footer-spacer";
        main.appendChild(spacer);
      }

      if (shouldDisableParallax) {
        // -- STATIC LAYOUT (Mobile/Tall) --
        footer.style.position = "relative";
        footer.style.zIndex = "20";
        footer.style.bottom = "auto";
        footer.style.left = "auto";

        // Remove spacer usage
        spacer.style.height = "0px";
        spacer.style.display = "none";
        main.style.marginBottom = "0px"; // CRITICAL: Ensure no gap

        // Reset transforms
        const footerCard = footer.querySelector(".footer-card");
        if (footerCard) gsap.set(footerCard, { clearProps: "all" });
      } else {
        // -- PARALLAX LAYOUT (Desktop/Short) --
        footer.style.position = "fixed";
        footer.style.left = "0";
        footer.style.bottom = "0";
        footer.style.width = "100%";
        footer.style.zIndex = "0";

        spacer.style.display = "block";
        spacer.style.height = `${h}px`;
        spacer.style.pointerEvents = "none";

        main.style.position = "relative";
        main.style.zIndex = "10";
        // Check if we need to re-apply margin?
        // Actually with spacer div, we usually don't need margin-bottom on main if spacer is in flow?
        // Wait, previous code used main.marginBottom logic?
        // NO, previous code used SPACER for trigger but main.marginBottom = h in the resize bug.
        // Let's stick to SPACER taking up the space.
        // BUT: if Main is zIndex 10 and Relative, and Footer is Fixed zIndex 0,
        // We need a visual gap in the 'flow' for the footer to be revealed behind.
        // The SPACER (div appended to main) provides this height in the flow of Main.
        // So main.marginBottom should actually be 0 if we use a real spacer div inside main?
        // Let's ensure main.marginBottom IS 0 to avoid double spacing.
        main.style.marginBottom = "0px";

        const footerCard = footer.querySelector(".footer-card");

        if (footerCard) {
          gsap.fromTo(
            footerCard,
            {
              scale: 0.8,
              filter: "blur(20px)",
              y: -50,
            },
            {
              scale: 1,
              filter: "blur(0px)",
              y: 0,
              ease: "none",
              scrollTrigger: {
                trigger: spacer,
                start: "top bottom",
                end: "bottom bottom",
                scrub: true,
              },
            }
          );
        }
      }

      ScrollTrigger.refresh();
    };

    // Run Once
    requestAnimationFrame(updateFooterLayout);

    // Run on Resize
    // Run on Resize (Width only check)
    let lastWidth = window.innerWidth;
    window.addEventListener("resize", () => {
      const currentWidth = window.innerWidth;
      // Ignore height-only resizes (mobile chrome)
      if (currentWidth !== lastWidth) {
        lastWidth = currentWidth;
        updateFooterLayout();
      }
    });
  }

  // Initialize only on Astro navigation/load
  document.addEventListener("astro:page-load", initFooterParallax);
  // Initial load fallback
  if (document.readyState === "complete") {
    initFooterParallax();
  } else {
    window.addEventListener("load", initFooterParallax);
  }
</script>
