---
import BubbleButton from "./ui/BubbleButton.astro";

const services = [
  {
    id: "kitchen",
    num: "/01",
    title: "Bucătării Custom",
    desc: "Inima casei tale, regândită. Funcționalitate desăvârșită îmbrăcată în materiale nobile.",
    img: "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?q=80&w=2000&auto=format&fit=crop",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-primary"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`
  },
  {
    id: "dressing",
    num: "/02",
    title: "Dressing & Wardrobes",
    desc: "Mai mult decât depozitare. Un sanctuar al stilului tău. Iluminare ambientală și finisaje de catifea.",
    img: "https://images.unsplash.com/photo-1595428774223-ef52624120d2?q=80&w=2000&auto=format&fit=crop",
    isAlt: true
  },
  {
    id: "living",
    num: "/03",
    title: "Living & Library",
    desc: "Povestea casei, scrisă în lemn masiv. Biblioteci impunătoare și piese care dau tonul conversației.",
    img: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2000&auto=format&fit=crop",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-primary"><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`
  },
  {
    id: "office",
    num: "/04",
    title: "Office & Comercial",
    desc: "Productivitate și stil. Spații de lucru ergonomice care impresionează clienții din prima clipă.",
    img: "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2000&auto=format&fit=crop",
    isAlt: true
  },
  {
    id: "bathroom",
    num: "/05",
    title: "Baie & Wellness",
    desc: "Refugiul tău personal. Mobilier rezistent la umiditate, integrat perfect cu piatra și ceramica.",
    img: "https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?q=80&w=2000&auto=format&fit=crop",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-primary"><path d="M4 4h16v16H4V4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`
  },
];
---

<section
  id="services-section"
  class="py-24 md:py-40 bg-[#0a0a0a] text-white overflow-hidden"
  data-theme="dark"
>
  <div class="container mx-auto px-4 md:px-8">
    <!-- Header -->
    <div class="mb-20">
      <div class="text-[10px] uppercase tracking-[0.3em] text-white/40 mb-8 font-mono">
        [ SERVICII ]
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <h2 class="lg:col-span-7 font-serif text-5xl md:text-7xl lg:text-8xl leading-[1.1] reveal-text" data-reveal="slide">
          Cum transformăm <br /> viziunea în realitate
        </h2>
        <div class="lg:col-span-5 lg:pt-4">
          <p class="text-white/60 text-lg md:text-xl max-w-md reveal-text" data-reveal="slide" data-reveal-delay="0.2">
            Creăm mobilier care nu doar ocupă spațiul, ci îl definește. De la concept la montaj, fiecare proiect este o călătorie către perfecțiune.
          </p>
        </div>
      </div>
    </div>

    <!-- Cards Carousel -->
    <div class="relative">
      <div 
        id="services-carousel" 
        class="flex gap-6 overflow-x-auto pb-12 snap-x snap-mandatory no-scrollbar cursor-grab active:cursor-grabbing"
      >
        {
          services.map((service, i) => (
            <div 
              class="snap-start shrink-0 w-[85vw] md:w-[45vw] lg:w-[30%] group"
              data-index={i}
            >
              <div class="relative aspect-[4/5] rounded-[2rem] overflow-hidden border border-white/10 bg-white/5 backdrop-blur-3xl p-8 flex flex-col justify-between transition-all duration-500 hover:border-white/20 hover:bg-white/10">
                {service.isAlt ? (
                  // Image Style Card
                  <>
                    <img 
                      src={service.img} 
                      alt={service.title}
                      class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-40 transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/80" />
                    
                    <div class="relative z-10 flex justify-end">
                      <span class="font-mono text-sm tracking-widest text-white/40">{service.num}</span>
                    </div>
                    
                    <div class="relative z-10 text-center px-4">
                      <h3 class="font-serif text-3xl md:text-4xl leading-tight">
                        {service.title}
                      </h3>
                    </div>

                    <div class="relative z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                       <!-- Empty space to maintain layout -->
                    </div>
                  </>
                ) : (
                  // Content Style Card
                  <>
                    <div class="flex justify-between items-start">
                      <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center backdrop-blur-md" set:html={service.icon} />
                      <span class="font-mono text-sm tracking-widest text-white/40">{service.num}</span>
                    </div>

                    <div class="space-y-4">
                      <h3 class="font-serif text-3xl md:text-4xl leading-tight">
                        {service.title}
                      </h3>
                      <p class="text-white/60 text-base leading-relaxed line-clamp-3 group-hover:line-clamp-none transition-all duration-300">
                        {service.desc}
                      </p>
                    </div>
                  </>
                )}
              </div>
            </div>
          ))
        }
        <!-- Spacer for the "visible but cropped" effect -->
        <div class="shrink-0 w-[5vw] lg:w-[10%]" />
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-20 flex justify-center">
      <BubbleButton 
        href="/contact" 
        variant="primary" 
        class="!px-12 !py-5 !text-sm"
      >
        Cere o ofertă
      </BubbleButton>
    </div>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Optional: Glassmorphism enhancement */
  .backdrop-blur-3xl {
    backdrop-filter: blur(64px);
    -webkit-backdrop-filter: blur(64px);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initServicesAnim() {
    const section = document.querySelector("#services-section");
    const carousel = document.querySelector("#services-carousel");
    const cards = document.querySelectorAll("#services-carousel > div");

    if (!section || !carousel) return;

    // Horizontal drag/scroll check
    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      carousel.classList.add('active');
      startX = (e as MouseEvent).pageX - (carousel as HTMLElement).offsetLeft;
      scrollLeft = (carousel as HTMLElement).scrollLeft;
    });

    carousel.addEventListener('mouseleave', () => {
      isDown = false;
      carousel.classList.remove('active');
    });

    carousel.addEventListener('mouseup', () => {
      isDown = false;
      carousel.classList.remove('active');
    });

    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = (e as MouseEvent).pageX - (carousel as HTMLElement).offsetLeft;
      const walk = (x - startX) * 2;
      (carousel as HTMLElement).scrollLeft = scrollLeft - walk;
    });

    // Reveal Animation
    gsap.from(cards, {
      scrollTrigger: {
        trigger: carousel,
        start: "top 80%",
      },
      y: 100,
      opacity: 0,
      stagger: 0.1,
      duration: 1,
      ease: "power4.out"
    });
  }

  document.addEventListener("astro:page-load", initServicesAnim);
  initServicesAnim();
</script>
