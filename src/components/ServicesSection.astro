---
import BubbleButton from "./ui/BubbleButton.astro";
import { SERVICES_SECTION } from "../config/content";

const services = [
  {
    id: "kitchen",
    title: "Bucătării Custom",
    desc: "Inima casei tale, regândită. Funcționalitate desăvârșită îmbrăcată în materiale nobile.",
    img: "/Images/optimized/Proiecte-JL-Custom-Design-01.webp",
  },
  {
    id: "dressing",
    title: "Dressing & Wardrobes",
    desc: "Mai mult decât depozitare. Un sanctuar al stilului tău. Iluminare ambientală și finisaje de catifea.",
    img: "/Images/optimized/Proiecte-JL-Custom-Design-11.webp",
  },
  {
    id: "living",
    title: "Living & Library",
    desc: "Povestea casei, scrisă în lemn masiv. Biblioteci impunătoare și piese care dau tonul conversației.",
    img: "/Images/optimized/Proiecte-JL-Custom-Design-02.webp",
  },
  {
    id: "office",
    title: "Office & Comercial",
    desc: "Productivitate și stil. Spații de lucru ergonomice care impresionează clienții din prima clipă.",
    img: "/Images/optimized/Proiecte-JL-Custom-Design-24.webp",
  },
  {
    id: "bathroom",
    title: "Baie & Wellness",
    desc: "Refugiul tău personal. Mobilier rezistent la umiditate, integrat perfect cu piatra și ceramica.",
    img: "/Images/optimized/Proiecte-JL-Custom-Design-18.webp",
  },
];
---

<section
  id="services-section"
  class="relative w-full bg-secondary py-20 overflow-hidden"
>
  <div class="container mx-auto px-4 mb-12">
    <h2 class="font-serif text-4xl md:text-6xl text-primary mb-4">{SERVICES_SECTION.title}</h2>
  </div>

  <!-- Native Horizontal Scroll Container -->
  <div 
    class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-6 px-4 md:px-[10%] pb-12 cursor-grab active:cursor-grabbing"
    id="services-scroll-container"
  >
    {
      services.map((service, i) => (
        <div class="flex-shrink-0 w-[85vw] md:w-[600px] snap-center group">
          <div class="relative aspect-[16/10] md:aspect-[16/9] rounded-[2.5rem] overflow-hidden shadow-2xl bg-gray-900">
            <img
              src={service.img}
              alt={service.title}
              loading="lazy"
              draggable="false"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            
            <div class="absolute bottom-0 left-0 w-full p-8 md:p-12">
               <div class="font-sans text-xs text-accent tracking-[0.3em] uppercase mb-3 opacity-80">
                {(i + 1).toString().padStart(2, "0")} — Servicii
              </div>
              <h3 class="font-serif text-3xl md:text-5xl text-white mb-4">
                {service.title}
              </h3>
              <p class="text-white/70 text-base md:text-lg max-w-md mb-8 line-clamp-2">
                {service.desc}
              </p>
              <div class="pointer-events-auto">
                <BubbleButton
                  href={`/services/${service.id}`}
                  variant="primary"
                  class="px-8 py-3 text-sm"
                >
                  Explorează
                </BubbleButton>
              </div>
            </div>
          </div>
        </div>
      ))
    }
    <!-- Extra spacing at end for snap-center to work nicely -->
    <div class="flex-shrink-0 w-[1px] h-full"></div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch; /* Smooth momentum scroll on iOS */
    touch-action: pan-x; /* Prioritize horizontal swiping over vertical page scroll */
    user-select: none; /* Prevent text selection during drag */
  }
</style>

<script>
  let isInitialized = false;

  function initNativeScroll() {
    const slider = document.getElementById('services-scroll-container') as HTMLElement;
    if (!slider || isInitialized) return;
    isInitialized = true;

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    slider.addEventListener('mousedown', (e: MouseEvent) => {
      // Don't intercept clicks on buttons or links
      const target = e.target as HTMLElement;
      if (target.closest('a') || target.closest('button')) return;

      isDown = true;
      slider.style.cursor = 'grabbing';
      slider.style.scrollSnapType = 'none';
      slider.style.scrollBehavior = 'auto'; // CRITICAL: prevents browser scroll-queueing bugs
      
      startX = e.pageX;
      scrollLeft = slider.scrollLeft;
    });

    const stopDragging = () => {
      if (!isDown) return;
      isDown = false;
      slider.style.cursor = 'grab';
      slider.style.scrollSnapType = 'x mandatory';
    };

    window.addEventListener('mouseup', stopDragging);
    
    // Also stop dragging if mouse leaves the whole browser window
    document.documentElement.addEventListener('mouseleave', stopDragging);

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDown) return;
      e.preventDefault(); // Stop text selection
      const x = e.pageX;
      const walk = (x - startX) * 1.5; // Smooth 1.5x multiplier
      slider.scrollLeft = scrollLeft - walk;
    });
  }

  // Initialize
  initNativeScroll();
  document.addEventListener('astro:page-load', () => {
    isInitialized = false;
    initNativeScroll();
  });
</script>
