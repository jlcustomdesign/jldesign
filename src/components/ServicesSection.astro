---
import BubbleButton from "./ui/BubbleButton.astro";

const services = [
  {
    id: "kitchen",
    title: "Bucătării Custom",
    desc: "Inima casei tale, regândită. Funcționalitate desăvârșită îmbrăcată în materiale nobile.",
    img: "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?q=80&w=2000&auto=format&fit=crop",
  },
  {
    id: "dressing",
    title: "Dressing & Wardrobes",
    desc: "Mai mult decât depozitare. Un sanctuar al stilului tău. Iluminare ambientală și finisaje de catifea.",
    img: "https://images.unsplash.com/photo-1595428774223-ef52624120d2?q=80&w=2000&auto=format&fit=crop",
  },
  {
    id: "living",
    title: "Living & Library",
    desc: "Povestea casei, scrisă în lemn masiv. Biblioteci impunătoare și piese care dau tonul conversației.",
    img: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2000&auto=format&fit=crop",
  },
  {
    id: "office",
    title: "Office & Comercial",
    desc: "Productivitate și stil. Spații de lucru ergonomice care impresionează clienții din prima clipă.",
    img: "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2000&auto=format&fit=crop",
  },
  {
    id: "bathroom",
    title: "Baie & Wellness",
    desc: "Refugiul tău personal. Mobilier rezistent la umiditate, integrat perfect cu piatra și ceramica.",
    img: "https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?q=80&w=2000&auto=format&fit=crop",
  },
];
---

<section
  id="services-fullscreen-wrapper"
  class="relative h-screen bg-white overflow-hidden text-primary"
  data-theme="light"
>
  <!-- BACKGROUNDS LAYER (Wrapped in Card) -->
  <div
    class="absolute inset-0 w-full h-full z-0 flex items-center justify-center"
  >
    <div class="w-[90%] h-[90%] rounded-3xl overflow-hidden relative bg-white">
      {
        services.map((service, i) => (
          <div
            class="service-bg absolute inset-0 w-full h-full will-change-transform z-10"
            data-index={i}
          >
            <div class="w-full h-full relative">
              {[0, 1, 2, 3, 4].map((k) => (
                <div
                  class="service-slice absolute top-0 bottom-0 h-full overflow-hidden bg-white rounded-3xl"
                  style={`left: ${k * 20}%; width: 20%;`}
                >
                  <img
                    src={service.img}
                    alt={service.title}
                    loading="lazy"
                    class="absolute top-0 bottom-0 h-full max-w-none object-cover"
                    style={`left: -${k * 100}%; width: 500%;`}
                  />
                  <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none" />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- CONTENT LAYER -->
  <div
    class="relative z-10 w-full h-full flex items-center justify-center pointer-events-none"
  >
    <!-- HEADER REMOVED -->

    <!-- SLIDES LOOP -->
    {
      services.map((service, i) => (
        <div
          class="service-content absolute w-full max-w-4xl px-8 md:px-20 text-center flex flex-col items-center opacity-0 translate-y-10"
          data-index={i}
        >
          <div class="font-sans text-xs md:text-sm text-accent tracking-[0.3em] uppercase mb-6">
            {(i + 1).toString().padStart(2, "0")} — Servicii
          </div>
          <h2 class="font-serif font-bold text-5xl md:text-8xl mb-8 leading-tight text-white">
            {service.title}
          </h2>
          <p class="font-sans text-lg md:text-2xl text-secondary/90 leading-relaxed max-w-2xl mb-12 font-light">
            {service.desc}
          </p>
          <div class="pointer-events-auto">
            <BubbleButton
              href={`/services/${service.id}`}
              variant="primary"
              class="px-8 py-4"
            >
              Explorează
            </BubbleButton>
          </div>
        </div>
      ))
    }
  </div>
  <!-- SKIP BUTTON: Single rotating button deeper inside card -->
  <button
    id="skip-btn"
    class="absolute bottom-20 right-[10%] translate-x-1/2 z-50 bg-black/20 backdrop-blur-md border border-white/20 text-white rounded-full p-4 hover:bg-black/40 transition-all duration-300 cursor-pointer shadow-xl pointer-events-auto"
    aria-label="Skip Navigation"
  >
    <svg
      id="skip-arrow"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      class="w-6 h-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
    </svg>
  </button>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger, Observer, ScrollToPlugin } from "gsap/all";

  gsap.registerPlugin(ScrollTrigger, Observer, ScrollToPlugin);

  initFullscreenScroll();
  document.addEventListener("astro:page-load", initFullscreenScroll);

  function initFullscreenScroll() {
    const wrapper = document.querySelector("#services-fullscreen-wrapper");
    const bgs = gsap.utils.toArray(".service-bg") as HTMLElement[];
    const contents = gsap.utils.toArray(".service-content") as HTMLElement[];
    const skipBtn = document.querySelector("#skip-btn") as HTMLElement;
    const skipArrow = document.querySelector("#skip-arrow") as HTMLElement;

    if (!wrapper) return;

    const totalSlides = bgs.length;

    // INITIAL STATE SETUP
    const allSlices = gsap.utils.toArray(".service-slice") as HTMLElement[];
    gsap.set(allSlices, { yPercent: 100 }); // reset slices
    gsap.set(bgs, { autoAlpha: 1, zIndex: 1 });
    gsap.set(contents, { autoAlpha: 0, y: 50 });

    // Show first slide
    gsap.set(bgs[0], { zIndex: 2 });
    gsap.set(contents[0], { autoAlpha: 1, y: 0 });

    // Helper: Update Skip Button
    function updateSkipButtonState(progress: number) {
      if (!skipBtn || !skipArrow) return;
      const isEnd = progress > 0.9;
      gsap.to(skipArrow, {
        rotation: isEnd ? 180 : 0,
        duration: 0.5,
        ease: "back.out(1.7)",
        overwrite: true,
      });
    }

    // Skip Button Click Logic
    if (skipBtn) {
      skipBtn.addEventListener("click", (e) => {
        e.preventDefault();
        // Just scroll to start or end based on current rotation
        const isEnd = (gsap.getProperty(skipArrow, "rotation") as number) > 90;
        const st = ScrollTrigger.getById("services-pin");
        if (st) {
          gsap.to(window, {
            scrollTo: isEnd ? st.start : st.end,
            duration: 1.5,
            ease: "power2.inOut",
          });
        }
      });
    }

    // --------------------------------------------------------------------------
    // DETECTION & BRANCHING
    // --------------------------------------------------------------------------
    const isMobile = window.innerWidth < 1024 || "ontouchstart" in window;

    if (isMobile) {
      initMobileScrub();
    } else {
      initDesktopObserver();
    }

    // --------------------------------------------------------------------------
    // MOBILE STRATEGY: NATIVE SCRUB (Smooth, Native feel, No Hijacking)
    // --------------------------------------------------------------------------
    function initMobileScrub() {
      const tl = gsap.timeline({
        scrollTrigger: {
          id: "services-pin",
          trigger: wrapper,
          start: "top top",
          end: "+=" + totalSlides * 100 + "%", // scroll distance based on slide count
          pin: true,
          scrub: 0.5, // smooth scrubbing
          onUpdate: (self) => updateSkipButtonState(self.progress),
        },
      });

      // Loop through slides 1 to N to create transitions
      for (let i = 0; i < totalSlides - 1; i++) {
        const nextSlideIndex = i + 1;
        const currBg = bgs[i];
        const nextBg = bgs[nextSlideIndex];
        const currContent = contents[i];
        const nextContent = contents[nextSlideIndex];
        const nextSlices = nextBg.querySelectorAll(".service-slice");

        // Ensure next BG is above current
        // We use zIndex purely to stack them correctly.
        // Since we are scrubbing, we just need the next one to appear on top.

        // Step: Bring next slices up
        tl.to(nextSlices, {
          yPercent: 0,
          duration: 1,
          stagger: 0.05,
          ease: "none", // Scrub needs linear ease usually
        });

        // Step: Fade/Move Content
        tl.fromTo(
          currContent,
          { autoAlpha: 1, y: 0 },
          { autoAlpha: 0, y: -50, duration: 0.5, ease: "none" },
          "<"
        );
        tl.fromTo(
          nextContent,
          { autoAlpha: 0, y: 50 },
          { autoAlpha: 1, y: 0, duration: 0.5, ease: "none" },
          "<+0.5"
        );

        // Add a small pause/gap between slides? No, continuous is better for mobile
        tl.addLabel("slide-" + nextSlideIndex);
      }
    }

    // --------------------------------------------------------------------------
    // DESKTOP STRATEGY: OBSERVER + SNAPPING (The "Deck" feel)
    // --------------------------------------------------------------------------
    function initDesktopObserver() {
      // Reuse the original logic but encapsulated
      let currentIndex = 0;
      let isAnimating = false;

      // ... Copy of original gotoSlide logic ...
      // To save space/complexity in this edit, I will adapt the structure
      // But essentially we keep the exact same logic as before, just wrapped here.

      // RE-IMPLEMENTING ORIGINAL DESKTOP LOGIC CONCISELY:

      function gotoSlide(index: number, direction: number) {
        if (isAnimating) return;
        isAnimating = true;

        const prevBg = bgs[currentIndex];
        const nextBg = bgs[index];
        const prevContent = contents[currentIndex];
        const nextContent = contents[index];
        const nextSlices = nextBg.querySelectorAll(".service-slice");
        const prevSlices = prevBg.querySelectorAll(".service-slice");

        updateSkipButtonState(index / (totalSlides - 1));

        // Sync Scrollbar
        const st = ScrollTrigger.getById("services-pin");
        if (st) {
          const progress = index / (totalSlides - 1);
          const scrollPos = st.start + (st.end - st.start) * progress;
          gsap.to(window, {
            scrollTo: scrollPos,
            duration: 1.2,
            ease: "power2.out",
            overwrite: true,
          });
        }

        gsap.set(prevBg, { zIndex: 1 });
        gsap.set(nextBg, { zIndex: 2 });

        const tl = gsap.timeline({
          onComplete: () => {
            isAnimating = false;
            currentIndex = index;
            gsap.set(prevSlices, { yPercent: 100 });
            gsap.set(prevBg, { autoAlpha: 1 });
          },
        });

        tl.set(nextSlices, { yPercent: 100 }, 0)
          .to(
            nextSlices,
            { yPercent: 0, duration: 1.2, stagger: 0.1, ease: "power4.out" },
            0
          )
          .to(prevBg, { autoAlpha: 0, duration: 0.4 }, 0)
          .set(nextBg, { autoAlpha: 1 }, 0)
          .to(
            prevContent,
            {
              y: direction > 0 ? -50 : 50,
              autoAlpha: 0,
              duration: 0.4,
              ease: "power2.in",
              overwrite: true,
            },
            0
          )
          .fromTo(
            nextContent,
            { y: 50, autoAlpha: 0 },
            {
              y: 0,
              autoAlpha: 1,
              duration: 0.8,
              ease: "power3.out",
              overwrite: true,
            },
            0.6
          );
      }

      // Observer
      let intentObserver = Observer.create({
        target: wrapper,
        type: "wheel,touch,pointer",
        tolerance: 10,
        onUp: () =>
          currentIndex < totalSlides - 1
            ? gotoSlide(currentIndex + 1, 1)
            : exitSection(1),
        onDown: () =>
          currentIndex > 0 ? gotoSlide(currentIndex - 1, -1) : exitSection(-1),
        preventDefault: true,
      });

      function exitSection(dir: number) {
        intentObserver.disable();
        (wrapper as HTMLElement).style.touchAction = "auto";
        const st = ScrollTrigger.getById("services-pin");
        if (st) {
          gsap.to(window, {
            scrollTo: dir > 0 ? st.end + 100 : st.start - 100,
            duration: 0.5,
            overwrite: true,
          });
        }
      }

      // Pin Trigger
      ScrollTrigger.create({
        id: "services-pin",
        trigger: wrapper,
        start: "top top",
        end: "+=5000",
        pin: true,
        onEnter: () => {
          (wrapper as HTMLElement).style.touchAction = "none";
          intentObserver.enable();
        },
        onEnterBack: () => {
          (wrapper as HTMLElement).style.touchAction = "none";
          intentObserver.enable();
        },
        onLeave: () => {
          (wrapper as HTMLElement).style.touchAction = "auto";
          intentObserver.disable();
        },
        onLeaveBack: () => {
          (wrapper as HTMLElement).style.touchAction = "auto";
          intentObserver.disable();
        },
      });

      intentObserver.disable();
    }
  }
</script>
