---
import BubbleButton from "./ui/BubbleButton.astro";
import { CONTACT_MODAL } from "../config/content";
import { SITE } from "../config/site";

const services = CONTACT_MODAL.serviceOptions;
---

<div
  id="contact-modal"
  class="fixed inset-0 z-[9999] pointer-events-none opacity-0"
  aria-hidden="true"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    id="modal-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-md transition-opacity duration-300 ease-out opacity-0"
  >
  </div>

  <!-- Modal Container (Right Side, Slide from Top) -->
  <!-- "Position in the right side... come from top to bottom" -->
  <div
    class="absolute top-4 right-4 bottom-4 left-4 md:left-auto w-auto md:w-auto md:max-w-5xl pointer-events-none flex flex-col justify-start"
  >
    <div
      id="modal-content"
      class="bg-secondary w-full h-full max-h-full overflow-hidden rounded-[3rem] shadow-2xl relative translate-y-[-100%] opacity-0 pointer-events-auto border border-white/10 flex flex-col"
    >
      <!-- Close Button -->
      <button
        id="close-modal"
        class="absolute top-6 right-6 z-20 p-4 text-primary/50 hover:text-primary transition-colors bg-white/50 hover:bg-white rounded-full"
        aria-label={CONTACT_MODAL.closeAriaLabel}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line></svg
        >
      </button>

      <div class="p-8 md:p-12 h-full flex flex-col">
        <div class="shrink-0 mb-6 pr-16">
          <h2
            class="font-serif text-3xl md:text-5xl text-primary mb-2 leading-tight"
          >
            {CONTACT_MODAL.title}
          </h2>
          <p class="text-primary/60 text-lg">
            {CONTACT_MODAL.subtitle}
          </p>
        </div>

        <form
          class="flex-1 flex flex-col min-h-0"
          id="contact-form"
          data-success-message={CONTACT_MODAL.successMessage}
        >
          <input type="hidden" name="access_key" value={SITE.web3formsKey} />
          <input type="hidden" name="subject" value="Mesaj nou de pe site - JL Mobila" />
          <!-- Scrollable Content area -->
          <div
            class="flex-1 overflow-y-auto hide-scrollbar pr-2 -mr-2 space-y-8 pb-4"
          >
            <!-- Services -->
            <div class="space-y-3">
              <label
                class="block text-sm font-bold text-primary/80 uppercase tracking-widest text-xs"
              >
                {CONTACT_MODAL.servicesLabel}
              </label>
              <div class="flex flex-wrap gap-2">
                {
                  services.map((service) => (
                    <label class="cursor-pointer relative group">
                      <input
                        type="checkbox"
                        name="services"
                        value={service}
                        class="peer sr-only"
                      />
                      <span class="inline-block px-5 py-2.5 text-sm md:text-base rounded-full border-2 border-primary/10 text-primary/70 transition-all duration-300 peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary hover:border-primary/50 font-medium">
                        {service}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <!-- Inputs -->
            <div class="space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                  <input
                    type="text"
                    name="name"
                    placeholder={CONTACT_MODAL.namePlaceholder}
                    required
                    class="w-full bg-white border border-primary/10 rounded-2xl px-5 py-4 text-base text-primary placeholder:text-primary/30 focus:outline-none focus:border-accent transition-colors"
                  />
                </div>
                <div class="space-y-1">
                  <input
                    type="email"
                    name="email"
                    placeholder={CONTACT_MODAL.emailPlaceholder}
                    required
                    class="w-full bg-white border border-primary/10 rounded-2xl px-5 py-4 text-base text-primary placeholder:text-primary/30 focus:outline-none focus:border-accent transition-colors"
                  />
                </div>
              </div>

              <div class="space-y-1">
                <input
                  type="tel"
                  name="phone"
                  placeholder={CONTACT_MODAL.phonePlaceholder}
                  class="w-full bg-white border border-primary/10 rounded-2xl px-5 py-4 text-base text-primary placeholder:text-primary/30 focus:outline-none focus:border-accent transition-colors"
                />
              </div>

              <div class="space-y-1">
                <textarea
                  name="project"
                  rows="3"
                  placeholder={CONTACT_MODAL.projectPlaceholder}
                  class="w-full bg-white border border-primary/10 rounded-2xl px-5 py-4 text-base text-primary placeholder:text-primary/30 focus:outline-none focus:border-accent transition-colors resize-none"
                ></textarea>
              </div>
            </div>
          </div>

          <!-- Actions (Fixed Bottom) -->
          <div
            class="shrink-0 flex flex-col md:flex-row items-center gap-4 pt-4 mt-2 border-t border-primary/5"
          >
            <!-- Call Directly Button -->
            <a
              href={CONTACT_MODAL.callButtonHref}
              class="w-full md:w-1/2 relative inline-flex items-center justify-center text-center px-6 py-4 rounded-2xl font-bold uppercase tracking-wider overflow-hidden transition-colors duration-300 border border-primary text-primary hover:bg-primary hover:text-white group"
            >
              <span class="mr-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path></svg
                >
              </span>
              {CONTACT_MODAL.callButton}
            </a>

            <!-- Send Message Button -->
            <button
              id="submit-btn"
              class="w-full md:w-1/2 relative inline-flex items-center justify-center text-center px-6 py-4 rounded-2xl font-bold uppercase tracking-wider overflow-hidden transition-colors duration-300 bg-primary text-white hover:bg-accent hover:text-white"
            >
              {CONTACT_MODAL.sendButton}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
    import { gsap } from "gsap";
    import { trackEvent } from "../scripts/analytics";

    declare global {
      interface Window {
        toggleContactModal: (show?: boolean) => void;
      }
    }

  function initContactModal() {
    const modal = document.getElementById("contact-modal");
    if (!modal) return;

    const backdrop = document.getElementById("modal-backdrop");
    const content = document.getElementById("modal-content");
    const closeBtn = document.getElementById("close-modal");
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = document.getElementById("submit-btn");

    let isOpen = false;

    // Open/Close Functions
    // @ts-ignore
    window.toggleContactModal = (show?: boolean) => {
      const shouldOpen = show !== undefined ? show : !isOpen;

      if (shouldOpen) {
        openModal();
      } else {
        closeModal();
      }
    };

    function openModal() {
      if (isOpen) return;
      isOpen = true;

      // Make visible
      gsap.set(modal, { pointerEvents: "auto", autoAlpha: 1 });
      gsap.set(content, { y: "-100%" }); // Start position: hidden at TOP

      // Animate: Slide Down from Top
      const tl = gsap.timeline();
      tl.to(backdrop, { opacity: 1, duration: 0.4, ease: "power2.out" }).to(
        content,
        {
          opacity: 1,
          y: "0%", // Slide to reset position
          duration: 0.8,
          ease: "power3.out", // Smooth deceleration
        },
        "-=0.2",
      );

      document.body.style.overflow = "hidden"; // Lock scroll
    }

    function closeModal() {
      if (!isOpen) return;
      isOpen = false;

      const tl = gsap.timeline({
        onComplete: () => {
          gsap.set(modal, { pointerEvents: "none", autoAlpha: 0 });
        },
      });

      // Animate: Slide UP to Top
      tl.to(content, {
        opacity: 0,
        y: "-100%",
        duration: 0.5,
        ease: "power2.in",
      }).to(backdrop, { opacity: 0, duration: 0.3 }, "-=0.2");

      document.body.style.overflow = ""; // Unlock scroll
    }

    // Event Listeners
    window.addEventListener("toggle-contact-modal", () =>
      window.toggleContactModal(),
    );

    // Close on backdrop click
    backdrop?.addEventListener("click", closeModal);
    closeBtn?.addEventListener("click", closeModal);

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) closeModal();
    });

    // Intercept all /contact links
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("a");
      if (target && target.getAttribute("href") === "/contact") {
        e.preventDefault();
        window.toggleContactModal(true);
      }
    });

    // Handle Form Submit
    submitBtn?.addEventListener("click", async (e) => {
      e.preventDefault();
      
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      
      const originalText = submitBtn.innerHTML;

      // Track the form submission
      const formData = new FormData(form);
      const selectedServices = formData.getAll('services');
      trackEvent('form_submission', {
        services: selectedServices.join(', ')
      });

      try {
        submitBtn.setAttribute("disabled", "true");
        submitBtn.innerHTML = `
          <svg class="animate-spin h-5 w-5 mr-3 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Se trimite...
        `;

        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form)
        });

        const resultData = await response.json();

        if (!response.ok || !resultData.success) {
          throw new Error(resultData.message || "Eroare la trimitere.");
        }

        const successMessage =
          form?.dataset.successMessage ||
          "Mesaj trimis cu succes!";
        
        alert(successMessage);
        closeModal();
        form?.reset();
      } catch (err) {
        console.error(err);
        alert("A apărut o eroare la trimiterea mesajului. Te rugăm să încerci din nou sau să ne suni direct.");
      } finally {
        submitBtn.removeAttribute("disabled");
        submitBtn.innerHTML = originalText;
      }
    });
  }

  // Initialize
  document.addEventListener("astro:page-load", initContactModal);
  initContactModal();
</script>

<style>
  /* Hide scrollbar */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>
