---
import BubbleButton from "./ui/BubbleButton.astro";

const steps = [
  {
    step: "01",
    title: "Consultanță",
    desc: "Discutăm viziunea ta. Luăm măsurători precise și înțelegem fluxul spațiului.",
    // Meeting / Discussion
    img: "https://images.unsplash.com/photo-1556910103-1c02745a30bf?q=80&w=800",
  },
  {
    step: "02",
    title: "Proiectare 3D",
    desc: "Randări fotorealiste. Vezi exact cum va arăta mobilierul în casa ta.",
    // Blueprint / Sketch
    img: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=800",
  },
  {
    step: "03",
    title: "Producție",
    desc: "Folosim utilaje CNC de ultimă generație și finisaje manuale pentru detalii impecabile.",
    // Workshop / Craft
    img: "https://images.unsplash.com/photo-1622372738946-a28763b1f9b0?q=80&w=800",
  },
  {
    step: "04",
    title: "Montaj",
    desc: "Echipa noastră instalează totul, reglează feroneria și lasă totul curat.",
    // Installation / Living Room
    img: "https://images.unsplash.com/photo-1556228453-efd6c1ff04f6?q=80&w=800",
  },
];
---

<section
  class="bg-secondary py-24 overflow-hidden relative"
  id="process-section-v2"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10 hover-container">
    <!-- Title Section (Left Aligned) -->
    <div class="text-left mb-16 md:mb-24 max-w-2xl process-header">
      <h2 class="font-serif font-bold text-4xl md:text-6xl text-primary mb-6">
        Procesul Nostru
      </h2>
      <p class="text-gray-500 text-lg">
        De la schiță la realitate în patru pași simpli.
      </p>
    </div>

    <!-- Layout Container -->
    <div
      class="flex flex-col lg:grid lg:grid-cols-[1fr_minmax(500px,650px)_1fr] gap-8 items-start relative"
    >
      <!-- DESKTOP STRUCTURE -->

      <!-- Left Column Texts (Steps 1 & 3) -->
      <div
        class="hidden lg:flex flex-col justify-between h-[500px] pt-12 text-right pr-8 gap-32"
      >
        <!-- Step 1 Text -->
        <div class="process-text origin-right" data-step="0">
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[0].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[0].desc}</p>
        </div>
        <!-- Step 3 Text -->
        <div class="process-text origin-right" data-step="2">
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[2].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[2].desc}</p>
        </div>
      </div>

      <!-- Center Column: Images (Staggered 2x2 Grid) -->
      <div
        class="relative w-full max-w-2xl mx-auto h-[500px] grid grid-cols-2 gap-6 p-4 z-20 group/grid"
      >
        <!-- Column 1 -->
        <div class="flex flex-col gap-6">
          <!-- Image 0 -->
          <div
            class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                         transform hover:scale-105 hover:z-30 process-image"
            data-step="0"
          >
            <img
              src={steps[0].img}
              alt={steps[0].title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- Image 2 -->
          <div
            class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                         transform hover:scale-105 hover:z-30 process-image"
            data-step="2"
          >
            <img
              src={steps[2].img}
              alt={steps[2].title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Column 2 (Offset down) -->
        <div class="flex flex-col gap-6 pt-12">
          <!-- Image 1 -->
          <div
            class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                         transform hover:scale-105 hover:z-30 process-image"
            data-step="1"
          >
            <img
              src={steps[1].img}
              alt={steps[1].title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <!-- Image 3 -->
          <div
            class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                         transform hover:scale-105 hover:z-30 process-image"
            data-step="3"
          >
            <img
              src={steps[3].img}
              alt={steps[3].title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Right Column Texts (Steps 2 & 4) -->
      <div
        class="hidden lg:flex flex-col justify-between h-[500px] pt-24 pl-8 gap-32"
      >
        <!-- Step 2 Text -->
        <div class="process-text origin-left" data-step="1">
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[1].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[1].desc}</p>
        </div>
        <!-- Step 4 Text -->
        <div class="process-text origin-left" data-step="3">
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[3].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[3].desc}</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center relative z-20">
      <BubbleButton href="/contact" class="!px-10 !py-4"
        >Începe Proiectul</BubbleButton
      >
    </div>
  </div>
</section>

<style>
  /* 
     HOVER LOGIC 
     Target the whole .hover-container via :has()
  */

  /* 1. When ANY image is hovered: Blur everything in container */
  .hover-container:has(.process-image:hover) .process-image,
  .hover-container:has(.process-image:hover) .process-text,
  .hover-container:has(.process-image:hover) .process-header {
    opacity: 0.3;
    filter: blur(4px);
    transform: scale(0.98);
    transition: all 0.4s ease;
  }

  /* 2. Restore active image */
  .hover-container .process-image:hover {
    opacity: 1 !important;
    filter: none !important;
    transform: scale(1.15) !important;
    z-index: 50;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  /* 3. Restore active text */
  .hover-container:has(.process-image[data-step="0"]:hover)
    .process-text[data-step="0"],
  .hover-container:has(.process-image[data-step="1"]:hover)
    .process-text[data-step="1"],
  .hover-container:has(.process-image[data-step="2"]:hover)
    .process-text[data-step="2"],
  .hover-container:has(.process-image[data-step="3"]:hover)
    .process-text[data-step="3"] {
    opacity: 1 !important;
    filter: none !important;
    transform: scale(1.1) !important;
    color: var(--color-primary); /* Ensure text stays sharp/colored */
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Sequential Reveal Animation
  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector("#process-section-v2");
    if (!section) return;

    const elements = section.querySelectorAll(
      ".process-header, .process-image, .process-text"
    );

    // Use .from() so elements are visible if JS fails, but animated in properly
    gsap.from(elements, {
      scrollTrigger: {
        trigger: section,
        start: "top 70%", // Start revealing when section enters
      },
      y: 50,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15, // Sequential delay
      ease: "power3.out",
      clearProps: "all", // Clean up after animation so hover effects work cleanly
    });
  });
</script>
