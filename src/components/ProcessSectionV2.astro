---
import BubbleButton from "./ui/BubbleButton.astro";

const steps = [
  {
    step: "01",
    title: "Consultanță",
    desc: "Discutăm viziunea ta. Luăm măsurători precise și înțelegem fluxul spațiului.",
    // Meeting / Discussion
    img: "https://images.unsplash.com/photo-1600880292203-757bb62b4baf?q=80&w=800",
  },
  {
    step: "02",
    title: "Proiectare 3D",
    desc: "Randări fotorealiste. Vezi exact cum va arăta mobilierul în casa ta.",
    // Blueprint / Sketch
    img: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=800",
  },
  {
    step: "03",
    title: "Producție",
    desc: "Folosim utilaje CNC de ultimă generație și finisaje manuale pentru detalii impecabile.",
    // Workshop - Woodworking
    img: "https://images.unsplash.com/photo-1610557892470-55d9e80c0bce?q=80&w=800",
  },
  {
    step: "04",
    title: "Montaj",
    desc: "Echipa noastră instalează totul, reglează feroneria și lasă totul curat.",
    // Modern Interior / Installation
    img: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=800",
  },
];
---

<section
  class="bg-secondary py-24 overflow-hidden relative"
  id="process-section-v2"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10 hover-container">
    <!-- Title Section (Left Aligned) -->
    <div class="text-left mb-16 md:mb-24 max-w-2xl process-header">
      <h2 class="font-serif font-bold text-4xl md:text-6xl text-primary mb-6">
        Procesul Nostru
      </h2>
    </div>

    <!-- Layout Container -->
    <div
      class="flex flex-col lg:grid lg:grid-cols-[1fr_minmax(400px,550px)_1fr] gap-8 items-start relative h-full"
    >
      <!-- DESKTOP STRUCTURE -->

      <!-- Left Column Texts (Steps 1 & 3) -->
      <div
        class="hidden lg:flex flex-col justify-between h-[450px] pt-12 text-right pr-8 gap-32"
      >
        <!-- Step 1 Text -->
        <div
          class="process-text origin-right opacity-20 blur-sm will-change-transform"
          data-step="0"
        >
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[0].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[0].desc}</p>
        </div>
        <!-- Step 3 Text -->
        <div
          class="process-text origin-right opacity-20 blur-sm will-change-transform"
          data-step="2"
        >
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[2].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[2].desc}</p>
        </div>
      </div>

      <!-- Center Column: Images (Staggered 2x2 Grid) -->
      <!-- Reduced max-w and height for smaller images -->
      <div
        class="relative w-full max-w-lg mx-auto h-auto lg:h-[450px] grid grid-cols-1 md:grid-cols-2 gap-6 p-4 z-20 group/grid"
      >
        <!-- Column 1 -->
        <div class="flex flex-col gap-6">
          <!-- Image 0 -->
          <div class="flex flex-col">
            <div
              class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                           transform process-image opacity-20 blur-sm will-change-transform"
              data-step="0"
            >
              <img
                src={steps[0].img}
                alt={steps[0].title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <!-- Mobile Text (Sibling) -->
            <div
              class="lg:hidden mt-4 text-left opacity-20 blur-sm transform translate-y-4 will-change-transform"
              data-step-mobile="0"
            >
              <h3 class="font-serif text-xl text-primary font-bold mb-2">
                {steps[0].title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed">
                {steps[0].desc}
              </p>
            </div>
          </div>

          <!-- Image 2 -->
          <div class="flex flex-col">
            <div
              class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                           transform process-image opacity-20 blur-sm will-change-transform"
              data-step="2"
            >
              <img
                src={steps[2].img}
                alt={steps[2].title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <!-- Mobile Text (Sibling) -->
            <div
              class="lg:hidden mt-4 text-left opacity-20 blur-sm transform translate-y-4 will-change-transform"
              data-step-mobile="2"
            >
              <h3 class="font-serif text-xl text-primary font-bold mb-2">
                {steps[2].title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed">
                {steps[2].desc}
              </p>
            </div>
          </div>
        </div>

        <!-- Column 2 (Offset down) -->
        <div class="flex flex-col gap-6 lg:pt-12">
          <!-- Image 1 -->
          <div class="flex flex-col">
            <div
              class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                           transform process-image opacity-20 blur-sm will-change-transform"
              data-step="1"
            >
              <img
                src={steps[1].img}
                alt={steps[1].title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <!-- Mobile Text (Sibling) -->
            <div
              class="lg:hidden mt-4 text-left opacity-20 blur-sm transform translate-y-4 will-change-transform"
              data-step-mobile="1"
            >
              <h3 class="font-serif text-xl text-primary font-bold mb-2">
                {steps[1].title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed">
                {steps[1].desc}
              </p>
            </div>
          </div>

          <!-- Image 3 -->
          <div class="flex flex-col">
            <div
              class="w-full aspect-[4/3] relative overflow-hidden rounded-2xl transition-all duration-500 ease-out
                           transform process-image opacity-20 blur-sm will-change-transform"
              data-step="3"
            >
              <img
                src={steps[3].img}
                alt={steps[3].title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <!-- Mobile Text (Sibling) -->
            <div
              class="lg:hidden mt-4 text-left opacity-20 blur-sm transform translate-y-4 will-change-transform"
              data-step-mobile="3"
            >
              <h3 class="font-serif text-xl text-primary font-bold mb-2">
                {steps[3].title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed">
                {steps[3].desc}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column Texts (Steps 2 & 4) -->
      <div
        class="hidden lg:flex flex-col justify-between h-[450px] pt-24 pl-8 gap-32"
      >
        <!-- Step 2 Text -->
        <div
          class="process-text origin-left opacity-20 blur-sm will-change-transform"
          data-step="1"
        >
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[1].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[1].desc}</p>
        </div>
        <!-- Step 4 Text -->
        <div
          class="process-text origin-left opacity-20 blur-sm will-change-transform"
          data-step="3"
        >
          <h3 class="font-serif text-2xl text-primary font-bold mb-3">
            {steps[3].title}
          </h3>
          <p class="text-gray-500 text-sm leading-relaxed">{steps[3].desc}</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center relative z-20">
      <BubbleButton href="/contact" class="!px-10 !py-4"
        >Începe Proiectul</BubbleButton
      >
    </div>
  </div>
</section>

<style>
  /* 
     HOVER LOGIC 
  */

  /* BASE TRANSITION: Ensure smooth return when unhovering */
  .process-image,
  .process-text,
  .process-header {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /*
     Target the whole .hover-container via :has()
  */

  /* 1. When ANY image is hovered: Blur everything (images not hovered, texts, header) */
  .hover-container:has(.process-image:hover) .process-image:not(:hover),
  .hover-container:has(.process-image:hover) .process-text,
  .hover-container:has(.process-image:hover) .process-header {
    opacity: 0.3 !important;
    filter: blur(4px) !important;
    transform: scale(0.98) !important;
    transition: all 0.4s ease;
  }

  /* 2. Restore active image */
  .hover-container .process-image:hover {
    opacity: 1 !important;
    filter: none !important;
    transform: scale(1.15) !important;
    z-index: 50;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  /* 3. Restore active text (Desktop) */
  .hover-container:has(.process-image[data-step="0"]:hover)
    .process-text[data-step="0"],
  .hover-container:has(.process-image[data-step="1"]:hover)
    .process-text[data-step="1"],
  .hover-container:has(.process-image[data-step="2"]:hover)
    .process-text[data-step="2"],
  .hover-container:has(.process-image[data-step="3"]:hover)
    .process-text[data-step="3"] {
    opacity: 1 !important;
    filter: none !important;
    transform: scale(1.1) !important;
    color: var(--color-primary);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initProcessAnimation() {
    const section = document.querySelector("#process-section-v2");
    if (!section) return;

    // Kill previous triggers
    ScrollTrigger.getAll().forEach((t: any) => {
      if (
        t.vars.trigger === section ||
        t.vars.trigger === "#process-section-v2"
      ) {
        t.kill();
      }
    });

    ScrollTrigger.matchMedia({
      // --------------------------------------------------------------------------
      // DESKTOP: PINNING + SEQUENTIAL REVEAL
      // --------------------------------------------------------------------------
      "(min-width: 1024px)": function () {
        // Create Pinning Timeline
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: "top top",
            end: "+=1500", // Fast scroll
            pin: true,
            scrub: 1,
            anticipatePin: 1,
          },
        });

        // Animate Steps (Sequential)
        [0, 1, 2, 3].forEach((i) => {
          const elements = section.querySelectorAll(`[data-step="${i}"]`);
          if (elements.length > 0) {
            tl.to(
              elements,
              {
                opacity: 1,
                filter: "blur(0px)",
                duration: 1,
                ease: "power2.out",
              },
              i * 1.5
            );
          }
        });

        // CTA
        const cta = section.querySelector(".mt-16");
        if (cta) {
          tl.fromTo(
            cta,
            { opacity: 0, y: 30 },
            { opacity: 1, y: 0, duration: 1 },
            "+=0.5"
          );
        }
      },

      // --------------------------------------------------------------------------
      // MOBILE: NO PIN, SCRUB REVEAL (FAQ STYLE)
      // --------------------------------------------------------------------------
      "(max-width: 1023px)": function () {
        [0, 1, 2, 3].forEach((i) => {
          // Target both the image wrapper and the mobile text div
          const elements = section.querySelectorAll(
            `[data-step="${i}"], [data-step-mobile="${i}"]`
          );

          if (elements.length > 0) {
            // Use elements[0] (Image) as the trigger
            const triggerEl = elements[0];

            gsap.fromTo(
              elements,
              { opacity: 0.2, filter: "blur(4px)", y: 20 },
              {
                opacity: 1,
                filter: "blur(0px)",
                y: 0, // Reset translateY
                ease: "none", // Scrub usually works best with none or linear
                scrollTrigger: {
                  trigger: triggerEl,
                  start: "top bottom", // Start revealing when entering viewport
                  end: "top 60%", // Finish when somewhat up
                  scrub: 1,
                },
              }
            );
          }
        });

        // CTA simple fade in on scroll
        const cta = section.querySelector(".mt-16");
        if (cta) {
          gsap.fromTo(
            cta,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              scrollTrigger: {
                trigger: cta,
                start: "top 85%",
                end: "bottom 90%",
                scrub: 1,
              },
            }
          );
        }
      },
    });
  }

  // Run on Page Load (View Transitions)
  document.addEventListener("astro:page-load", initProcessAnimation);
  // Run Immediately (Initial Load fallback)
  initProcessAnimation();
</script>
