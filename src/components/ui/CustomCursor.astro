<div class="cursor hidden md:block">
  <div class="cursor__ball cursor__ball--big">
    <svg height="30" width="30">
      <circle cx="15" cy="15" r="12" stroke-width="0"></circle>
    </svg>
  </div>

  <div class="cursor__ball cursor__ball--small">
    <svg height="10" width="10">
      <circle cx="5" cy="5" r="4" stroke-width="0"></circle>
    </svg>
  </div>
</div>

<style>
  .cursor {
    pointer-events: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
  }

  .cursor__ball {
    position: fixed;
    top: 0;
    left: 0;
    mix-blend-mode: difference;
    z-index: 9999;
    pointer-events: none;
    opacity: 0; /* Hidden initially until moved */
  }

  .cursor__ball circle {
    fill: #f7f8fa;
  }
</style>

<script>
  import { gsap } from "gsap";

  function initCustomCursor() {
    // Only run on desktop/fine pointers
    const isDesktop = window.matchMedia(
      "(hover: hover) and (pointer: fine)"
    ).matches;
    if (!isDesktop) return;

    const bigBall = document.querySelector(".cursor__ball--big") as HTMLElement;
    const smallBall = document.querySelector(
      ".cursor__ball--small"
    ) as HTMLElement;

    if (!bigBall || !smallBall) return;

    // Show cursors (they start hidden to avoid jump)
    gsap.set([bigBall, smallBall], { opacity: 1 });

    // Move the cursor
    function onMouseMove(e: MouseEvent) {
      gsap.to(bigBall, {
        duration: 0.4,
        x: e.clientX - 15,
        y: e.clientY - 15,
        ease: "power2.out",
      });
      gsap.to(smallBall, {
        duration: 0.1,
        x: e.clientX - 5,
        y: e.clientY - 5,
        ease: "power2.out",
      });
    }

    // Hover effects
    function onMouseHover() {
      gsap.to(bigBall, {
        duration: 0.3,
        scale: 4,
        ease: "power2.out",
      });
    }

    function onMouseHoverOut() {
      gsap.to(bigBall, {
        duration: 0.3,
        scale: 1,
        ease: "power2.out",
      });
    }

    // Listeners
    document.body.addEventListener("mousemove", onMouseMove);

    // Attach hover listeners to interactive elements
    const hoverables = document.querySelectorAll(
      'a, button, .hoverable, [role="button"]'
    );

    hoverables.forEach((el) => {
      el.addEventListener("mouseenter", onMouseHover);
      el.addEventListener("mouseleave", onMouseHoverOut);
    });

    // Cleanup function for page transitions?
    // Astro page transitions might re-run scripts. removeEventListener is good practice.
    // However, for pure View Transitions, listeners on body persist?
    // "astro:page-load" runs on every nav.
    // We should probably deduplicate listeners logic if re-running.

    // For now in Astro View Transitions:
    // Simple way: re-query hoverables on new page load.
  }

  // Run on load
  document.addEventListener("astro:page-load", initCustomCursor);

  // Also handle global cursor: none via script to be safe?
  // Or CSS in Layout? CSS in Layout is cleaner.
</script>
