---

<div class="cursor hidden md:block">
  <div class="cursor__ball cursor__ball--big">
    <svg height="30" width="30">
      <circle cx="15" cy="15" r="12" stroke-width="0"></circle>
    </svg>
  </div>

  <div class="cursor__ball cursor__ball--small">
    <svg height="10" width="10">
      <circle cx="5" cy="5" r="4" stroke-width="0"></circle>
    </svg>
  </div>
</div>

<style>
  /* Wrapper only handles display logic via Tailwind classes */

  .cursor__ball {
    position: fixed;
    top: 0;
    left: 0;
    mix-blend-mode: difference;
    z-index: 9999;
    pointer-events: none;
    opacity: 0; /* Hidden initially until moved */
  }

  .cursor__ball circle {
    fill: #f7f8fa;
  }
</style>

<script>
  import { gsap } from "gsap";

  function initCustomCursor() {
    // Only run on desktop/fine pointers
    const isDesktop = window.matchMedia(
      "(hover: hover) and (pointer: fine)"
    ).matches;
    if (!isDesktop) return;

    const bigBall = document.querySelector(".cursor__ball--big") as HTMLElement;
    const smallBall = document.querySelector(
      ".cursor__ball--small"
    ) as HTMLElement;

    if (!bigBall || !smallBall) return;

    // Show cursors (they start hidden to avoid jump)
    gsap.set([bigBall, smallBall], { opacity: 1 });

    // Move the cursor
    function onMouseMove(e: MouseEvent) {
      gsap.to(bigBall, {
        duration: 0.4,
        x: e.clientX - 15,
        y: e.clientY - 15,
        ease: "power2.out",
      });
      gsap.to(smallBall, {
        duration: 0.1,
        x: e.clientX - 5,
        y: e.clientY - 5,
        ease: "power2.out",
      });
    }

    // Hover effects
    function setScale(scale: number) {
      gsap.to(bigBall, {
        duration: 0.3,
        scale: scale,
        ease: "power2.out",
      });
    }

    const onButtonHover = (e: Event) => {
      const target = e.currentTarget as HTMLElement;
      const customScale = target.dataset.cursorScale;
      setScale(customScale ? parseFloat(customScale) : 2.5);
    };

    const onTitleHover = (e: Event) => {
      const target = e.currentTarget as HTMLElement;
      const customScale = target.dataset.cursorScale;
      setScale(customScale ? parseFloat(customScale) : 5);
    };

    const onHoverOut = () => setScale(1);

    // Listeners
    document.body.removeEventListener("mousemove", onMouseMove);
    document.body.addEventListener("mousemove", onMouseMove);

    // Select Elements
    const buttons = document.querySelectorAll(
      'a, button, .hoverable, [role="button"]'
    );
    const titles = document.querySelectorAll("h1, h2, h3, h4, .title-hover");

    // Attach Button Listeners
    buttons.forEach((el) => {
      // Remove old listeners (if any) to prevent duplication is hard without ref,
      // but since we are re-initializing, duplicate listeners are a risk if we don't clean up correctly.
      // However, we can't clean up anonymous closures or diff refs.
      // Ideally, we should store controllers.
      // For now, trusting simple addEventListener.
      el.addEventListener("mouseenter", onButtonHover);
      el.addEventListener("mouseleave", onHoverOut);
    });

    // Attach Title Listeners
    titles.forEach((el) => {
      el.addEventListener("mouseenter", onTitleHover);
      el.addEventListener("mouseleave", onHoverOut);
    });
  }

  // Run on standard load
  document.addEventListener("DOMContentLoaded", initCustomCursor);

  // Run on Astro page load (for view transitions compatibility)
  document.addEventListener("astro:page-load", initCustomCursor);
</script>
