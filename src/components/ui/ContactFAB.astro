---

---

<a
  href="/contact"
  class="fixed bottom-[calc(2rem+env(safe-area-inset-bottom))] left-4 md:left-8 z-40 group cursor-pointer block md:hidden"
  id="contact-fab"
  aria-label="Contact Us"
>
  <!-- Main Container -->
  <div
    class="relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24"
  >
    <!-- Rotating Text Ring -->
    <div
      class="absolute inset-0 animate-spin-slow group-hover:pause-animation transition-transform duration-500"
    >
      <svg
        viewBox="0 0 100 100"
        width="100%"
        height="100%"
        class="w-full h-full fill-current text-primary"
      >
        <defs>
          <path
            id="circlePath"
            d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"></path>
        </defs>
        <text
          font-size="11.5"
          font-weight="bold"
          letter-spacing="1.2"
          class="fab-text transition-colors duration-500"
        >
          <textPath href="#circlePath" startOffset="0%">
            • CONTACT • CONTACT • CONTACT
          </textPath>
        </text>
      </svg>
    </div>

    <!-- Center Icon Circle -->
    <div
      class="fab-bg absolute inset-0 m-auto w-10 h-10 md:w-12 md:h-12 bg-primary rounded-full flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform transition-colors duration-300"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5 md:w-6 md:h-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
        ></path>
      </svg>
    </div>
  </div>
</a>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }
  .group-hover\:pause-animation:hover {
    animation-play-state: paused;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initFAB() {
    const fab = document.getElementById("contact-fab");
    const footer = document.querySelector("footer");

    if (!fab || !footer) return;

    // Hide FAB when overlapping footer to avoid clutter
    ScrollTrigger.create({
      trigger: footer,
      start: "top bottom-=100", // Start hiding a bit before footer enters
      end: "bottom top",
      onEnter: () => gsap.to(fab, { autoAlpha: 0, scale: 0.8, duration: 0.3 }),
      onLeaveBack: () =>
        gsap.to(fab, { autoAlpha: 1, scale: 1, duration: 0.3 }),
    });
  }

  // Run on load and transitions
  document.addEventListener("astro:page-load", initFAB);
  initFAB();
</script>
