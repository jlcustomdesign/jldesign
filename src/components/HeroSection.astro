---
import BubbleButton from "./ui/BubbleButton.astro";

const heroImage = "/Images/Imagine hero section.png";
---

<section
  class="relative min-h-screen flex items-center bg-secondary overflow-hidden"
  id="hero-section"
  data-theme="dark"
>
  <!-- Background SVG Container -->
  <div
    class="absolute inset-0 z-0 overflow-hidden flex justify-center items-center pointer-events-none"
  >
    <svg
      id="mySVG"
      xmlns="http://www.w3.org/2000/svg"
      width="100%"
      height="100%"
      preserveAspectRatio="xMidYMid meet"
      class="w-[98%] h-full"
    >
      <defs>
        <clipPath id="heroClip">
          <path id="heroPath" fill="white"></path>
        </clipPath>
      </defs>
      <!-- Image masked by the path -->
      <image
        href={heroImage}
        width="100%"
        height="100%"
        preserveAspectRatio="xMidYMid slice"
        clip-path="url(#heroClip)"
      />
      <!-- Overlay for text contrast -->
      <rect
        width="100%"
        height="100%"
        fill="black"
        opacity="0.3"
        clip-path="url(#heroClip)"></rect>
    </svg>
  </div>

  <!-- Content Container -->
  <div
    class="container mx-auto px-4 md:px-8 relative z-10 grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
  >
    <!-- Left: Text Content -->
    <div class="order-2 md:order-1">
      <h1
        class="font-serif font-extrabold text-5xl md:text-6xl lg:text-7xl leading-tight text-white mb-6 overflow-hidden"
      >
        <span class="hero-text-line block">Spațiul tău,</span>
        <span class="hero-text-line block">viziunea noastră</span>
      </h1>

      <p
        class="hero-subtitle text-lg md:text-xl text-white max-w-md mb-10 opacity-0 transform translate-y-4"
      >
        Mobilă creată să dăinuie. Design minimalist, finisaje premium și o
        atenție obsesivă la detalii.
      </p>
    </div>

    <!-- Right: Visual "Window" -->
    <div
      class="order-1 md:order-2 relative aspect-[1.3/1] w-full max-w-xl mx-auto md:translate-x-18"
    >
      <div
        class="hero-image-mask absolute inset-0 w-full h-full overflow-hidden rounded-2xl origin-center scale-90 opacity-0"
      >
        <div
          class="w-full h-full bg-white hero-image-inner shadow-2xl flex items-stretch justify-between p-8 md:p-12"
        >
          <!-- Left: Content Container -->
          <div class="w-[52%] flex flex-col justify-between items-center py-2">
            <!-- Text Content (Centered Vertically) -->
            <div
              class="flex-1 flex flex-col justify-center gap-4 md:gap-6 text-center"
            >
              <h3
                class="hero-card-title font-serif text-2xl md:text-4xl text-primary leading-tight opacity-0"
              >
                Calitate Fără <br />
                <span class="text-accent">Compromis</span>
              </h3>
              <p
                class="hero-card-subtext text-gray-600 text-sm md:text-lg leading-relaxed max-w-[90%] mx-auto opacity-0"
              >
                Mobilier realizat cu pasiune și precizie pentru a crea piese
                care rezistă testului timpului.
              </p>
            </div>

            <!-- Button centered in the left space and aligned with image bottom -->
            <div class="flex justify-center w-full">
              <BubbleButton
                id="hero-about-btn"
                href="#about-section"
                variant="dark"
                class="hero-card-btn !px-10 !py-4 text-sm md:text-base whitespace-nowrap opacity-0"
              >
                Află mai multe
              </BubbleButton>
            </div>
          </div>

          <!-- Right: 3:4 Vertical Image -->
          <div
            class="hero-card-img w-[44%] aspect-[3/4.5] overflow-hidden rounded-lg shadow-inner self-end opacity-0"
          >
            <img
              src="/Images/Proiecte-JL Custom Design-07.jpg"
              alt="Premium Furniture Detail"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <!-- Organic Shape Overlay / Vibe -->
        <div class="absolute inset-0 bg-black/5 pointer-events-none"></div>
      </div>
    </div>
  </div>

  <!-- CTA Buttons (Repositioned to downside cutout) -->
  <div
    class="absolute bottom-12 left-0 w-full flex justify-center z-20 md:-translate-x-48"
  >
    <div
      class="hero-cta flex flex-col sm:flex-row gap-4 opacity-0 transform translate-y-4"
    >
      <BubbleButton
        href="/contact"
        variant="primary"
        class="w-full md:w-auto text-center"
      >
        Cere o ofertă
      </BubbleButton>
      <BubbleButton
        href="/portfolio"
        variant="outline"
        class="w-full md:w-auto text-center !border-white !text-white hover:!border-[#d4af37] !bg-white/10 backdrop-blur-md hover:!bg-white/20"
      >
        Vezi proiecte
      </BubbleButton>
    </div>
  </div>

  <!-- Decorative Elements -->
  <!-- Scroll indicator removed -->
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";

  gsap.registerPlugin(ScrollTrigger, MorphSVGPlugin);

  const widthTarget = 1110;
  const desktopResolution = { width: 1890, height: 916 };
  const mobileResolution = { width: 1020, height: 882 };

  document.addEventListener("astro:page-load", () => {
    initHeroAnim();
  });

  // Also run on initial load
  initHeroAnim();

  function initHeroAnim() {
    const section = document.querySelector("#hero-section");
    const svg = document.querySelector("#mySVG");
    if (!section || !svg) return;

    // Custom split specifically for this known title structure
    const splitHeroCardTitle = () => {
      const titleEl = section.querySelector(".hero-card-title");
      if (titleEl) {
        // We know the structure. simpler to just animate children if they were spans.
        const html = `
            <span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">Calitate</span></span>
            <span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">Fără</span></span>
            <br />
            <span class="text-accent inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">Compromis</span></span>
           `;
        titleEl.innerHTML = html;
      }
    };

    splitHeroCardTitle();

    // Ensure parent is visible immediately after split, children are hidden
    const titleEl = section.querySelector(".hero-card-title");
    if (titleEl) gsap.set(titleEl, { opacity: 1 });

    // Use Context for easy cleanup
    const ctx = gsap.context(() => {
      const masterTl = gsap.timeline({ defaults: { ease: "power3.out" } });

      // --- 1. SVG & Background Setup ---
      try {
        const width = window.innerWidth;
        const height = window.innerHeight;

        svg.setAttribute("viewBox", `0 0 ${width} ${height}`);

        // Select Path (now inside clipPath)
        let path = svg.querySelector("#heroPath");
        if (!path) {
          // Fallback if structure damaged
          path = document.createElementNS("http://www.w3.org/2000/svg", "path");
          path.id = "heroPath";
          svg.appendChild(path);
        }

        // Initial State (Rectangle)
        path.setAttribute("d", rectangle(width, height));

        // SVG Animation (Step 1)
        if (gsap.plugins.morphSVG) {
          masterTl.add(runSvgAnim(path, width, height));
        } else {
          console.warn("GSAP MorphSVGPlugin not loaded. Skipping morph.");
        }

        // Resize Listener
        const onResize = () => {
          const w = window.innerWidth;
          const h = window.innerHeight;
          svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
          path.setAttribute("d", cross(w, h));
        };
        window.addEventListener("resize", onResize);
      } catch (e) {
        console.warn("Hero Background Animation Error:", e);
      }

      // --- 2. Text Content (Step 2) ---
      // Start this block '-=0.5' seconds before SVG finishes
      masterTl.from(
        ".hero-text-line",
        {
          y: 100,
          opacity: 0,
          duration: 1,
          stagger: 0.2,
          ease: "power3.out",
        },
        "-=0.5"
      );

      // --- 3. Synchronized Content (Navbar, Subtitle, Buttons, Image) ---
      // All loading AT THE SAME TIME as the text start ("<")

      // Navbar
      const navbar = document.querySelector("#navbar-container");
      if (navbar) {
        // Instant opacity, elastic scale for "Pop" effect
        masterTl.to(navbar, { opacity: 1, duration: 0.05 }, "<");
        masterTl.to(
          navbar,
          {
            scale: 1,
            duration: 1.8,
            ease: "back.out(1.2)",
          },
          "<"
        );
      }

      // Subtitle
      masterTl.to(".hero-subtitle", { y: 0, opacity: 1, duration: 0.8 }, "<");

      // Buttons
      masterTl.to(".hero-cta", { y: 0, opacity: 1, duration: 0.8 }, "<");

      // Smooth scroll for About button in visual card
      const aboutBtn = section.querySelector("#hero-about-btn");
      if (aboutBtn) {
        aboutBtn.addEventListener("click", (e) => {
          e.preventDefault();
          // @ts-ignore
          if (window.smoother) {
            // @ts-ignore
            window.smoother.scrollTo("#about-section", true, "top top");
          } else {
            const target = document.querySelector("#about-section");
            target?.scrollIntoView({ behavior: "smooth" });
          }
        });
      }

      // --- 4. Hero Card & Inner Elements ---
      // Card Mask Reveal
      masterTl
        .to(
          ".hero-image-mask",
          {
            scale: 1,
            opacity: 1,
            duration: 1.8,
            ease: "expo.out",
          },
          "<"
        )
        .from(
          ".hero-image-inner",
          {
            scale: 1.4,
            duration: 2,
            ease: "power2.out",
          },
          "<"
        );

      // DISTINCT ANIMATIONS for Inner Card Elements
      // Trigger these slightly before the card finishes revealing for a nice overlap

      // a) Title Stagger (Word by Word)
      masterTl.to(
        ".hero-card-title span span",
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "expo.out",
        },
        "-=1.2"
      );

      // b) Subtext Slide Up
      masterTl.fromTo(
        ".hero-card-subtext",
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: "power2.out" },
        "-=0.9"
      );

      // c) Button Elastic Pop
      masterTl.fromTo(
        ".hero-card-btn",
        { scale: 0.5, opacity: 0 },
        { scale: 1, opacity: 1, duration: 0.8, ease: "back.out(1.7)" },
        "-=0.8"
      );

      // d) Right Image Reveal (Slide + Fade)
      masterTl.fromTo(
        ".hero-card-img",
        { x: 30, opacity: 0 },
        { x: 0, opacity: 1, duration: 1, ease: "power2.out" },
        "-=1.0"
      );
    }, section);
  }

  function runSvgAnim(path: Element, width: number, height: number) {
    const tl = gsap.timeline();

    tl.from("#mySVG", {
      scale: 1.5,
      duration: 1,
      ease: "power4.out",
    }).to(path, {
      scale: 1,
      duration: width > widthTarget ? 1.8 : 0.6,
      morphSVG: cross(width, height),
      ease: width > widthTarget ? "elastic.out(1, 0.9)" : "back.out(1.7)",
    });

    return tl;
  }

  function rectangle(w: number, h: number) {
    const displayCond = w > widthTarget;
    let w1 = mobileResolution.width;
    let h1 = mobileResolution.height;

    if (displayCond) {
      w1 = desktopResolution.width;
      h1 = desktopResolution.height;
    }

    const rw = (val: number) => (val / w1) * w;
    const rh = (val: number) => (val / h1) * h;

    return displayCond
      ? `M${rw(12)} ${rh(1)} H${rw(12)} C${rw(4)} ${rh(1)} ${rw(1)} ${rh(4)} ${rw(1)} ${rh(12)} V${rh(905)} C${rw(1)} ${rh(913)} ${rw(4)} ${h} ${rw(12)} ${h} H${rw(1879)} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} V${h} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} H${rw(1879)} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} V${h} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} H${rw(1879)} C${rw(1887)} ${h} ${w} ${rh(913)} ${w} ${rh(905)} V${rh(12)} C${w} ${rh(12)} ${w} ${rh(12)} ${w} ${rh(12)} H${w} C${w} ${rh(4)} ${rw(1887)} ${rh(1)} ${rw(1879)} ${rh(1)} V${rh(1)} C${rw(1879)} ${rh(1)} ${rw(1879)} ${rh(1)} ${rw(1879)} ${rh(1)} H${rw(12)} V${rh(1)} C${rw(4)} ${rh(1)} ${rw(1)} ${rh(4)} ${rw(1)} ${rh(12)} Z`
      : `M${rw(1000)} ${rh(1)} H${rw(21)} C${rw(9.9543)} ${rh(1)} ${rw(1)} ${rh(9.9543)} ${rw(1)} ${rh(21)} V${rh(860)} C${rw(1)} ${rh(860)} ${rw(1)} ${rh(860)} ${rw(1)} ${rh(860)} H${rw(1)} C${rw(1)} ${rh(875)} ${rw(6)} ${rh(882)} ${rw(21)} ${rh(882)} V${rh(882)} C${rw(21)} ${rh(882)} ${rw(21)} ${rh(882)} ${rw(21)} ${rh(882)} H${rw(997)} C${rw(997)} ${rh(882)} ${rw(997)} ${rh(882)} ${rw(997)} ${rh(882)} V${rh(882)} C${rw(1016)} ${rh(882)} ${w} ${rh(877)} ${w} ${rh(860)} H${w} C${w} ${rh(860)} ${w} ${rh(860)} ${w} ${rh(860)} V${rh(21)} C${w} ${rh(9.9543)} ${rw(1011.05)} ${rh(1)} ${rw(1000)} ${rh(1)} Z`;
  }

  function cross(w: number, h: number) {
    const displayCond = w > widthTarget;
    let w1 = mobileResolution.width;
    let h1 = mobileResolution.height;

    if (displayCond) {
      w1 = desktopResolution.width;
      h1 = desktopResolution.height;
    }

    const rw = (val: number) => (val / w1) * w;
    const rh = (val: number) => (val / h1) * h;

    // Updated coordinates with +82 shift for left corner and extended right shelf
    return displayCond
      ? `M${rw(505)} ${rh(125)} H${rw(19)} C${rw(9)} ${rh(125)} ${rw(1)} ${rh(133)} ${rw(1)} ${rh(143)} V${rh(774)} C${rw(1)} ${rh(783)} ${rw(9)} ${rh(792)} ${rw(19)} ${rh(792)} H${rw(280)} C${rw(290)} ${rh(792)} ${rw(298)} ${rh(800)} ${rw(298)} ${rh(810)} V${rh(898)} C${rw(298)} ${rh(907)} ${rw(306)} ${h} ${rw(316)} ${h} H${rw(1132)} C${rw(1142)} ${h} ${rw(1150)} ${rh(907)} ${rw(1150)} ${rh(898)} V${rh(809)} C${rw(1150)} ${rh(799)} ${rw(1158)} ${rh(791)} ${rw(1168)} ${rh(791)} H${rw(1872)} C${rw(1881)} ${rh(791)} ${w} ${rh(783)} ${w} ${rh(773)} V${rh(144)} C${w} ${rh(134)} ${rw(1881)} ${rh(126)} ${rw(1872)} ${rh(126)} H${rw(1385)} C${rw(1375)} ${rh(126)} ${rw(1367)} ${rh(117)} ${rw(1367)} ${rh(108)} V${rh(19)} C${rw(1367)} ${rh(9)} ${rw(1359)} ${rh(1)} ${rw(1349)} ${rh(1)} H${rw(541)} C${rw(531)} ${rh(1)} ${rw(523)} ${rh(9)} ${rw(523)} ${rh(19)} V${rh(107)} C${rw(523)} ${rh(117)} ${rw(515)} ${rh(125)} ${rw(505)} ${rh(125)} Z`
      : `M${rw(1000)} ${rh(1)} H${rw(21)} C${rw(9.9543)} ${rh(1)} ${rw(1)} ${rh(9.95432)} ${rw(1)} ${rh(21)} V${rh(737)} C${rw(1)} ${rh(748.046)} ${rw(9.9543)} ${rh(757)} ${rw(21)} ${rh(757)} H${rw(86)} C${rw(97.0457)} ${rh(757)} ${rw(106)} ${rh(765.954)} ${rw(106)} ${rh(777)} V${rh(861.869)} C${rw(106)} ${rh(872.915)} ${rw(114.954)} ${rh(881.869)} ${rw(126)} ${rh(881.869)} H${rw(875)} C${rw(886.046)} ${rh(881.869)} ${rw(895)} ${rh(872.915)} ${rw(895)} ${rh(861.869)} V${rh(777)} C${rw(895)} ${rh(765.954)} ${rw(903.954)} ${rh(757)} ${rw(915)} ${rh(757)} H${rw(1000)} C${rw(1011.05)} ${rh(757)} ${w} ${rh(748.046)} ${w} ${rh(737)} V${rh(21)} C${w} ${rh(9.9543)} ${rw(1011.05)} ${rh(1)} ${rw(1000)} ${rh(1)} Z`;
  }
</script>
