---
import BubbleButton from "./ui/BubbleButton.astro";
import { HERO } from "../config/content";

const heroImage = "/Poze JL Custom Design - Site/LP/Hero/Desktop.webp";
---

<section
  class="relative h-[100svh] flex items-center bg-secondary overflow-hidden"
  id="hero-section"
  data-theme="dark"
  style="z-index: 1;"
>
  <!-- Hero Content Wrapper (for scale/blur animation) -->
  <div
    id="hero-content-wrapper"
    class="absolute inset-0 flex items-center"
    style="transform-origin: center center;"
  >
    <!-- Background SVG Container -->
    <div
      class="absolute inset-0 z-0 overflow-hidden flex justify-center items-center pointer-events-none"
    >
      <svg
        id="mySVG"
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="100%"
        preserveAspectRatio="none"
        class="w-full h-full opacity-0"
        style="transform-origin: center center;"
      >
        <defs>
          <clipPath id="heroClip">
            <path id="heroPath" fill="white"></path>
          </clipPath>
        </defs>
        <!-- Image masked by the path -->
        <image
          href={heroImage}
          width="100%"
          height="100%"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#heroClip)"
          image-rendering="optimizeQuality"
        />
        <!-- Overlay for text contrast -->
        <rect
          width="100%"
          height="100%"
          fill="black"
          opacity="0.1"
          clip-path="url(#heroClip)"></rect>
      </svg>
    </div>

    <!-- Content Container -->
    <div
      class="container mx-auto px-4 md:px-8 relative z-10 flex flex-col justify-center h-full pointer-events-none"
    >
      <!-- Left: Text Content -->
      <div class="relative group pointer-events-auto" id="hero-title-container">
        <!-- Main Title -->
        <h1
          id="hero-title"
          class="font-serif font-normal text-4xl sm:text-5xl md:text-7xl lg:text-8xl xl:text-8xl 2xl:text-9xl leading-tight text-white mb-6 relative z-10 title-hover w-fit pointer-events-none opacity-0 invisible hero-text-element"
          data-cursor-scale="5.0"
        >
          <Fragment set:html={HERO.title} />
        </h1>

        <h2
          class="hero-subtitle font-sans font-normal text-lg md:text-xl text-white/80 max-w-2xl lg:max-w-4xl mb-10 opacity-0 invisible hero-text-element"
        >
          {HERO.subtitle}
        </h2>
      </div>
    </div>

    <!-- CTA Buttons (Centered low on mobile, Higher on tablet, Cutout on large desktop) -->
    <div
      class="absolute bottom-[40px] left-1/2 -translate-x-1/2 z-20 w-fit md:bottom-[144px] md:translate-y-1/2 xl:bottom-[72px] xl:left-[38.3%] xl:translate-y-1/2"
    >
      <div class="hero-cta flex flex-col xl:flex-row gap-4">
        <BubbleButton
          href="/contact"
          variant="hero-dark"
          class="hero-btn w-full xl:w-auto text-center invisible opacity-0 translate-y-4"
        >
          {HERO.ctaPrimary}
        </BubbleButton>
        <BubbleButton
          href="/portfolio"
          id="glass-btn"
          variant="hero-glass"
          class="hero-btn w-full xl:w-auto text-center invisible opacity-0 translate-y-4"
        >
          {HERO.ctaSecondary}
        </BubbleButton>
      </div>
    </div>

    <!-- Quality Badge / Corner Text (Bottom Right Void) -->
    <!-- REMOVED as per request -->

    <!-- Top Left Copy (Cutout) -->
    <div
      class="absolute top-[8%] left-[8%] -translate-x-1/2 -translate-y-1/2 z-20 hidden xl:block whitespace-nowrap"
    >
      <span
        class="text-[clamp(1rem,1.5vw,2.25rem)] font-serif font-black tracking-widest uppercase text-[#1A1A1A] opacity-0 invisible hero-top-left"
      >
        {HERO.topLeftBrand}
      </span>
    </div>

    <!-- Top Right Button (Cutout) -->
    <div
      class="absolute top-[8%] right-[8%] translate-x-1/2 -translate-y-1/2 z-20 hidden xl:block"
    >
      <a
        href="/contact"
        class="group flex items-center gap-2 xl:gap-3 opacity-0 invisible hero-top-right"
      >
        <div
          class="bg-transparent text-black border border-black px-4 py-2 xl:px-6 xl:py-3 rounded-full text-[10px] xl:text-xs font-extrabold uppercase tracking-wider transition-all duration-300 group-hover:bg-black group-hover:text-white group-hover:scale-105 shadow-none hover:shadow-xl"
        >
          {HERO.topRightCta}
        </div>
        <div
          class="w-10 h-10 xl:w-12 xl:h-12 bg-transparent text-black border border-black rounded-full flex items-center justify-center transition-all duration-300 group-hover:bg-black group-hover:text-white shadow-none hover:shadow-xl"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 14 14"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          >
            <path
              d="M1 13L13 1M13 1H4M13 1V10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>

    <!-- Decorative Elements -->
    <!-- Scroll indicator removed -->
  </div><!-- End hero-content-wrapper -->
</section>

<script>
  import { initHeroAnimations } from "../scripts/hero-animation";
  import { initTextAnimations } from "../utils/RevealAnimationHandler";

  // Initialize animations
  initHeroAnimations();

  // Initialize text reveal (Scoped to this section to prevent affecting other components)
  const section = document.querySelector("#hero-section");
  if (section) initTextAnimations(section as HTMLElement);
</script>
