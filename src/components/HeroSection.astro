---
import BubbleButton from "./ui/BubbleButton.astro";

const heroImage = "/Images/hero-image.jpg";
---

<section
  class="relative min-h-screen flex items-center bg-secondary overflow-hidden transition-[height] duration-300"
  id="hero-section"
  data-theme="dark"
  style="z-index: 1;"
>
  <!-- Hero Content Wrapper (for scale/blur animation) -->
  <div
    id="hero-content-wrapper"
    class="absolute inset-0 flex items-center"
    style="transform-origin: center center;"
  >
    <!-- Background SVG Container -->
    <div
      class="absolute inset-0 z-0 overflow-hidden flex justify-center items-center pointer-events-none"
    >
      <svg
        id="mySVG"
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="100%"
        preserveAspectRatio="xMidYMid meet"
        class="w-[98%] h-full opacity-0"
        style="transform-origin: center center; max-height: 100dvh;"
      >
        <defs>
          <clipPath id="heroClip">
            <path id="heroPath" fill="white"></path>
          </clipPath>
        </defs>
        <!-- Image masked by the path -->
        <image
          href={heroImage}
          width="100%"
          height="100%"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#heroClip)"
          image-rendering="optimizeQuality"
        />
        <!-- Overlay for text contrast -->
        <rect
          width="100%"
          height="100%"
          fill="black"
          opacity="0.3"
          clip-path="url(#heroClip)"></rect>
      </svg>
    </div>

    <!-- Content Container -->
    <div
      class="container mx-auto px-4 md:px-8 relative z-10 grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
    >
      <!-- Left: Text Content -->
      <div class="order-2 md:order-1">
        <h1
          class="font-serif font-extrabold text-5xl md:text-6xl lg:text-7xl leading-tight text-white mb-6 overflow-hidden"
        >
          <span class="hero-text-line block">Spațiul tău,</span>
          <span class="hero-text-line block">viziunea noastră</span>
        </h1>

        <p
          class="hero-subtitle text-lg md:text-xl text-white max-w-md mb-10 opacity-0 transform translate-y-4"
        >
          Mobilă creată să dăinuie. Design minimalist, finisaje premium și o
          atenție obsesivă la detalii.
        </p>
      </div>

      <!-- Right: Visual "Window" -->
      <div
        class="hidden md:block order-1 md:order-2 relative aspect-[1.3/1] w-full max-w-xl mx-auto md:translate-x-18"
      >
        <div
          class="hero-image-mask absolute inset-0 w-full h-full overflow-hidden rounded-2xl origin-center scale-90 opacity-0"
        >
          <div
            class="w-full h-full bg-white hero-image-inner shadow-2xl flex items-stretch justify-between p-8 md:p-12"
          >
            <!-- Left: Content Container -->
            <div
              class="w-[52%] flex flex-col justify-between items-center py-2"
            >
              <!-- Text Content (Centered Vertically) -->
              <div
                class="flex-1 flex flex-col justify-center gap-4 md:gap-6 text-center"
              >
                <h3
                  class="hero-card-title font-serif text-2xl md:text-4xl text-primary leading-tight opacity-0"
                >
                  Calitate Fără <br />
                  <span class="text-accent">Compromis</span>
                </h3>
                <p
                  class="hero-card-subtext text-gray-600 text-sm md:text-lg leading-relaxed max-w-[90%] mx-auto opacity-0"
                >
                  Mobilier realizat cu pasiune și precizie pentru a crea piese
                  care rezistă testului timpului.
                </p>
              </div>

              <!-- Button centered in the left space and aligned with image bottom -->
              <div class="flex justify-center w-full">
                <BubbleButton
                  id="hero-about-btn"
                  href="#about-section"
                  variant="dark"
                  class="hero-card-btn !px-10 !py-4 text-sm md:text-base whitespace-nowrap opacity-0"
                >
                  Află mai multe
                </BubbleButton>
              </div>
            </div>

            <!-- Right: 3:4 Vertical Image -->
            <div
              class="hero-card-img w-[44%] aspect-[3/4.5] overflow-hidden rounded-lg shadow-inner self-end opacity-0"
            >
              <img
                src="/Images/Proiecte-JL Custom Design-07.jpg"
                alt="Premium Furniture Detail"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
          <!-- Organic Shape Overlay / Vibe -->
          <div class="absolute inset-0 bg-black/5 pointer-events-none"></div>
        </div>
      </div>
    </div>

    <!-- CTA Buttons (Repositioned to downside cutout) -->
    <div
      class="absolute bottom-12 left-0 w-full flex justify-center z-20 md:-translate-x-48"
    >
      <div
        class="hero-cta flex flex-col sm:flex-row gap-4 opacity-0 transform translate-y-4"
      >
        <BubbleButton
          href="/contact"
          variant="primary"
          class="w-full md:w-auto text-center"
        >
          Cere o ofertă
        </BubbleButton>
        <BubbleButton
          href="/portfolio"
          variant="outline"
          class="w-full md:w-auto text-center !border-white !text-white hover:!border-[#d4af37] !bg-white/10 backdrop-blur-md hover:!bg-white/20"
        >
          Vezi proiecte
        </BubbleButton>
      </div>
    </div>

    <!-- Decorative Elements -->
    <!-- Scroll indicator removed -->
  </div><!-- End hero-content-wrapper -->
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";

  gsap.registerPlugin(ScrollTrigger, MorphSVGPlugin);

  const widthTarget = 1110;
  const desktopResolution = { width: 1890, height: 916 };
  const mobileResolution = { width: 1020, height: 882 };

  // Safe initialization - only run once per page
  let heroAnimInitialized = false;
  function safeInitHeroAnim() {
    if (heroAnimInitialized) return;
    const section = document.querySelector("#hero-section");
    if (!section || (section as HTMLElement).dataset.heroAnimInit) return;
    heroAnimInitialized = true;
    initHeroAnim();
  }

  document.addEventListener("astro:page-load", () => {
    heroAnimInitialized = false; // Reset on page navigation
    safeInitHeroAnim();
  });

  // For initial load (before Astro routing takes over)
  if (document.readyState === "complete") {
    requestAnimationFrame(safeInitHeroAnim);
  } else {
    window.addEventListener("load", safeInitHeroAnim);
  }

  function initHeroAnim() {
    const section = document.querySelector("#hero-section");
    const svg = document.querySelector("#mySVG");
    if (!section || !svg) return;

    // Mark as initialized
    (section as HTMLElement).dataset.heroAnimInit = "true";

    // Custom split specifically for this known title structure
    const splitHeroCardTitle = () => {
      const titleEl = section.querySelector(".hero-card-title");
      if (titleEl) {
        // We know the structure. simpler to just animate children if they were spans.
        const html = `
            <span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">Calitate</span></span>
            <span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">Fără</span></span>
            <br />
            <span class="text-accent inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">Compromis</span></span>
           `;
        titleEl.innerHTML = html;
      }
    };

    splitHeroCardTitle();

    // Ensure parent is visible immediately after split, children are hidden
    const titleEl = section.querySelector(".hero-card-title");
    if (titleEl) gsap.set(titleEl, { opacity: 1 });

    // Use Context for easy cleanup
    const ctx = gsap.context(() => {
      const masterTl = gsap.timeline({ defaults: { ease: "power3.out" } });

      // --- 1. SVG & Background Setup ---
      try {
        const width = window.innerWidth;
        const height = window.innerHeight;

        svg.setAttribute("viewBox", `0 0 ${width} ${height}`);

        // Select Path (now inside clipPath)
        let path = svg.querySelector("#heroPath");
        if (!path) {
          // Fallback if structure damaged
          path = document.createElementNS("http://www.w3.org/2000/svg", "path");
          path.id = "heroPath";
          svg.appendChild(path);
        }

        // Initial State (Rectangle) - SVG is hidden via opacity-0 class
        path.setAttribute("d", rectangle(width, height));

        // Fade in SVG now that path is set
        gsap.to(svg, { opacity: 1, duration: 0.3 });

        // SVG Animation (Step 1)
        if (gsap.plugins.morphSVG) {
          masterTl.add(runSvgAnim(path, width, height));
        } else {
          console.warn("GSAP MorphSVGPlugin not loaded. Skipping morph.");
        }

        // Resize Listener
        const onResize = () => {
          const w = window.innerWidth;
          const h = window.innerHeight;
          svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
          path.setAttribute("d", cross(w, h));
        };
        window.addEventListener("resize", onResize);
      } catch (e) {
        console.warn("Hero Background Animation Error:", e);
      }

      // --- 2. Text Content (Step 2) ---
      // Start this block '-=0.5' seconds before SVG finishes
      masterTl.from(
        ".hero-text-line",
        {
          y: 100,
          opacity: 0,
          duration: 1,
          stagger: 0.2,
          ease: "power3.out",
        },
        "-=0.5"
      );

      // --- 3. Synchronized Content (Navbar, Subtitle, Buttons, Image) ---
      // All loading AT THE SAME TIME as the text start ("<")

      // Navbar
      const navbar = document.querySelector("#navbar-container");
      if (navbar) {
        // Instant opacity, elastic scale for "Pop" effect
        masterTl.to(navbar, { opacity: 1, duration: 0.05 }, "<");
        masterTl.to(
          navbar,
          {
            scale: 1,
            duration: 1.8,
            ease: "back.out(1.2)",
          },
          "<"
        );
      }

      // Subtitle
      masterTl.to(".hero-subtitle", { y: 0, opacity: 1, duration: 0.8 }, "<");

      // Buttons
      masterTl.to(".hero-cta", { y: 0, opacity: 1, duration: 0.8 }, "<");

      // Smooth scroll for About button in visual card
      const aboutBtn = section.querySelector("#hero-about-btn");
      if (aboutBtn) {
        aboutBtn.addEventListener("click", (e) => {
          e.preventDefault();
          // @ts-ignore
          if (window.smoother) {
            // @ts-ignore
            window.smoother.scrollTo("#about-section", true, "top top");
          } else {
            const target = document.querySelector("#about-section");
            target?.scrollIntoView({ behavior: "smooth" });
          }
        });
      }

      // --- 4. Hero Card & Inner Elements ---
      // Card Mask Reveal
      masterTl
        .to(
          ".hero-image-mask",
          {
            scale: 1,
            opacity: 1,
            duration: 1.8,
            ease: "expo.out",
          },
          "<"
        )
        .from(
          ".hero-image-inner",
          {
            scale: 1.4,
            duration: 2,
            ease: "power2.out",
          },
          "<"
        );

      // DISTINCT ANIMATIONS for Inner Card Elements
      // Trigger these slightly before the card finishes revealing for a nice overlap

      // a) Title Stagger (Word by Word)
      masterTl.to(
        ".hero-card-title span span",
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "expo.out",
        },
        "-=1.2"
      );

      // b) Subtext Slide Up
      masterTl.fromTo(
        ".hero-card-subtext",
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: "power2.out" },
        "-=0.9"
      );

      // c) Button Elastic Pop
      masterTl.fromTo(
        ".hero-card-btn",
        { scale: 0.5, opacity: 0 },
        { scale: 1, opacity: 1, duration: 0.8, ease: "back.out(1.7)" },
        "-=0.8"
      );

      // d) Right Image Reveal (Slide + Fade)
      masterTl.fromTo(
        ".hero-card-img",
        { x: 30, opacity: 0 },
        { x: 0, opacity: 1, duration: 1, ease: "power2.out" },
        "-=1.0"
      );
    }, section);
  }

  function runSvgAnim(path: Element, width: number, height: number) {
    const tl = gsap.timeline();

    tl.from("#mySVG", {
      scale: 1.5,
      duration: 1,
      ease: "power4.out",
    }).to(path, {
      scale: 1,
      duration: width > widthTarget ? 1.8 : 0.6,
      morphSVG: cross(width, height),
      ease: width > widthTarget ? "elastic.out(1, 0.9)" : "back.out(1.7)",
    });

    return tl;
  }

  function rectangle(w: number, h: number) {
    const displayCond = w > widthTarget;
    let w1 = mobileResolution.width;
    let h1 = mobileResolution.height;

    if (displayCond) {
      w1 = desktopResolution.width;
      h1 = desktopResolution.height;
    }

    const rw = (val: number) => (val / w1) * w;
    const rh = (val: number) => (val / h1) * h;

    // Mobile: Added 15px padding top/bottom (start at 15, end at 867)
    return displayCond
      ? `M${rw(12)} ${rh(1)} H${rw(12)} C${rw(4)} ${rh(1)} ${rw(1)} ${rh(4)} ${rw(1)} ${rh(12)} V${rh(905)} C${rw(1)} ${rh(913)} ${rw(4)} ${h} ${rw(12)} ${h} H${rw(1879)} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} V${h} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} H${rw(1879)} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} V${h} C${rw(1879)} ${h} ${rw(1879)} ${h} ${rw(1879)} ${h} H${rw(1879)} C${rw(1887)} ${h} ${w} ${rh(913)} ${w} ${rh(905)} V${rh(12)} C${w} ${rh(12)} ${w} ${rh(12)} ${w} ${rh(12)} H${w} C${w} ${rh(4)} ${rw(1887)} ${rh(1)} ${rw(1879)} ${rh(1)} V${rh(1)} C${rw(1879)} ${rh(1)} ${rw(1879)} ${rh(1)} ${rw(1879)} ${rh(1)} H${rw(12)} V${rh(1)} C${rw(4)} ${rh(1)} ${rw(1)} ${rh(4)} ${rw(1)} ${rh(12)} Z`
      : `M${rw(1000)} ${rh(15)} H${rw(21)} C${rw(9.9543)} ${rh(15)} ${rw(1)} ${rh(24.9543)} ${rw(1)} ${rh(35)} V${rh(845)} C${rw(1)} ${rh(845)} ${rw(1)} ${rh(845)} ${rw(1)} ${rh(845)} H${rw(1)} C${rw(1)} ${rh(860)} ${rw(6)} ${rh(867)} ${rw(21)} ${rh(867)} V${rh(867)} C${rw(21)} ${rh(867)} ${rw(21)} ${rh(867)} ${rw(21)} ${rh(867)} H${rw(997)} C${rw(997)} ${rh(867)} ${rw(997)} ${rh(867)} ${rw(997)} ${rh(867)} V${rh(867)} C${rw(1016)} ${rh(867)} ${w} ${rh(862)} ${w} ${rh(845)} H${w} C${w} ${rh(845)} ${w} ${rh(845)} ${w} ${rh(845)} V${rh(35)} C${w} ${rh(24.9543)} ${rw(1011.05)} ${rh(15)} ${rw(1000)} ${rh(15)} Z`;
  }

  function cross(w: number, h: number) {
    const displayCond = w > widthTarget;
    let w1 = mobileResolution.width;
    let h1 = mobileResolution.height;

    if (displayCond) {
      w1 = desktopResolution.width;
      h1 = desktopResolution.height;
    }

    const rw = (val: number) => (val / w1) * w;
    const rh = (val: number) => (val / h1) * h;

    // Desktop: Made less tall (top: 125->145, bottom: 792->772) and cutouts pushed more inward
    // Top-left cutout: was 505, now 470 (more inward)
    // Top-right cutout: was 1385, now 1420 (more inward)
    // Bottom-left cutout: was 280, now 320 (more inward)
    // Bottom-right cutout: was 1168, now 1128 (more inward)
    // Mobile: Made shorter (722->680), cutouts pushed inward HORIZONTALLY:
    //   Bottom-left: 160->220 (pushed right toward center)
    //   Bottom-right: 841->781 (pushed left toward center)
    return displayCond
      ? `M${rw(470)} ${rh(145)} H${rw(19)} C${rw(9)} ${rh(145)} ${rw(1)} ${rh(153)} ${rw(1)} ${rh(163)} V${rh(754)} C${rw(1)} ${rh(763)} ${rw(9)} ${rh(772)} ${rw(19)} ${rh(772)} H${rw(320)} C${rw(330)} ${rh(772)} ${rw(338)} ${rh(780)} ${rw(338)} ${rh(790)} V${rh(898)} C${rw(338)} ${rh(907)} ${rw(346)} ${h} ${rw(356)} ${h} H${rw(1092)} C${rw(1102)} ${h} ${rw(1110)} ${rh(907)} ${rw(1110)} ${rh(898)} V${rh(789)} C${rw(1110)} ${rh(779)} ${rw(1118)} ${rh(771)} ${rw(1128)} ${rh(771)} H${rw(1872)} C${rw(1881)} ${rh(771)} ${w} ${rh(763)} ${w} ${rh(753)} V${rh(164)} C${w} ${rh(154)} ${rw(1881)} ${rh(146)} ${rw(1872)} ${rh(146)} H${rw(1420)} C${rw(1410)} ${rh(146)} ${rw(1402)} ${rh(137)} ${rw(1402)} ${rh(128)} V${rh(19)} C${rw(1402)} ${rh(9)} ${rw(1394)} ${rh(1)} ${rw(1384)} ${rh(1)} H${rw(506)} C${rw(496)} ${rh(1)} ${rw(488)} ${rh(9)} ${rw(488)} ${rh(19)} V${rh(127)} C${rw(488)} ${rh(137)} ${rw(480)} ${rh(145)} ${rw(470)} ${rh(145)} Z`
      : `M${rw(1000)} ${rh(15)} H${rw(21)} C${rw(9.9543)} ${rh(15)} ${rw(1)} ${rh(24.9543)} ${rw(1)} ${rh(35)} V${rh(680)} C${rw(1)} ${rh(691.046)} ${rw(9.9543)} ${rh(700)} ${rw(21)} ${rh(700)} H${rw(220)} C${rw(231.046)} ${rh(700)} ${rw(240)} ${rh(708.954)} ${rw(240)} ${rh(720)} V${rh(846.869)} C${rw(240)} ${rh(857.915)} ${rw(248.954)} ${rh(866.869)} ${rw(260)} ${rh(866.869)} H${rw(741)} C${rw(752.046)} ${rh(866.869)} ${rw(761)} ${rh(857.915)} ${rw(761)} ${rh(846.869)} V${rh(720)} C${rw(761)} ${rh(708.954)} ${rw(769.954)} ${rh(700)} ${rw(781)} ${rh(700)} H${rw(1000)} C${rw(1011.05)} ${rh(700)} ${w} ${rh(691.046)} ${w} ${rh(680)} V${rh(35)} C${w} ${rh(24.9543)} ${rw(1011.05)} ${rh(15)} ${rw(1000)} ${rh(15)} Z`;
  }

  // Hero Exit Animation: Pin hero, scale down and blur as About section slides over
  function initHeroExitAnimation() {
    const heroSection = document.querySelector("#hero-section");
    const heroContent = document.querySelector("#hero-content-wrapper");

    if (!heroSection || !heroContent) return;

    // Mobile detection
    const isMobile = window.innerWidth < 1024;

    // Fix iOS Safari address bar resize issue:
    // Lock the hero section height to current value on load
    if (isMobile) {
      const currentHeight = (heroSection as HTMLElement).offsetHeight;
      (heroSection as HTMLElement).style.height = `${currentHeight}px`;
      (heroSection as HTMLElement).style.minHeight = "unset";
    }

    // Blur + fade + SCALE animation for entire hero content
    gsap.to(heroContent, {
      scale: isMobile ? 0.8 : 0.9,
      filter: isMobile ? "blur(4px)" : "blur(8px)",
      opacity: 0.5,
      ease: "none",
      force3D: true,
      scrollTrigger: {
        trigger: heroSection,
        start: "bottom bottom",
        end: "bottom top",
        // Use numeric scrub for better iOS compatibility
        scrub: 0.5,
        pin: true,
        pinSpacing: false,
        // Force refresh on orientation change
        invalidateOnRefresh: true,
      },
    });

    // Mark as initialized to prevent re-runs
    (heroSection as HTMLElement).dataset.exitAnimInit = "true";
  }

  // Initialize hero exit animation - only once
  let heroExitInitialized = false;
  function safeInitHeroExitAnimation() {
    if (heroExitInitialized) return;
    const heroSection = document.querySelector("#hero-section");
    if (heroSection && (heroSection as HTMLElement).dataset.exitAnimInit)
      return;
    heroExitInitialized = true;
    initHeroExitAnimation();
  }

  document.addEventListener("astro:page-load", () => {
    heroExitInitialized = false; // Reset on page navigation
    safeInitHeroExitAnimation();
  });

  if (document.readyState === "complete") {
    requestAnimationFrame(safeInitHeroExitAnimation);
  } else {
    window.addEventListener("load", safeInitHeroExitAnimation);
  }
</script>
