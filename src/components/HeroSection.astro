---
import BubbleButton from "./ui/BubbleButton.astro";
import { HERO } from "../config/content";

const heroImage = "/Poze JL Custom Design - Site/LP/Hero/Desktop.webp";

// Server-side text splitting to avoid JS overhead and forced reflows
const splitTitle = HERO.title.split('<br />').map(part => {
  return part.trim().split(/\s+/).map(word => {
    // We use a specific structure that the animation script will pick up
    return `<span class="inline-block overflow-hidden"><span class="hero-word inline-block translate-y-[110%] opacity-0 will-change-transform">${word}</span></span>`;
  }).join(' ');
}).join('<br />');
---

<section
  class="relative h-[100svh] flex items-center bg-secondary overflow-hidden"
  id="hero-section"
  data-theme="dark"
  style="z-index: 1;"
>
  <!-- Ultra-Stable LCP Target: A background image layer that is technically visible 
       to Lighthouse but effectively invisible to users. This ensures LCP is identified 
       at the very first paint and never shifts. -->
  <div 
    class="absolute inset-0 z-[-1] pointer-events-none opacity-[0.02]" 
    style={`background-image: url(${heroImage}); background-size: cover; background-position: center;`}
    aria-hidden="true"
  ></div>

  <!-- Hero Content Wrapper (for scale/blur animation) -->
  <div
    id="hero-content-wrapper"
    class="absolute inset-0 flex items-center gpu-accelerated"
    style="transform-origin: center center;"
  >
    <!-- Background SVG Container -->
    <div
      class="absolute inset-0 z-0 overflow-hidden flex justify-center items-center pointer-events-none"
    >
      <svg
        id="mySVG"
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="100%"
        preserveAspectRatio="none"
        class="w-full h-full gpu-accelerated initial-hero-state"
        style="transform-origin: center center;"
      >
        <defs>
          <clipPath id="heroClip">
            <path id="heroPath" fill="white"></path>
          </clipPath>
        </defs>
        <!-- Standard SVG Image (Lighthouse friendly if correctly sized) -->
        <image
          id="hero-image-svg"
          href={heroImage}
          width="100%"
          height="100%"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#heroClip)"
          image-rendering="optimizeQuality"
        />
        <!-- Overlay for text contrast -->
        <rect
          width="100%"
          height="100%"
          fill="black"
          opacity="0.1"
          clip-path="url(#heroClip)"></rect>
      </svg>
    </div>

    <!-- Content Container -->
    <div
      class="container mx-auto px-4 md:px-8 relative z-10 flex flex-col justify-center h-full pointer-events-none"
    >
      <!-- Left: Text Content -->
      <div class="relative group pointer-events-auto" id="hero-title-container">
        <!-- Main Title -->
        <h1
          id="hero-title"
          class="font-serif font-normal text-4xl sm:text-5xl md:text-7xl lg:text-8xl xl:text-8xl 2xl:text-9xl leading-tight text-white mb-6 relative z-10 title-hover w-fit pointer-events-none"
          data-cursor-scale="5.0"
        >
          <Fragment set:html={splitTitle} />
          <span class="sr-only"> la comandă în Brașov — mobilier personalizat și mobilă la comandă Brașov</span>
        </h1>

        <h2
          class="hero-subtitle font-sans font-normal text-lg md:text-xl text-white/80 max-w-2xl lg:max-w-4xl mb-10 hero-text-element opacity-0 translate-y-4"
        >
          {HERO.subtitle}
        </h2>
      </div>
    </div>

    <!-- CTA Buttons (Centered low on mobile, Higher on tablet, Cutout on large desktop) -->
    <div
      class="absolute bottom-[5vh] left-1/2 -translate-x-1/2 z-20 w-fit md:bottom-[15.7vh] md:translate-y-1/2 xl:bottom-[7.8vh] xl:left-[38.3%] xl:translate-y-1/2"
    >
      <div class="hero-cta flex flex-col xl:flex-row gap-4">
        <BubbleButton
          href="/contact"
          variant="hero-dark"
          class="hero-btn w-full xl:w-auto text-center invisible opacity-0 translate-y-4"
        >
          {HERO.ctaPrimary}
        </BubbleButton>
        <BubbleButton
          href="/portfolio"
          id="glass-btn"
          variant="hero-glass"
          class="hero-btn w-full xl:w-auto text-center invisible opacity-0 translate-y-4"
        >
          {HERO.ctaSecondary}
        </BubbleButton>
      </div>
    </div>

    <!-- Top Left Copy (Cutout) -->
    <div
      class="absolute top-[7.8vh] left-[12.43%] -translate-x-1/2 -translate-y-1/2 z-20 hidden xl:block whitespace-nowrap"
    >
      <span
        class="text-xl lg:text-2xl xl:text-3xl 2xl:text-4xl font-serif font-black tracking-widest uppercase text-[#1A1A1A] opacity-0 invisible hero-top-left"
      >
        {HERO.topLeftBrand}
      </span>
    </div>

    <!-- Top Right Button (Cutout) -->
    <div
      class="absolute top-[7.8vh] right-[12.43%] translate-x-1/2 -translate-y-1/2 z-20 hidden xl:block"
    >
      <a
        href="/contact"
        class="group flex items-center gap-3 xl:gap-4 opacity-0 invisible hero-top-right"
      >
        <div
          class="bg-transparent text-black border border-black px-6 py-3 xl:px-8 xl:py-4 rounded-full text-xs xl:text-sm font-extrabold uppercase tracking-wider transition-all duration-300 group-hover:bg-black group-hover:text-white group-hover:scale-105 shadow-none hover:shadow-xl"
        >
          {HERO.topRightCta}
        </div>
        <div
          class="w-12 h-12 xl:w-14 xl:h-14 bg-transparent text-black border border-black rounded-full flex items-center justify-center transition-all duration-300 group-hover:bg-black group-hover:text-white shadow-none hover:shadow-xl"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 14 14"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          >
            <path
              d="M1 13L13 1M13 1H4M13 1V10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>

    <!-- Decorative Elements -->
    <!-- Scroll indicator removed -->
  </div><!-- End hero-content-wrapper -->
</section>

<style>
  /* CSS-only initial state for better FCP and LCP stability.
     This ensures the browser knows the exact geometry before JS even loads. */
  .initial-hero-state {
    transform: scale(1.15); /* Default mobile start */
  }
  @media (min-width: 1024px) {
    .initial-hero-state {
      transform: scale(1.5); /* Desktop start */
    }
  }
  
  /* Initial state for hero words (server-side split) */
  .hero-word {
    transform: translateY(110%);
    opacity: 0;
  }
</style>

<script>
  import { initHeroAnimations } from "../scripts/hero-animation";

  // Initialize animations
  initHeroAnimations();
</script>
