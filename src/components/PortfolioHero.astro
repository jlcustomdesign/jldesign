---
// PortfolioHero.astro
---

<section class="osmo-header is--loading relative min-h-[100svh] w-full overflow-hidden bg-white" id="portfolio-hero-section">
  <div class="osmo-loader">
    <div class="osmo__h1 font-serif text-black opacity-0 loader-text-container">
      <div class="osmo__h1-start">
        <span class="osmo__letter">P</span>
        <span class="osmo__letter">O</span>
        <span class="osmo__letter">R</span>
        <span class="osmo__letter">T</span>
        <span class="osmo__letter">O</span>
      </div>
      <div class="osmo-loader__box">
        <div class="osmo-loader__box-inner">
          <div class="osmo__growing-image">
            <div class="osmo__growing-image-wrap">
              <img class="osmo__cover-image-extra is--1" src="/Poze JL Custom Design - Site/Portofoliu/1.webp" loading="lazy" alt="Proiect Mobila Comanda 1">
              <img class="osmo__cover-image-extra is--2" src="/Poze JL Custom Design - Site/Portofoliu/2.webp" loading="lazy" alt="Proiect Mobila Comanda 2">
              <img class="osmo__cover-image-extra is--3" src="/Poze JL Custom Design - Site/Portofoliu/3.webp" loading="lazy" alt="Proiect Mobila Comanda 3">
              <img class="osmo__cover-image" src="/Poze JL Custom Design - Site/Portofoliu/4 Desktop.webp" loading="lazy" alt="Proiect Mobila Comanda 4">
            </div>
          </div>
        </div>
      </div>
      <div class="osmo__h1-end">
        <span class="osmo__letter">F</span>
        <span class="osmo__letter">O</span>
        <span class="osmo__letter">L</span>
        <span class="osmo__letter">I</span>
        <span class="osmo__letter">U</span>
      </div>
    </div>
  </div>
  
  <div class="osmo-header__content pointer-events-none">
    <div class="osmo-header__bottom pointer-events-auto">
      <div class="osmo__h1 font-serif final-title opacity-0">
        <span class="osmo__letter-white">P</span>
        <span class="osmo__letter-white">O</span>
        <span class="osmo__letter-white">R</span>
        <span class="osmo__letter-white">T</span>
        <span class="osmo__letter-white">O</span>
        <span class="osmo__letter-white">F</span>
        <span class="osmo__letter-white">O</span>
        <span class="osmo__letter-white">L</span>
        <span class="osmo__letter-white">I</span>
        <span class="osmo__letter-white">U</span>
      </div>
    </div>
  </div>
</section>

<style>
/* CSS adapted from Osmo */
.osmo-header {
  color: #1a1a1a;
}

.osmo-loader {
  color: #201d1d;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  display: flex;
  position: absolute;
  top: 0;
  left: 0;
  overflow: hidden;
  z-index: 10; /* Lower than content and navbar */
}

.osmo__h1 {
  white-space: nowrap;
  justify-content: center;
  font-size: 10vw; /* Responsive font size */
  font-weight: 500;
  line-height: .75;
  display: flex;
  position: relative;
  text-transform: uppercase;
}

.osmo__h1-start {
  justify-content: flex-end;
  display: flex;
  overflow: hidden;
  width: 50vw; /* Forces perfect centering of the middle box */
}

.osmo__h1-end {
  justify-content: flex-start;
  display: flex;
  overflow: hidden;
  width: 50vw; /* Forces perfect centering of the middle box */
}

.osmo__letter {
  display: block;
  position: relative;
  color: #1a1a1a; 
}

.osmo-loader__box {
  flex-flow: column;
  justify-content: center;
  align-items: center;
  width: 0;
  display: flex;
  position: relative;
}

.osmo-loader__box-inner {
  justify-content: center;
  align-items: center;
  min-width: 1em;
  height: 95%;
  display: flex;
  position: relative;
}

.osmo__growing-image {
  justify-content: center;
  align-items: center;
  width: 0%;
  height: 100%;
  display: flex;
  position: absolute;
  overflow: hidden;
}

.osmo__growing-image-wrap {
  width: 100vw;
  min-width: 100vw; /* Ensure no margin on sides */
  height: 100vh; /* Full viewport height to prevent crop shifting */
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%); /* Keeps image locked in center during mask expansion */
}

.osmo__cover-image, .osmo__cover-image-extra {
  pointer-events: none;
  object-fit: cover;
  -webkit-user-select: none;
  user-select: none;
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.osmo__cover-image-extra.is--1 { z-index: 3; }
.osmo__cover-image-extra.is--2 { z-index: 2; }
.osmo__cover-image-extra.is--3 { z-index: 1; }

.osmo-header__content {
  flex-flow: column;
  justify-content: flex-end;
  align-items: center; /* Centered on mobile */
  width: 100%;
  height: 100%;
  display: flex;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  padding: 1.5rem;
}

@media screen and (min-width: 768px) {
  .osmo-header__content {
    align-items: flex-start; /* Left-aligned on desktop */
    padding: 2.5rem;
  }
}

.osmo-header__bottom {
  justify-content: center; /* Centered on mobile */
  align-items: flex-end;
  width: 100%;
  display: flex;
  position: relative;
}

@media screen and (min-width: 768px) {
  .osmo-header__bottom {
    justify-content: flex-start; /* Left-aligned on desktop */
  }
}

.final-title {
  font-size: clamp(3.5rem, 11vw, 12rem) !important;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.osmo__letter-white {
  display: block;
  position: relative;
  color: white;
}

@media screen and (max-width: 991px) {
  .osmo__h1 {
    font-size: 12vw; /* Reduced to prevent side-clipping */
  }
}

@media screen and (max-width: 767px) {
  .osmo__h1 {
    font-size: 12vw; /* Consistent mobile size */
  }
}
</style>

<script>
  import { gsap } from "gsap";

  function initOsmoLoadingAnimation() {
    const container = document.querySelector(".osmo-header");
    if (!container) return;

    const loadingLetter = container.querySelectorAll(".osmo__letter");
    const box = container.querySelectorAll(".osmo-loader__box");
    const growingImage = container.querySelectorAll(".osmo__growing-image");
    const headingStart = container.querySelectorAll(".osmo__h1-start");
    const headingEnd = container.querySelectorAll(".osmo__h1-end");
    const coverImageExtra = container.querySelectorAll(".osmo__cover-image-extra");
    const headerLetter = container.querySelectorAll(".osmo__letter-white");
    const finalTitleContainer = container.querySelector(".final-title");
    const loaderTextContainer = container.querySelector(".loader-text-container");
    const navbar = document.querySelector("#navbar-container");
    
    // Check if animation already ran
    if (container.classList.contains('anim-done')) return;
    
    /* GSAP Timeline */
    const tl = gsap.timeline({
      defaults: {
        ease: "expo.inOut",
      },
      onStart: () => {
        document.body.style.overflow = 'hidden'; // Lock scroll during intro
      },
      onComplete: () => {
        document.body.style.overflow = ''; // Unlock scroll
        container.classList.add('anim-done');
        
        // Hide the loader text so it doesn't stay visible behind
        gsap.set(loadingLetter, { opacity: 0 });
      }
    });
    
    /* Start of Timeline */
    if (loadingLetter.length) {
      tl.set(loaderTextContainer, { opacity: 1 });
      tl.fromTo(loadingLetter, { yPercent: 100 }, {
        yPercent: 0,
        stagger: 0.025,
        duration: 1.25
      });
    }
    
    if (box.length) {
      tl.fromTo(box, {
        width: "0em",
      },{
        width: "1em",
        duration: 1.25
      }, "< 1.25");
    }

    if (growingImage.length) {
      tl.fromTo(growingImage, {
        width: "0%",
      },{
        width: "100%",
        duration: 1.25
      }, "<");
    }
    
    if (headingStart.length) {
      tl.fromTo(headingStart, {
        x: "0em",
      },{
        x: "-0.05em",
        duration: 1.25
      }, "<");
    }
    
    if (headingEnd.length) {
      tl.fromTo(headingEnd, {
        x: "0em",
      },{
        x: "0.05em",
        duration: 1.25
      }, "<");
    }

    if (coverImageExtra.length) {
      tl.fromTo(coverImageExtra, {
        opacity: 1,
      },{
        opacity: 0,
        duration: 0.05,
        ease: "none",
        stagger: 0.5
      }, "-=0.05");
    }
      
    if (growingImage.length) {
      tl.to(growingImage, {
        width: "100vw",
        height: "100dvh",
        duration: 2
      }, "< 1.25");
    }
    
    if (box.length) {
      tl.to(box, {
        width: "110vw",
        duration: 2
      }, "<");
    }
    
    if (headerLetter.length) {
      tl.set(finalTitleContainer, { opacity: 1 }, "<");
      tl.fromTo(headerLetter, { yPercent: 100 }, {
        yPercent: 0,
        duration: 1.25,
        ease: "expo.out",
        stagger: 0.025
      }, "< 1.2");
    }
    
    if (navbar) {
      gsap.set(navbar, { css: { transition: "none" } });
      
      tl.to(navbar, { opacity: 1, duration: 0.05 }, "< 0.5");
      
      tl.to(navbar, {
        scale: 1,
        duration: 1.0,
        ease: "back.out(1.7)",
        force3D: true,
        onComplete: () => {
          gsap.set(navbar, { clearProps: "transition" });
        }
      }, "<");
    }
  }

  // Use Astro page load and DOMContentLoaded to ensure it runs
  document.addEventListener("astro:page-load", initOsmoLoadingAnimation);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(initOsmoLoadingAnimation, 50);
  } else {
    document.addEventListener("DOMContentLoaded", initOsmoLoadingAnimation);
  }
</script>
