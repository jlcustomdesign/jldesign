---
import BubbleButton from "./ui/BubbleButton.astro";

const heroImage = "/Images/optimized/Proiecte-JL-Custom-Design-02.webp";
---

<section
  class="relative min-h-screen bg-secondary flex items-center justify-center p-4 pt-24 md:p-8 md:pt-32 overflow-hidden"
  id="portfolio-hero-section"
  data-theme="dark"
>
  <!-- FULL-SCREEN HERO BACKGROUND (All Devices) -->
  <div class="absolute inset-0 w-full h-[100svh] overflow-hidden">
    <img
      src={heroImage}
      alt="Selected Works"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out overlay-bg"
    />
    <!-- Darkening Overlay to ensure text readability -->
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <!-- UNIFIED MARQUEE STACK (Visible on All Devices) -->
  <div
    class="absolute bottom-4 md:bottom-12 left-0 w-full flex flex-col justify-end overflow-visible pb-4 md:pb-8 pointer-events-none z-40"
  >
    <div class="custom-marquees z-20">
      <!-- Band 1: Title -->
      <div class="custom-marquee hero-marquee" style="--char-count: 25">
        <div class="custom-marquee-inner">
          <p>LUCRĂRI SELECTATE</p>
          <p aria-hidden="true">LUCRĂRI SELECTATE</p>
          <p aria-hidden="true">LUCRĂRI SELECTATE</p>
          <p aria-hidden="true">LUCRĂRI SELECTATE</p>
          <p aria-hidden="true">LUCRĂRI SELECTATE</p>
          <p aria-hidden="true">LUCRĂRI SELECTATE</p>
        </div>
      </div>

      <!-- Band 2: Description -->
      <div
        class="custom-marquee hero-marquee marquee-flat"
        style="--char-count: 35"
      >
        <div class="custom-marquee-inner">
          <p>MOBILIER ȘI DESIGN INTERIOR</p>
          <p aria-hidden="true">MOBILIER ȘI DESIGN INTERIOR</p>
          <p aria-hidden="true">MOBILIER ȘI DESIGN INTERIOR</p>
          <p aria-hidden="true">MOBILIER ȘI DESIGN INTERIOR</p>
          <p aria-hidden="true">MOBILIER ȘI DESIGN INTERIOR</p>
          <p aria-hidden="true">MOBILIER ȘI DESIGN INTERIOR</p>
        </div>
      </div>

      <!-- Band 3: Qualities -->
      <div
        class="custom-marquee hero-marquee marquee-flat"
        style="--char-count: 28"
      >
        <div class="custom-marquee-inner">
          <p>ELEGANȚĂ ȘI RAFINAMENT</p>
          <p aria-hidden="true">ELEGANȚĂ ȘI RAFINAMENT</p>
          <p aria-hidden="true">ELEGANȚĂ ȘI RAFINAMENT</p>
          <p aria-hidden="true">ELEGANȚĂ ȘI RAFINAMENT</p>
          <p aria-hidden="true">ELEGANȚĂ ȘI RAFINAMENT</p>
          <p aria-hidden="true">ELEGANȚĂ ȘI RAFINAMENT</p>
        </div>
      </div>

      <!-- Static CTA Button -->
      <div
        class="mobile-cta-wrapper z-30 block mx-auto w-[calc(100%-4rem)] md:w-auto md:max-w-none md:absolute md:right-16 md:bottom-24 max-w-[340px] mt-8 mb-4 pointer-events-auto"
      >
        <a
          href="/contact"
          class="mobile-cta-btn block w-full bg-[#f3bb0b] hover:bg-[#d6a50b] active:scale-95 transition-all duration-300 rounded-2xl py-4 px-6 md:py-5 md:px-8 shadow-xl"
        >
          <div class="flex items-center justify-between gap-6 w-full h-full">
            <span class="font-sans font-semibold text-black text-xl md:text-2xl"
              >Începe un Proiect</span
            >
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#000"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="md:w-8 md:h-8"
            >
              <path d="M5 19L19 5M19 5v14M19 5H5"></path>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .custom-marquees {
    display: flex;
    flex-direction: column;
    gap: 3vw;
    width: 110%;
    margin-left: -5%;
    overflow: visible;
  }

  .custom-marquee {
    --marquee-color: #f3bb0b; /* Gold/Yellow background */
    --marquee-bg: var(--marquee-color);
    --marquee-text: #000000; /* Black text */
    --anim-duration: calc(0.8s * var(--char-count, 20));

    overflow: hidden;
    background: var(--marquee-bg);
    color: var(--marquee-text);
    transform: rotate(-6deg);
    padding: 0.2rem 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    border: 2px solid transparent; /* Prevents jumping when even styles apply borders */

    /* Move diagonal marquee upwards */
    margin-bottom: 2vh;
  }

  .custom-marquee:nth-child(even) {
    --marquee-bg: #111;
    --marquee-text: #f3bb0b; /* User requested gold text */
    transform: rotate(5deg);
    border-top: 2px solid #f3bb0b;
    border-bottom: 2px solid #f3bb0b;
  }

  /* Override for flat, transparent marquees */
  .custom-marquee.marquee-flat {
    --marquee-bg: transparent !important;
    --marquee-text: #ffffff !important;
    transform: none !important;
    border: none !important;
    box-shadow: none !important;
  }

  .custom-marquee-inner {
    width: max-content;
    display: flex;
    text-transform: uppercase;
    animation: customMarquee var(--anim-duration) infinite linear;
  }

  .custom-marquee:nth-child(even) .custom-marquee-inner {
    animation-direction: reverse;
  }

  .custom-marquee p {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-weight: 900;
    /* Massive desktop text, appropriate mobile text */
    font-size: clamp(3rem, 15vw, 12rem);
    line-height: 1.05;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding-right: 0.5em; /* spacing before the star/dot */
  }

  /* Make the title band even slightly larger if possible */
  .custom-marquee:not(.marquee-flat) p {
    font-size: clamp(3.5rem, 18vw, 14rem);
  }

  .custom-marquee p::after {
    content: "•";
    font-size: 0.7em;
    transform: translateY(-0.05em); /* visual centering */
  }

  @keyframes customMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% / 6));
    } /* 6 elements total */
  }
</style>

<script>
  import { initPortfolioHeroAnimations } from "../scripts/portfolio-hero-animation";

  // Initialize animations
  initPortfolioHeroAnimations();
</script>
