---
const heroImage = "/Images/Proiecte-JL Custom Design-01.jpg";
---

<section
  id="portfolio-hero-section"
  class="relative w-full min-h-screen flex flex-col justify-end pb-16 md:pb-24 lg:pb-32 px-4 md:px-8 bg-secondary overflow-hidden"
  data-theme="dark"
>
  <!-- Background Image -->
  <div id="portfolio-hero-bg" class="absolute inset-0 z-0 overflow-hidden">
    <img
      src={heroImage}
      alt="Portfolio Hero"
      class="w-full h-full object-cover scale-[1.1] portfolio-hero-image"
    />
    <!-- Dark Overlay for text readability -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/60 to-secondary/30"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div id="portfolio-hero-content" class="container mx-auto z-10 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      <!-- Left: Title -->
      <div class="lg:col-span-7">
        <!-- Small Label -->
        <div class="overflow-hidden mb-4 md:mb-6">
          <span
            class="portfolio-reveal-text text-accent text-sm md:text-base uppercase tracking-[0.3em] font-medium block opacity-0"
            style="transform: translateY(100%);"
          >
            Portofoliu
          </span>
        </div>

        <!-- Main Title -->
        <div class="overflow-hidden">
          <h1
            id="portfolio-hero-title"
            class="font-serif text-[14vw] sm:text-[12vw] md:text-[10vw] lg:text-[8rem] xl:text-[10rem] leading-[0.85] text-white uppercase opacity-0"
            style="transform: translateY(100%);"
          >
            LUCRĂRI<br class="hidden sm:block" />
            <span class="text-accent">SELECTATE</span>
          </h1>
        </div>
      </div>

      <!-- Right: Description -->
      <div class="lg:col-span-5 lg:pb-4">
        <div class="overflow-hidden">
          <p
            class="portfolio-reveal-text text-white/70 text-lg md:text-xl lg:text-2xl font-light leading-relaxed max-w-lg opacity-0"
            style="transform: translateY(100%);"
          >
            O colecție de mobilier și spații interioare, create să ridice
            cotidianul prin măiestrie și eleganță discretă.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 hidden md:block">
    <div
      class="portfolio-scroll-indicator flex flex-col items-center gap-2 opacity-0"
    >
      <span class="text-white/40 text-xs uppercase tracking-widest">Scroll</span
      >
      <div class="w-px h-12 bg-gradient-to-b from-white/40 to-transparent">
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context;

  function initPortfolioHeroAnim() {
    if (ctx) ctx.revert();

    ctx = gsap.context(() => {
      const heroSection = document.querySelector("#portfolio-hero-section");
      const heroContent = document.querySelector("#portfolio-hero-content");
      const heroBg = document.querySelector("#portfolio-hero-bg");
      const heroTitle = document.querySelector("#portfolio-hero-title");
      const revealTexts = document.querySelectorAll(".portfolio-reveal-text");
      const scrollIndicator = document.querySelector(
        ".portfolio-scroll-indicator",
      );
      const heroImage = document.querySelector(".portfolio-hero-image");

      if (!heroSection) return;

      // Master timeline for entrance
      const masterTl = gsap.timeline({
        defaults: { ease: "power3.out" },
        delay: 0.3,
      });

      // Background image scale animation
      if (heroImage) {
        masterTl.to(
          heroImage,
          {
            scale: 1,
            duration: 2,
            ease: "power2.out",
          },
          0,
        );
      }

      // Title reveal
      if (heroTitle) {
        masterTl.to(
          heroTitle,
          {
            y: 0,
            opacity: 1,
            duration: 1.4,
            ease: "power3.out",
          },
          0.2,
        );
      }

      // Other text reveals
      if (revealTexts.length > 0) {
        masterTl.to(
          revealTexts,
          {
            y: 0,
            opacity: 1,
            duration: 1.2,
            stagger: 0.1,
            ease: "power3.out",
          },
          0.5,
        );
      }

      // Scroll indicator
      if (scrollIndicator) {
        masterTl.to(
          scrollIndicator,
          {
            opacity: 1,
            duration: 0.8,
          },
          1.2,
        );
      }

      // Parallax scroll effect
      if (heroContent && heroBg) {
        gsap.to(heroContent, {
          scale: 0.92,
          filter: "blur(6px)",
          opacity: 0,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "bottom bottom",
            end: "bottom top",
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        });

        gsap.to(heroBg, {
          scale: 0.96,
          opacity: 0.3,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "bottom bottom",
            end: "bottom top",
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        });
      }
    });
  }

  // Initialize
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    setTimeout(initPortfolioHeroAnim, 50);
  } else {
    document.addEventListener("DOMContentLoaded", initPortfolioHeroAnim);
  }

  // Support View Transitions
  document.addEventListener("astro:page-load", initPortfolioHeroAnim);
  document.addEventListener("astro:before-swap", () => ctx?.revert());
</script>
