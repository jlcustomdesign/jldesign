---

const services = [
  {
    id: "kitchen",
    title: "Bucătării Custom",
    desc: "Inima casei tale, regândită. Funcționalitate desăvârșită îmbrăcată în materiale nobile.",
    img: "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?q=80&w=800&auto=format&fit=crop", // Vertical kitchen
  },
  {
    id: "dressing",
    title: "Dressing & Wardrobes",
    desc: "Mai mult decât depozitare. Un sanctuar al stilului tău. Iluminare ambientală și finisaje de catifea.",
    img: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?q=80&w=800&auto=format&fit=crop", // Vertical wardrobe
  },
  {
    id: "living",
    title: "Living & Library",
    desc: "Povestea casei, scrisă în lemn masiv. Biblioteci impunătoare și piese care dau tonul conversației.",
    img: "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?q=80&w=800&auto=format&fit=crop", // Vertical living
  },
  {
    id: "office",
    title: "Office & Comercial",
    desc: "Productivitate și stil. Spații de lucru ergonomice care impresionează clienții din prima clipă.",
    img: "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop", // Office
  },
  {
    id: "bathroom",
    title: "Baie & Wellness",
    desc: "Refugiul tău personal. Mobilier rezistent la umiditate, integrat perfect cu piatra și ceramica.",
    img: "https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?q=80&w=800&auto=format&fit=crop", // Bathroom
  },
];
---

<section
  id="services-section"
  class="py-24 md:py-32 bg-secondary overflow-hidden"
  data-theme="light"
>
  <div class="w-full px-4 pt-32 md:pt-48">
    <div class="container mx-auto px-4 md:px-0 mb-12 md:mb-16">
      <div class="flex flex-col md:flex-row justify-between items-center gap-12">
        <!-- Left: Title -->
        <h2 class="services-title flex-shrink-0 font-serif text-4xl md:text-5xl lg:text-7xl text-primary leading-tight whitespace-nowrap">
          Serviciile Noastre
        </h2>
        
        <!-- Right: Buttons (Desktop) -->
        <div class="hidden md:flex gap-3 flex-shrink-0">
          <button
            class="services-prev-btn services-nav-btn relative z-10 w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded-full bg-white shadow-xl border border-primary/10 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors duration-300 group"
            aria-label="Previous"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 md:w-6 md:h-6 group-hover:-translate-x-0.5 transition-transform">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            class="services-next-btn services-nav-btn relative z-10 w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded-full bg-white shadow-xl border border-primary/10 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors duration-300 group"
            aria-label="Next"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 md:w-6 md:h-6 group-hover:translate-x-0.5 transition-transform">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Carousel Container -->
  <div class="relative">
    <!-- Carousel Track -->
    <div
      id="services-carousel"
      class="flex gap-4 md:gap-6 px-6 md:px-8 will-change-transform"
      style="transform: translate3d(0, 0, 0);"
    >
      {
        services.map((service, i) => (
          <div
            class="service-card w-[75vw] md:w-[45vw] lg:w-[27%] h-[500px] rounded-2xl relative group flex-shrink-0 perspective-[1000px] bg-transparent shadow-none"
            data-index={i}
          >
            <!-- Inner Card (Flippable) -->
            <div class="service-card-inner relative w-full h-full transition-transform duration-700 transform-style-3d shadow-xl rounded-2xl">
              
              <!-- Front Face -->
              <div class="service-card-front absolute inset-0 w-full h-full backface-hidden rounded-2xl overflow-hidden bg-white">
                <!-- Image -->
                <div class="relative w-full h-full overflow-hidden">
                  <img
                    src={service.img}
                    alt={service.title}
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                  
                  <!-- Overlay Gradient -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>

                  <!-- Top Elements -->
                  <div class="absolute top-4 left-0 w-full px-4 flex justify-between items-start z-20 pointer-events-none">
                    <!-- Title Pill -->
                    <div class="bg-white/95 backdrop-blur-sm px-6 py-3 rounded-full shadow-md h-12 flex items-center">
                      <span class="text-base font-bold text-primary tracking-wide">{service.title}</span>
                    </div>

                    <!-- Flip Trigger Button -->
                    <button
                      class="service-flip-btn bg-white w-12 h-12 rounded-full flex items-center justify-center shadow-lg hover:bg-accent hover:text-white transition-colors duration-300 pointer-events-auto cursor-pointer"
                      aria-label="Flip Card"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"
                        />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Back Face -->
              <div class="service-card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 bg-[#1a1a1a] rounded-2xl p-8 flex flex-col justify-center items-center text-center border border-white/10">
                 <!-- Close/Flip Back Button -->
                 <button 
                    class="service-flip-back-btn absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors pointer-events-auto cursor-pointer"
                    aria-label="Flip Back"
                 >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                 </button>

                 <h3 class="font-serif text-2xl text-white mb-6">{service.title}</h3>
                 <p class="text-white/80 text-base leading-relaxed mb-8">
                   {service.desc}
                 </p>
                 
                 <a
                    href={`/services/${service.id}`}
                    class="inline-block px-8 py-4 bg-white text-primary font-bold rounded-full hover:bg-accent hover:text-white transition-colors duration-300 uppercase tracking-wider text-sm pointer-events-auto"
                 >
                   Vezi Proiect
                 </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobile Navigation Buttons (Bottom) -->
    <div class="flex md:hidden justify-center gap-4 mt-8 px-4">
          <button
            class="services-prev-btn services-nav-btn relative z-10 w-12 h-12 flex-shrink-0 rounded-full bg-white shadow-xl border border-primary/10 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors duration-300 group"
            aria-label="Previous"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 group-hover:-translate-x-0.5 transition-transform">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            class="services-next-btn services-nav-btn relative z-10 w-12 h-12 flex-shrink-0 rounded-full bg-white shadow-xl border border-primary/10 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors duration-300 group"
            aria-label="Next"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 group-hover:translate-x-0.5 transition-transform">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
    </div>
  </div>
</section>

<style>
  .perspective-\[1000px\] {
    perspective: 1000px;
    -webkit-perspective: 1000px;
  }
  .transform-style-3d {
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
  }
  .backface-hidden {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
  .service-card-inner.is-flipped {
    transform: rotateY(180deg);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initServicesCarousel() {
    const section = document.querySelector("#services-section");
    const carousel = document.querySelector("#services-carousel") as HTMLElement;
    // const prevBtn = document.querySelector("#services-prev") as HTMLButtonElement; // Replaced by class query
    // const nextBtn = document.querySelector("#services-next") as HTMLButtonElement; // Replaced by class query
    const cards = document.querySelectorAll(".service-card");

    if (!section || !carousel || cards.length === 0) return;

    // --- ENTRANCE ANIMATIONS ---
    const ctx = gsap.context(() => {
      // 1. Header Reveal
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 95%", // Start much earlier to prevent delay
          end: "top 20%",
          toggleActions: "play none none reverse"
        }
      });

      tl.from(".services-title", {
        y: 100,
        opacity: 0,
        duration: 1,
        ease: "power4.out"
      })
      .from(".services-desc", {
        y: 50,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out"
      }, "-=0.6")
      .from(".services-nav-btn", {
        scale: 0,
        opacity: 0,
        duration: 0.5,
        stagger: 0.1,
        ease: "back.out(1.7)"
      }, "-=0.4");

      // 2. Cards Staggered Entry
      gsap.from(cards, {
        scrollTrigger: {
          trigger: carousel,
          start: "top 95%", // Start earlier
        },
        x: 100,
        opacity: 0,
        duration: 1,
        stagger: 0.1,
        ease: "power4.out"
      });

      // 3. Image Parallax Effect (Match Portfolio)
      cards.forEach((card) => {
        const img = card.querySelector("img");
        if (img) {
          gsap.to(img, {
            y: "10%", // Move from -10% to 0% (relative to container, effectively moving down)
            ease: "none",
            scrollTrigger: {
              trigger: card,
              start: "top bottom",
              end: "bottom top",
              scrub: true
            }
          });
        }
      });

    }, section);

    // --- FLIP LOGIC ---
    // Re-select cards in case map rendered new ones? No, statically rendered.
    // Use existing cards variable.
    
    cards.forEach((card) => {
        const inner = card.querySelector(".service-card-inner");
        const flipBtn = card.querySelector(".service-flip-btn");
        const backBtn = card.querySelector(".service-flip-back-btn");

        if (flipBtn && inner) {
            flipBtn.addEventListener("click", (e) => {
                e.preventDefault(); 
                e.stopPropagation();
                // Close other cards? Optional. Let's keep it simple first.
                // document.querySelectorAll(".service-card-inner.is-flipped").forEach(el => {
                //   if(el !== inner) el.classList.remove("is-flipped");
                // });
                inner.classList.add("is-flipped");
            });
        }

        if (backBtn && inner) {
            backBtn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                inner.classList.remove("is-flipped");
            });
        }
    });

    // --- CAROUSEL LOGIC ---

    let isAnimating = false;

    // Helper to get dynamic gap + width
    const getStepSize = () => {
      const card = carousel.firstElementChild as HTMLElement;
      if (!card) return 0;
      
      const style = window.getComputedStyle(carousel);
      const gap = parseFloat(style.columnGap) || 0;
      
      return card.offsetWidth + gap;
    };

    const moveNext = () => {
      if (isAnimating) return;
      isAnimating = true;

      const step = getStepSize();
      
      // GSAP Animation: Move Left
      gsap.to(carousel, {
        x: -step,
        duration: 0.5,
        ease: "power2.inOut",
        force3D: true, // Force GPU acceleration
        onComplete: () => {
          // Logical DOM Move
          carousel.appendChild(carousel.firstElementChild!);
          
          // Instant Reset
          gsap.set(carousel, { x: 0 });
          isAnimating = false;
        }
      });
    };

    const movePrev = () => {
      if (isAnimating) return;
      isAnimating = true;

      const step = getStepSize();

      // 1. Instant: Move Last Item -> Start, Shift Track Left (to hide it)
      carousel.prepend(carousel.lastElementChild!);
      gsap.set(carousel, { x: -step });

      // 2. GSAP Animation: Move Right (to 0)
      gsap.to(carousel, {
        x: 0,
        duration: 0.5,
        ease: "power2.inOut",
        force3D: true, // Force GPU acceleration
        onComplete: () => {
          isAnimating = false;
        }
      });
    };

    const prevBtns = document.querySelectorAll(".services-prev-btn");
    const nextBtns = document.querySelectorAll(".services-next-btn");

    prevBtns.forEach(btn => {
        btn.addEventListener("click", (e) => {
            e.preventDefault();
            movePrev();
        });
    });

    nextBtns.forEach(btn => {
        btn.addEventListener("click", (e) => {
            e.preventDefault();
            moveNext();
        });
    });

    // --- TOUCH SWIPE SUPPORT ---
    let touchStartX = 0;
    let touchEndX = 0;
    const minSwipeDistance = 50;

    carousel.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
    }, { passive: true });

    const handleSwipe = () => {
        const distance = touchStartX - touchEndX;
        
        if (Math.abs(distance) > minSwipeDistance) {
            if (distance > 0) {
                // Swiped Left -> Next
                moveNext();
            } else {
                // Swiped Right -> Prev
                movePrev();
            }
        }
    };
  }

  // Run on load and Astro transitions
  if (document.readyState !== "loading") initServicesCarousel();
  else document.addEventListener("DOMContentLoaded", initServicesCarousel);

  document.addEventListener("astro:page-load", initServicesCarousel);
</script>
