---
import BubbleButton from "./ui/BubbleButton.astro";

const links = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Services", href: "/services" },
  { name: "Portfolio", href: "/portfolio" },
];
---

<nav
  id="nav-wrapper"
  class="fixed top-[calc(3rem+env(safe-area-inset-top))] left-1/2 -translate-x-1/2 z-50 w-full max-w-[calc(100%-2rem)] md:max-w-[24rem] mx-auto px-4 transition-all duration-500"
>
  <div
    id="navbar-container"
    class="bg-transparent backdrop-blur-xl shadow-lg rounded-2xl px-4 md:px-8 py-3 flex items-center gap-8 transition-colors transition-shadow duration-300 hover:shadow-xl w-full justify-between opacity-0 scale-0 origin-center nav-dark relative"
  >
    <!-- Logo (Hidden initially, revealed on scroll) -->
    <div
      id="nav-logo-wrapper"
      class="opacity-0 scale-0 flex justify-center md:justify-start origin-center md:origin-left absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 md:static md:translate-x-0 md:translate-y-0 md:w-auto w-auto"
    >
      <a
        id="nav-logo"
        href="/"
        class="nav-text font-serif text-xl font-bold tracking-tight whitespace-nowrap"
      >
        JL CUSTOM DESIGN
      </a>
    </div>

    <!-- Links (Centered Absolutely) -->
    <ul
      class="hidden md:flex gap-6 items-center absolute left-1/2 -translate-x-1/2"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-text text-xs font-semibold uppercase tracking-widest hover:text-accent transition-colors duration-300 relative group"
            >
              {link.name}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full" />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTA (Hidden initially, revealed on scroll) -->
    <div
      id="nav-contact"
      class="hidden md:flex opacity-0 scale-0 w-0 justify-end origin-right"
    >
      <BubbleButton
        href="/contact"
        class="hidden md:inline-flex whitespace-nowrap !px-6 !py-2.5"
      >
        Contact
      </BubbleButton>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="open-mobile-menu"
      class="nav-text md:hidden transition-colors duration-300 ml-auto"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</nav>

<style>
  /* Theme Logic */

  /* Dark Navbar (for Dark Backgrounds/Hero) -> White Text */
  :global(.nav-dark) .nav-text {
    color: white !important;
  }

  /* Light Navbar (for Light Backgrounds) -> Black Text */
  :global(.nav-light) .nav-text {
    color: #1a1a1a;
  }

  /* Hover effects */
  :global(.nav-dark) .nav-text:hover {
    color: #d4af37; /* Accent */
  }
  :global(.nav-light) .nav-text:hover {
    color: #d4af37; /* Accent */
  }

  /* Active Scroll Shrink */
  #navbar-container {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #navbar-container.nav-shrunk {
    padding-top: 0.5rem !important;
    padding-bottom: 0.5rem !important;
    transform: scale(
      0.95
    ) !important; /* Override GSAP inline if needed, creates simple shrink */
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    initNavbarAnim();
    initHeroObserver();
    initScrollResize();
  });

  // Initial run
  initNavbarAnim();
  initHeroObserver();
  initScrollResize();

  function initScrollResize() {
    const navContainer = document.querySelector("#navbar-container");
    let scrollTimeout: any;

    if (!navContainer) return;

    window.addEventListener(
      "scroll",
      () => {
        // While scrolling, shrink
        navContainer.classList.add("nav-shrunk");

        // Clear existing timeout
        clearTimeout(scrollTimeout);

        // Set timeout to restore size when scroll stops
        scrollTimeout = setTimeout(() => {
          navContainer.classList.remove("nav-shrunk");
        }, 150); // 150ms delay after stop
      },
      { passive: true },
    );
  }

  function initNavbarAnim() {
    const navContainer = document.querySelector("#navbar-container");
    const navWrapper = document.querySelector("nav");

    if (navContainer && navWrapper) {
      // 1. Initial Load Animation
      const hero = document.querySelector(
        "#hero-section, #services-hero-section, #portfolio-hero-section",
      );
      const isDesktop = window.innerWidth >= 1024;

      // Force expanded state on non-home pages OR on mobile/tablet (if we want it expanded there)
      // Actually, user said: "on the rest of the website, like the other pages, use the exact same mode as the fully extended navbar"
      // And "in the mobile mode remove the effect, keep it desktop only"

      const shouldBeExpanded = !hero || !isDesktop;

      if (shouldBeExpanded) {
        // Desktop Secondary Pages: Compact "Pill" Layout (Centered)
        // Set maxWidth to fit content so elements are close together
        gsap.set(navWrapper, { maxWidth: "56rem" });

        // Match Homepage "Pop" Animation but for Expanded State
        // 1. Fade In
        gsap.to(navContainer, {
          opacity: 1,
          duration: 0.05,
          delay: 0.2, // Match home delay
        });

        // 2. Standard Pop (One Bounce)
        gsap.set(navContainer, { css: { transition: "none" } });
        gsap.to(navContainer, {
          scale: 1,
          duration: 1.0,
          ease: "back.out(1.7)", // Standard bounce
          delay: 0.2,
          force3D: true,
          onComplete: () => {
            // Restore CSS transitions for smooth scroll shrinking
            gsap.set(navContainer, { clearProps: "transition" });
          },
        });

        // Ensure side elements are visible and naturally sized
        const navLogoWrapper = document.querySelector("#nav-logo-wrapper");
        const navContact = document.querySelector("#nav-contact");
        if (navLogoWrapper)
          gsap.set(navLogoWrapper, {
            opacity: 1,
            scale: 1,
            width: isDesktop ? "120px" : "auto",
          });
        if (navContact)
          gsap.set(navContact, {
            opacity: 1,
            scale: 1,
            width: isDesktop ? "120px" : "auto",
          });
      } else {
        // Home Page
        if (window.innerWidth < 1024) {
          // On mobile, show logo immediately (there's no top-left hero cutout)
          const navLogoWrapper = document.querySelector("#nav-logo-wrapper");
          if (navLogoWrapper) {
            gsap.set(navLogoWrapper, { opacity: 1, scale: 1, width: "auto" });
          }
        } else {
          // Home Desktop: Start collapsed (Hero handles reveal on scroll or load)
          // Keeping it opacity-0 scale-0 initially.
        }
      }
    }
  }

  function initHeroObserver() {
    const navContainer = document.querySelector("#navbar-container");
    const hero = document.querySelector(
      "#hero-section, #services-hero-section, #portfolio-hero-section",
    );

    if (!navContainer) return;

    // Check if Hero Exists
    if (hero) {
      // Check for explicit theme override
      const isLightTheme = hero.getAttribute("data-theme") === "light";

      if (isLightTheme) {
        navContainer.classList.add("nav-light");
        navContainer.classList.remove("nav-dark");
      } else {
        // Default to Dark Theme (White Text)
        navContainer.classList.add("nav-dark");
        navContainer.classList.remove("nav-light");
      }

      // Initialize scroll-reveal for nav elements
      initScrollRevealNav(hero);
    } else {
      // Scenario B: No Hero (Subpages) -> Default to Light Theme (Black Text)
      navContainer.classList.add("nav-light");
      navContainer.classList.remove("nav-dark");

      // On subpages, show logo/contact immediately
      const navLogo = document.querySelector("#nav-logo");
      const navContact = document.querySelector("#nav-contact");
      if (navLogo) gsap.set(navLogo, { opacity: 1, scale: 1 });
      if (navContact) gsap.set(navContact, { opacity: 1, scale: 1 });
      return; // Stop here, no ScrollTrigger needed
    }

    // Scenario B: Hero Exists -> Use ScrollTrigger to toggle theme
    const isLightTheme = hero.getAttribute("data-theme") === "light";
    const activeThemeClass = isLightTheme ? "nav-light" : "nav-dark";
    const inactiveThemeClass = isLightTheme ? "nav-dark" : "nav-light";

    ScrollTrigger.create({
      trigger: hero,
      start: "top top", // When hero starts
      end: "bottom top+=80", // When hero bottom passes top (plus buffer for nav height)
      onEnter: () => {
        // Enters Hero -> Active Theme
        navContainer.classList.add(activeThemeClass);
        navContainer.classList.remove(inactiveThemeClass);
      },
      onLeave: () => {
        // Leaves Hero (scrolling down) -> Always Light Theme (Default for content)
        navContainer.classList.add("nav-light");
        navContainer.classList.remove("nav-dark");
      },
      onEnterBack: () => {
        // Re-enters Hero (scrolling up) -> Active Theme
        navContainer.classList.add(activeThemeClass);
        navContainer.classList.remove(inactiveThemeClass);
      },
      onLeaveBack: () => {
        // Leaves Hero (scrolling up past top) -> Keep Active Theme (overscroll)
        navContainer.classList.add(activeThemeClass);
        navContainer.classList.remove(inactiveThemeClass);
      },
    });
  }

  function initScrollRevealNav(hero: Element) {
    const navLogoWrapper = document.querySelector("#nav-logo-wrapper");
    const navContact = document.querySelector("#nav-contact");
    const navWrapper = document.querySelector("#nav-wrapper");
    const navLogo = document.querySelector("#nav-logo"); // Inner logo scale only? No, animate wrapper scale.

    // Desktop ONLY check
    if (window.innerWidth < 1024) return;

    if (!navLogoWrapper || !navContact || !navWrapper) return;

    // ScrollTrigger to reveal/hide nav elements based on hero position
    ScrollTrigger.create({
      trigger: hero,
      start: "top top",
      end: "bottom top+=80",
      onLeave: () => {
        // Scrolled past Hero -> Expand navbar FIRST, then reveal elements
        const tl = gsap.timeline();

        // Step 1: Expand navbar width FULLY
        // Hint browser
        gsap.set(navWrapper, { willChange: "max-width" });
        gsap.set([navLogoWrapper, navContact], {
          willChange: "width, opacity, transform",
        });

        tl.to(navWrapper, {
          maxWidth: "56rem", // Increased from 42rem for "JL CUSTOM DESIGN"
          duration: 0.35,
          ease: "power2.out",
        });

        // Step 2: Animate WIDTH of wrappers symmetrically to 140px
        tl.to(
          [navLogoWrapper, navContact],
          {
            width: "120px",
            duration: 0.3,
            ease: "power2.out",
          },
          "+=0.05",
        );

        // Step 3: Animate SCALE & OPACITY with bounce
        tl.to(
          [navLogoWrapper, navContact],
          {
            opacity: 1,
            scale: 1,
            duration: 0.4,
            ease: "back.out(1.5)",
          },
          "<+=0.1",
        );
      },
      onEnterBack: () => {
        // Scrolled back into Hero -> Hide elements then shrink navbar
        const tl = gsap.timeline();

        // Step 1: Shrink both elements AT THE SAME TIME
        tl.to([navLogoWrapper, navContact], {
          opacity: 0,
          scale: 0,
          duration: 0.3,
          ease: "power2.inOut",
        });

        // Step 2: Shrink widths to 0
        tl.to(
          [navLogoWrapper, navContact],
          {
            width: 0,
            duration: 0.3,
            ease: "power2.inOut",
          },
          "<+=0.1",
        );

        // Step 3: Shrink navbar
        tl.to(
          navWrapper,
          {
            maxWidth: "24rem",
            duration: 0.35,
            ease: "power2.inOut",
          },
          "-=0.15",
        );
      },
    });
  }
</script>
