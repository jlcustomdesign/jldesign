---
import { getCollection } from 'astro:content';
import { PORTFOLIO_PAGE } from '../config/content';
import { preferWebp } from '../utils/prefer-webp';
import sharp from 'sharp';
import path from 'path';

// Fetch items from Keystatic CMS
const [portfolioEntries, categoryEntries] = await Promise.all([
  getCollection('portfolio'),
  getCollection('categories'),
]);

// Map categories for easy lookup
const categoryMap = Object.fromEntries(categoryEntries.map(cat => [cat.slug, cat.data.name]));

// Process projects with aspect ratio detection
const allProjects = await Promise.all(portfolioEntries.map(async (entry) => {
  const imagePath = preferWebp(entry.data.image);
  let isLandscape = false;

  try {
    if (imagePath) {
      const absolutePath = path.join(process.cwd(), 'public', imagePath);
      const fs = await import('node:fs/promises');
      const fileExists = await fs.access(absolutePath).then(() => true).catch(() => false);
      if (fileExists) {
        const metadata = await sharp(absolutePath).metadata();
        if (metadata.width && metadata.height) {
          isLandscape = metadata.width > metadata.height;
        }
      }
    }
  } catch (e) {
    console.error(`Could not read metadata for ${imagePath}:`, e);
  }

  return {
    ...entry.data,
    image: imagePath,
    isLandscape,
    categoryName: categoryMap[entry.data.category] || entry.data.category || 'Altele',
  };
}));

// Define Category Order (by slugs)
const CATEGORY_ORDER = ['living', 'dormitor', 'bucatarii', 'bai', 'birou', 'horeca', 'hol'];

// Group Projects
type Project = typeof allProjects[0];
const groupedProjects: Record<string, Project[]> = {};

// Initialize groups from available categories
categoryEntries.forEach(cat => groupedProjects[cat.slug] = []);
if (!groupedProjects['Altele']) groupedProjects['Altele'] = [];

// Distribute
allProjects.forEach(project => {
    let catSlug = project.category || 'Altele';
    if (!groupedProjects[catSlug]) groupedProjects[catSlug] = []; // Support new dynamic categories
    groupedProjects[catSlug].push(project);
});

// Sort categories: defined order first, then others alphabetically
const activeCategories = Object.keys(groupedProjects)
    .filter(slug => groupedProjects[slug].length > 0)
    .sort((a, b) => {
        const indexA = CATEGORY_ORDER.indexOf(a);
        const indexB = CATEGORY_ORDER.indexOf(b);
        if (indexA !== -1 && indexB !== -1) return indexA - indexB;
        if (indexA !== -1) return -1;
        if (indexB !== -1) return 1;
        return a.localeCompare(b);
    });
---

<section class="bg-secondary relative w-full py-20 px-4 md:px-8" id="portfolio-cms-section">
  <div class="container mx-auto">
    
    {activeCategories.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-xl text-gray-500">{PORTFOLIO_PAGE.emptyState}</p>
        <p class="text-sm text-gray-400 mt-2">{PORTFOLIO_PAGE.emptyStateAdmin}</p>
      </div>
    ) : (
      <div class="flex flex-col gap-24">
        {activeCategories.map((category) => {
            const items = groupedProjects[category];
            const hasMore = items.length > 3;
            const categoryName = categoryMap[category] || category;
            
            return (
                <div class="category-section" data-category={category}>
                     <div class="flex items-center gap-4 mb-12">
                        <div class="h-[2px] w-8 bg-accent"></div>
                        <h2 class="text-3xl md:text-4xl font-serif text-primary capitalize">
                            {categoryName}
                        </h2>
                     </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full grid-flow-dense" id={`grid-${category}`}>
                        {items.map((item, index) => (
                            <div 
                                class={`group relative w-full cursor-pointer project-card ${item.isLandscape ? 'md:col-span-2' : ''} ${index >= 3 ? 'hidden' : ''}`} 
                                data-index={index}
                            >
                                <!-- Image Wrapper -->
                                <div class={`relative w-full overflow-hidden rounded-[2rem] bg-gray-900 ${item.isLandscape ? 'aspect-[16/10] md:aspect-[16/9]' : 'aspect-[3/4] md:aspect-[4/5]'}`}>
                                    {item.image ? (
                                      <img
                                        src={item.image}
                                        alt={item.name}
                                        decoding="async"
                                        loading="lazy" 
                                        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                                      />
                                    ) : (
                                      <div class="w-full h-full bg-gray-800 flex items-center justify-center">
                                        <span class="text-white/30 text-sm uppercase tracking-widest">{PORTFOLIO_PAGE.emptyImage}</span>
                                      </div>
                                    )}
                                    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors duration-500"></div>
                                </div>

                                <!-- Info Below Image -->
                                <div class="mt-6 flex justify-between items-end opacity-80 group-hover:opacity-100 transition-opacity duration-500">
                                    <div>
                                        {item.name && (
                                          <h3 class="font-serif text-2xl text-primary leading-tight">
                                              {item.name}
                                          </h3>
                                        )}
                                    </div>
                                    
                                    <!-- Arrow Icon (Fixed) -->
                                    <div class="w-10 h-10 flex-shrink-0 rounded-full border border-white/20 flex items-center justify-center transform -rotate-45 group-hover:rotate-0 transition-transform duration-500 text-primary">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    {hasMore && (
                        <div class="mt-12 flex justify-center gap-4">
                            <button 
                                class="view-more-btn px-8 py-3 rounded-full border border-primary/20 text-primary hover:bg-primary hover:text-white transition-all duration-300 uppercase tracking-widest text-sm font-bold"
                                data-target-category={category}
                            >
                                {PORTFOLIO_PAGE.viewMore}
                            </button>
                             <button 
                                class="view-less-btn hidden px-8 py-3 rounded-full border border-primary/20 text-primary hover:bg-primary hover:text-white transition-all duration-300 uppercase tracking-widest text-sm font-bold"
                                data-target-category={category}
                            >
                                {PORTFOLIO_PAGE.viewLess}
                            </button>
                        </div>
                    )}
                </div>
            )
        })}
      </div>
    )}
  </div>

  <!-- Lightbox (Simplified) -->
  <div id="portfolio-lightbox" class="fixed inset-0 z-[9999] bg-black/95 opacity-0 pointer-events-none flex items-center justify-center p-4 transition-opacity duration-300">
    <button id="lightbox-close" class="absolute top-6 right-6 z-50 p-2 text-white/50 hover:text-white bg-black/20 rounded-full" aria-label={PORTFOLIO_PAGE.closeGallery}>
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300" />
  </div>
</section>

<!-- Module script for GSAP animations and lightbox only -->
<script>
  import { initTextAnimations } from "../utils/RevealAnimationHandler";
  import { PORTFOLIO_PAGE } from "../config/content";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  function initPortfolioAnimations() {
     const section = document.querySelector("#portfolio-cms-section");
     if(section) initTextAnimations(section as HTMLElement);
     
     // Lightbox Logic (Delegation)
     const lightbox = document.getElementById('portfolio-lightbox');
     const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
     const closeBtn = document.getElementById('lightbox-close');
     
     if(section && lightbox && lightboxImg) {
         section.addEventListener('click', (e) => {
             const target = e.target as HTMLElement;
             const card = target.closest('.project-card');
             if(card) {
                const img = card.querySelector('img');
                if(img) {
                    lightboxImg.src = img.src;
                     lightboxImg.alt = img.alt || PORTFOLIO_PAGE.defaultProjectAlt;
                    lightbox.classList.remove('opacity-0', 'pointer-events-none');
                    lightboxImg.classList.remove('scale-95');
                    lightboxImg.classList.add('scale-100');
                    document.body.style.overflow = 'hidden';
                }
             }
         });
         
         const close = () => {
             lightbox.classList.add('opacity-0', 'pointer-events-none');
             lightboxImg.classList.remove('scale-100');
             lightboxImg.classList.add('scale-95');
             document.body.style.overflow = '';
         };
         
         if(closeBtn) closeBtn.onclick = close;
         lightbox.onclick = (e) => { if(e.target === lightbox) close(); };
         document.onkeydown = (e) => { if(e.key === "Escape") close(); };
     }
  }

  document.addEventListener("astro:page-load", initPortfolioAnimations);
</script>

<!-- Inline script for View More / View Less - runs directly in browser, no bundling -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // Find all "View More" buttons
    var moreButtons = document.querySelectorAll('.view-more-btn');
    var lessButtons = document.querySelectorAll('.view-less-btn');
    
    moreButtons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        // Find parent category section
        var section = btn.closest('.category-section');
        if (!section) return;
        
        var grid = section.querySelector('.grid');
        if (!grid) return;
        
        var allCards = grid.querySelectorAll('.project-card');
        var currentVisible = parseInt(section.getAttribute('data-visible') || '3');
        var nextVisible = currentVisible + 6;
        var revealed = 0;
        
        for (var i = currentVisible; i < nextVisible && i < allCards.length; i++) {
          var card = allCards[i];
          card.classList.remove('hidden');
          card.style.display = '';
          card.style.opacity = '0';
          card.style.transform = 'translateY(20px)';
          
          // Animate in with a slight delay per card
          (function(el, delay) {
            setTimeout(function() {
              el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, delay);
          })(card, revealed * 100);
          
          revealed++;
        }
        
        section.setAttribute('data-visible', String(nextVisible));
        
        // If we've shown all items, swap buttons
        if (nextVisible >= allCards.length) {
          btn.classList.add('hidden');
          var lessBtn = section.querySelector('.view-less-btn');
          if (lessBtn) lessBtn.classList.remove('hidden');
        }
      });
    });
    
    lessButtons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        
        var section = btn.closest('.category-section');
        if (!section) return;
        
        var grid = section.querySelector('.grid');
        if (!grid) return;
        
        var allCards = grid.querySelectorAll('.project-card');
        
        for (var i = 3; i < allCards.length; i++) {
          allCards[i].classList.add('hidden');
          allCards[i].style.display = '';
          allCards[i].style.opacity = '';
          allCards[i].style.transform = '';
          allCards[i].style.transition = '';
        }
        
        section.setAttribute('data-visible', '3');
        
        // Scroll back to section
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        
        // Swap buttons
        btn.classList.add('hidden');
        var moreBtn = section.querySelector('.view-more-btn');
        if (moreBtn) moreBtn.classList.remove('hidden');
      });
    });
  });
</script>

