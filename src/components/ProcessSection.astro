---
import BubbleButton from "./ui/BubbleButton.astro";

const steps = [
  {
    step: "01",
    title: "Consultanță",
    desc: "Discutăm viziunea ta. Luăm măsurători precise și înțelegem fluxul spațiului. Este momentul în care ideile prind contur.",
    color: "bg-white",
    img: "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?q=80&w=1200",
  },
  {
    step: "02",
    title: "Proiectare 3D",
    desc: "Randări fotorealiste. Vezi exact cum va arăta mobilierul în casa ta înainte de a tăia prima placă. Ajustăm până la perfecțiune.",
    color: "bg-white",
    img: "https://images.unsplash.com/photo-1507089947368-19c1da9775ae?q=80&w=1200",
  },
  {
    step: "03",
    title: "Producție",
    desc: "Artizanat și tehnologie. Folosim utilaje CNC de ultimă generație și finisaje manuale pentru detalii impecabile.",
    color: "bg-white",
    img: "https://images.unsplash.com/photo-1620613907042-32a2eb6be638?q=80&w=1200",
  },
  {
    step: "04",
    title: "Montaj",
    desc: "Curățenie și precizie. Echipa noastră instalează totul, reglează feroneria și se asigură că totul funcționează 'soft-close'.",
    color: "bg-white",
    img: "https://images.unsplash.com/photo-1584622050111-993a426fbf0a?q=80&w=1200",
  },
];
---

<section
  id="process-section"
  class="bg-secondary relative py-24 overflow-hidden"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 mb-12">
    <h2 class="font-serif font-bold text-4xl md:text-5xl text-primary mb-6">
      Procesul Nostru
    </h2>
    <p class="text-gray-400 max-w-2xl">
        De la schiță la realitate în patru pași simpli.
    </p>
  </div>

  <!-- Cards Container 
       Mobile: Vertical Stack (Flex Col), No Pin
       Desktop: h-[55vh], pinned (GSAP), Absolute Stack
  -->
  <div class="relative w-full max-w-7xl mx-auto h-auto md:h-[55vh] flex flex-col gap-8 md:block md:gap-0" id="cards-wrapper">
    {
      steps.map((step, index) => (
        <div
          class={`process-card relative md:absolute top-0 left-0 w-full md:h-full min-h-[50vh] md:min-h-0 rounded-[2.5rem] shadow-xl origin-top overflow-hidden will-change-transform ${step.color}`}
          style={`z-index: ${index + 1}; --desktop-top: ${100 + index * 40}px;`}
        >
          <div class="flex flex-col md:flex-row h-full">
            <!-- Content -->
            <div class="flex-1 p-8 md:p-12 flex flex-col justify-between relative z-10">
                <div class="text-6xl md:text-8xl font-serif text-primary/10 font-bold leading-none select-none mb-8 md:mb-0">
                  {step.step}
                </div>
                <div>
                   <h3 
                     class="font-serif font-bold text-3xl md:text-5xl text-primary mb-6"
                     data-reveal="slide" 
                     data-reveal-blur
                   >
                        {step.title}
                   </h3>
                   <p 
                     class="text-gray-500 leading-relaxed text-lg md:text-xl max-w-md"
                     data-reveal="slide" 
                     data-reveal-blur
                     data-reveal-delay="0.2"
                   >
                        {step.desc}
                   </p>
                </div>

                <!-- Mobile Image (Bottom of Card) -->
                <div class="md:hidden w-full aspect-[4/3] rounded-2xl overflow-hidden mt-8">
                    <img 
                      src={step.img} 
                      alt={step.title} 
                      class="w-full h-full object-cover" 
                      loading="lazy"
                    />
                </div>
            </div>

            <!-- Desktop Image Frame (Vertical 3:4) -->
            <div class="hidden md:block h-full aspect-[3/4] p-4">
                <div class="w-full h-full rounded-[2rem] overflow-hidden relative">
                    <img src={step.img} alt={step.title} class="w-full h-full object-cover" />
                </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  
  <!-- CTA Button -->
  <div class="container mx-auto px-4 md:px-8 mt-16 md:mt-36 mb-16 flex justify-center relative z-20 md:opacity-0 md:translate-y-12" id="process-cta">
    <BubbleButton href="/contact" variant="outline" class="!px-12 !py-5 text-lg shadow-2xl !border-white !text-white">
      Discută Proiectul Tău
    </BubbleButton>
  </div>
  
  <style>
    /* Override Button Styles for Process Section (White Blob, Black Text) */
    #process-cta :global(.work-btn:hover),
    #process-cta :global(.work-btn:hover span),
    #process-cta :global(.work-btn:hover *) {
      color: black !important;
    }
    #process-cta :global(.work-blob-trick) {
      background-color: white !important;
      border-color: white !important;
    }
    
    /* Desktop-only positioning logic to avoid inline style interference on mobile */
    @media (min-width: 768px) {
        .process-card {
            top: var(--desktop-top);
        }
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import "../utils/RevealAnimationHandler"; // Import the handler for mobile reveal

    gsap.registerPlugin(ScrollTrigger);

    initProcessStack();
    document.addEventListener("astro:page-load", initProcessStack);

    function initProcessStack() {
      // Helper: Split text into words (Defined outside to be available if needed, 
      // though we only use it in desktop logic currently)
      const splitTextToWords = (element: Element | null) => {
          if (!element) return;
          const text = element.textContent?.trim() || "";
          element.innerHTML = text
            .split(" ")
            .map(
              (word) =>
                `<span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform" style="filter: blur(8px)">${word}&nbsp;</span></span>`
            )
            .join("");
      };

      const mm = gsap.matchMedia();

      // --- DESKTOP LOGIC (>= 1024px) ---
      mm.add("(min-width: 1024px)", () => {
          const headerH2 = document.querySelector("#process-section .container > h2");
          const headerP = document.querySelector("#process-section .container > p");
          const wrapper = document.querySelector("#cards-wrapper");
          const cards = gsap.utils.toArray(".process-card") as HTMLElement[];
          
          if (!wrapper || cards.length === 0) return;

          // Prepare Texts (Custom Desktop Split)
          splitTextToWords(headerH2);
          splitTextToWords(headerP);
          cards.forEach(card => {
              const title = card.querySelector("h3");
              const desc = card.querySelector("p");
              // Only split if not already split (avoid double split on resize if context doesn't fully clear DOM)
              // Actually matchMedia reverts animations but doesn't necessarily revert DOM changes unless we tell it.
              // For simplicity, we'll strip markers or just check.
              if(title && !title.querySelector(".split-word")) splitTextToWords(title);
              if(desc && !desc.querySelector(".split-word")) splitTextToWords(desc);
          });

          // --- 1. Header & First Card Reveal (Time-Based) ---
          const tlHeader = gsap.timeline({
              scrollTrigger: {
                  trigger: "#process-section",
                  start: "top 75%",
                  toggleActions: "play none none reverse"
              }
          });

          // Header Text
          if(headerH2) {
              const spans = headerH2.querySelectorAll("span span");
              if(spans.length) tlHeader.to(spans, { y: 0, opacity: 1, filter: "blur(0px)", duration: 1, stagger: 0.1, ease: "power3.out" });
          }
          if(headerP) {
               const spans = headerP.querySelectorAll("span span");
               if(spans.length) tlHeader.to(spans, { y: 0, opacity: 1, filter: "blur(0px)", duration: 1, stagger: 0.05, ease: "power3.out" }, "-=0.8");
          }
          
          // Card 0 Text (Immediate)
          const card0 = cards[0];
          if(card0) {
               const c0Texts = card0.querySelectorAll("h3 span span, p span span");
               if(c0Texts.length) {
                   tlHeader.to(c0Texts, { y: 0, opacity: 1, filter: "blur(0px)", duration: 1, stagger: 0.05, ease: "power3.out" }, "-=0.8"); 
              }
          }

          // --- 2. Card Stacking (Scrubbed Move, Time-Based Text Reveal) ---
          gsap.set(cards, { clearProps: "all" }); // Reset props before starting
          
          const tlStack = gsap.timeline({
            scrollTrigger: {
                trigger: "#process-section",
                start: "top top", 
                end: `+=${cards.length * 100}%`, 
                pin: true,
                scrub: 1,
                anticipatePin: 1
            }
          });

          cards.forEach((card, i) => {
            if (i === 0) return; 
            
            gsap.set(card, { y: window.innerHeight * 1.1 });

            // Helper to animate text independently
            const animateText = (forward: boolean) => {
                 const spans = card.querySelectorAll("h3 span span, p span span");
                 if(!spans.length) return;
                 
                 if(forward) {
                     gsap.to(spans, { y: 0, opacity: 1, filter: "blur(0px)", duration: 0.8, stagger: 0.05, ease: "power3.out", overwrite: true });
                 } else {
                     gsap.to(spans, { y: "100%", opacity: 0, filter: "blur(8px)", duration: 0.5, overwrite: true });
                 }
            };

            const startTime = i - 0.5;

            // Stack Animation
            tlStack.to(card, {
                y: i * 25, 
                duration: 1,
                ease: "none"
            }, startTime); 

            // Text Trigger
            tlStack.call(() => {
                 const dir = tlStack.scrollTrigger?.direction || 1;
                 animateText(dir > 0);
            }, [], startTime + 0.6);
          });

          // Animate CTA Button
          gsap.to("#process-cta", {
            scrollTrigger: {
              trigger: "#process-cta",
              start: "top 85%", // Reveal when it comes into view
              toggleActions: "play none none reverse",
            },
            y: 0,
            opacity: 1,
            duration: 1,
            ease: "power2.out",
          });
      });
      
      // --- MOBILE LOGIC (< 1024px) ---
      mm.add("(max-width: 1023px)", () => {
           // RevealHandler handles animations. 
           // We just ensure no pinning interferes.
           // matchMedia automatically reverts the desktop pin.
      });
    }
  </script>
</section>
