---
import { getCollection } from "astro:content";
import BubbleButton from "./ui/BubbleButton.astro";
import { BLOG_PREVIEW } from "../config/content";
import { preferWebp } from "../utils/prefer-webp";

const posts = await getCollection("blog");

// Sort by publishedDate descending and take top 3
const latestPosts = posts
  .sort((a, b) => {
    const dateA = new Date(a.data.publishedDate).getTime();
    const dateB = new Date(b.data.publishedDate).getTime();
    return dateB - dateA;
  })
  .slice(0, 3)
  .map((post) => ({
    ...post,
    data: {
      ...post.data,
      coverImage: preferWebp(post.data.coverImage),
    },
  }));

const categoryLabels = BLOG_PREVIEW.categoryLabels;
---

{
  latestPosts.length > 0 && (
    <section
      class="py-24 px-4 md:px-8 bg-secondary relative overflow-hidden"
      id="blog-preview"
    >
      <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12">
          <div>
            <h2
              class="font-serif text-4xl md:text-5xl text-primary leading-tight mb-4"
              set:html={BLOG_PREVIEW.title}
            />
            <p class="text-primary/60 max-w-xl text-lg">
              {BLOG_PREVIEW.subtitle}
            </p>
          </div>
          <BubbleButton
            href="/blog"
            variant="outline"
            class="hidden md:inline-flex"
          >
            {BLOG_PREVIEW.ctaButton}
          </BubbleButton>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="blog-preview-card flex flex-col bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-2xl hover:shadow-black/5 transition-all duration-500 hover:-translate-y-2 group"
            >
              <div class="aspect-[16/10] overflow-hidden relative">
                <img
                  src={post.data.coverImage}
                  alt={post.data.coverImageAlt}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500" />
              </div>
              <div class="p-8 flex flex-col flex-grow">
                <div class="flex items-center gap-3 mb-4">
                  <span
                    class:list={[
                      "text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full transition-colors duration-500",
                      post.data.category === "ghid"
                        ? "bg-accent text-primary"
                        : "bg-secondary text-accent",
                    ]}
                  >
                    {categoryLabels[post.data.category] || post.data.category}
                  </span>
                  <span class="text-[10px] text-primary/60 font-bold uppercase tracking-widest">
                    {new Date(post.data.publishedDate).toLocaleDateString(
                      "ro-RO",
                      {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      },
                    )}
                  </span>
                </div>
                <h3 class="font-serif text-2xl text-primary leading-snug mb-3 group-hover:text-accent transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-sm text-primary/60 line-clamp-3 leading-relaxed mt-auto">
                  {post.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>

        <div class="md:hidden flex justify-center mt-8">
          <BubbleButton href="/blog" variant="outline">
            {BLOG_PREVIEW.ctaButton}
          </BubbleButton>
        </div>
      </div>
    </section>
  )
}
