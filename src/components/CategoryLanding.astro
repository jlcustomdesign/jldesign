---
import type { CategoryPage } from "../config/categories";
import { SITE } from "../config/site";

interface Props {
  cat: CategoryPage;
}

const { cat } = Astro.props;

// Structured data: Service offered by the local business (LocalBusiness /
// Organization / WebSite schemas are emitted globally by Layout).
const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": cat.serviceName,
  "serviceType": "Mobilier la comandă",
  "description": cat.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": SITE.name,
    "url": SITE.url,
    "telephone": SITE.phone,
  },
  "areaServed": SITE.targetCities.map((city) => ({
    "@type": "City",
    "name": city,
  })),
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": cat.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a,
    },
  })),
});
---

<script type="application/ld+json" set:html={serviceSchema}></script>
<script type="application/ld+json" set:html={faqSchema}></script>

<main class="bg-secondary" data-theme="light">
  <!-- Hero -->
  <section class="pt-40 pb-16 md:pt-48 md:pb-24 px-4 md:px-8">
    <div class="container mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <span class="block text-accent uppercase tracking-[0.2em] text-sm font-bold mb-6">
          {SITE.name} — Brașov
        </span>
        <h1 class="font-serif text-4xl md:text-6xl text-primary leading-tight mb-8">
          {cat.h1}
        </h1>
        <p class="text-lg md:text-xl text-primary/70 leading-relaxed mb-10">
          {cat.lead}
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-block bg-primary text-white px-8 py-4 rounded-full font-medium hover:bg-accent transition-colors duration-300"
          >
            Cere o ofertă
          </a>
          <a
            href="/portfolio"
            class="inline-block border border-primary text-primary px-8 py-4 rounded-full font-medium hover:bg-primary hover:text-white transition-colors duration-300"
          >
            Vezi proiecte
          </a>
        </div>
      </div>
      <div class="rounded-3xl overflow-hidden aspect-[4/3] bg-gray-200">
        <img
          src={cat.image}
          alt={cat.imageAlt}
          loading="eager"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Intro text -->
  <section class="pb-16 md:pb-24 px-4 md:px-8">
    <div class="container mx-auto max-w-4xl space-y-6">
      {cat.paragraphs.map((p) => (
        <p class="text-base md:text-lg text-primary/80 leading-relaxed">{p}</p>
      ))}
    </div>
  </section>

  <!-- Highlights -->
  <section class="pb-16 md:pb-24 px-4 md:px-8">
    <div class="container mx-auto">
      <h2 class="font-serif text-3xl md:text-4xl text-primary mb-10">
        Ce include fiecare proiect
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cat.highlights.map((h, i) => (
          <div class="p-8 bg-white rounded-3xl border border-primary/5">
            <span class="block font-serif text-accent text-2xl mb-4">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="font-serif text-xl text-primary mb-2">{h.title}</h3>
            <p class="text-primary/70 leading-relaxed">{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Materials -->
  <section class="pb-16 md:pb-24 px-4 md:px-8">
    <div class="container mx-auto max-w-4xl">
      <h2 class="font-serif text-3xl md:text-4xl text-primary mb-8">
        Materiale și feronerie
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
        {cat.materials.map((m) => (
          <li class="flex items-start gap-3 text-primary/80">
            <span class="mt-2 w-2 h-2 rounded-full bg-accent shrink-0"></span>
            <span>{m}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ (native <details> — no JS, fully crawlable) -->
  <section class="pb-16 md:pb-24 px-4 md:px-8">
    <div class="container mx-auto max-w-4xl">
      <h2 class="font-serif text-3xl md:text-4xl text-primary mb-8">
        Întrebări frecvente
      </h2>
      <div class="space-y-4">
        {cat.faqs.map((faq) => (
          <details class="group bg-white rounded-2xl border border-primary/5 p-6">
            <summary class="cursor-pointer list-none flex justify-between items-center gap-4 font-medium text-xl text-primary">
              {faq.q}
              <span class="text-accent text-2xl leading-none transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-primary/70 leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="pb-24 px-4 md:px-8">
    <div class="container mx-auto max-w-4xl bg-[#1a1a1a] rounded-3xl p-10 md:p-16 text-center">
      <h2 class="font-serif text-3xl md:text-4xl text-white mb-6">
        Hai să discutăm despre proiectul tău
      </h2>
      <p class="text-white/70 text-lg mb-10 max-w-2xl mx-auto">
        Consultanță și măsurători la fața locului în Brașov și împrejurimi,
        urmate de proiectare 3D și o ofertă personalizată.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="inline-block bg-accent text-primary px-8 py-4 rounded-full font-medium hover:bg-white transition-colors duration-300"
        >
          Programează o consultanță
        </a>
        <a
          href={`tel:${SITE.phone}`}
          class="inline-block border border-white/40 text-white px-8 py-4 rounded-full font-medium hover:bg-white hover:text-primary transition-colors duration-300"
        >
          Sună: {SITE.phone.replace("+40", "+40 ")}
        </a>
      </div>
    </div>
  </section>
</main>
