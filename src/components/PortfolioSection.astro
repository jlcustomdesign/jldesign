---
const portfolio = [
  {
    name: "Apartament Băneasa",
    material: "Nuc American",
    img: "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Villa Pipera",
    material: "Stejar Masiv",
    img: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Penthouse Herăstrău",
    material: "MDF Vopsit & Marmură",
    img: "https://images.unsplash.com/photo-1600566752355-35792bedcfe1?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Loft Timpuri Noi",
    material: "Metal & Lemn Recuperat",
    img: "https://images.unsplash.com/photo-1507089947368-19c1da9775ae?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Cluj Residence",
    material: "Furnir Eucalipt",
    img: "https://images.unsplash.com/photo-1615529182904-14819c35db37?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Office Space Unirii",
    material: "Sticlă & Oțel",
    img: "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Duplex Primăverii",
    material: "Marmură Carrara",
    img: "https://images.unsplash.com/photo-1600607687644-c7171b42498f?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Showroom Victoriei",
    material: "Compozit & Velvet",
    img: "https://images.unsplash.com/photo-1628744448840-55bdb2497bd4?q=80&w=1600&auto=format&fit=crop",
  },
];

// Helper to chunk text
type PortfolioItem = typeof portfolio[0];
const columns: PortfolioItem[][] = [[], [], [], []];
portfolio.forEach((item, i) => {
  columns[i % 4].push(item);
});
---

<section
  class="bg-secondary relative"
  id="portfolio-section"
  data-theme="light"
>
  <div class="w-full relative min-h-screen py-32 px-4">
    <div class="container mx-auto mb-20 md:mb-32 px-4 md:px-0">
      <!-- Title Left Aligned -->
      <h2 class="font-serif text-4xl md:text-6xl text-primary text-left">
        Portofoliu Selectiv
      </h2>
    </div>

    <!-- 
      Grid Layout Updates:
      - Mobile: 2 columns (grid-cols-2)
      - Tablet: 3 columns (md:grid-cols-3)
      - Desktop: 4 columns (lg:grid-cols-4)
      - Gap: gap-4
    -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 w-full max-w-[1800px] mx-auto" id="portfolio-grid">
      {
        columns.map((col, colIndex) => (
          <div class="flex flex-col gap-4 portfolio-column" data-col-index={colIndex}>
            {col.map((item) => (
              <div class="group relative w-full overflow-hidden rounded-3xl">
                <!-- Image Container -->
                <div class="w-full aspect-[3/4] overflow-hidden relative bg-gray-200">
                  <img
                    src={item.img}
                    alt={item.name}
                    loading="lazy"
                    class="w-full h-[120%] object-cover absolute top-0 left-0 portfolio-img"
                    style="transform: translateY(-10%);" 
                  />
                  
                  <!-- Overlay: Visible on Hover -->
                  <!-- Overlay: Visible on Hover (Glassmorphism) -->
                  <div class="absolute inset-0 bg-black/30 backdrop-blur-sm border border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-500 z-10 flex flex-col justify-center items-center text-center p-6">
                    <h3 class="font-serif text-2xl text-accent translate-y-4 group-hover:translate-y-0 transition-transform duration-500 delay-100">
                      {item.name}
                    </h3>
                     <p class="text-sm font-medium text-gray-300 mt-1 uppercase tracking-wider translate-y-4 group-hover:translate-y-0 transition-transform duration-500 delay-200">
                      {item.material}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initPortfolioAnim() {
    const section = document.querySelector("#portfolio-section");
    if (!section) return;

    const cols = document.querySelectorAll(".portfolio-column");
    if (cols.length === 0) return;

    // Enabled on ALL devices now (Mobile/Tablet/Desktop)
    // We might want to reduce the distance on mobile if needed, but let's test strict logic first.

    let ctx = gsap.context(() => {
        // Performance configs
        gsap.config({ autoSleep: 60, force3D: true, nullTargetWarn: false });

        cols.forEach((col, i) => {
            const isOddVisual = (i + 1) % 2 !== 0; 
            
            // Movement: Total range 200px
            // Odd (Up): Start at +100 (Down), End at -100 (Up)
            // Even (Down): Start at -100 (Up), End at +100 (Down)
            // This creates a "crossing" effect where they shear past each other
            
            const range = 100;
            const startY = isOddVisual ? range : -range;
            const endY = isOddVisual ? -range : range;

            gsap.fromTo(col, 
                { y: startY },
                {
                    y: endY,
                    ease: "none",
                    scrollTrigger: {
                        trigger: section,
                        start: "top bottom", 
                        end: "bottom top",
                        scrub: true,
                    }
                }
            );
        });

        // Image Parallax (Subtle internal movement)
        const images = document.querySelectorAll(".portfolio-img");
        images.forEach((img) => {
             gsap.to(img, {
                 y: "10%",
                 ease: "none",
                 scrollTrigger: {
                     trigger: img.parentElement,
                     start: "top bottom",
                     end: "bottom top",
                     scrub: true
                 }
             });
        });

    }, section);

    return () => ctx.revert();
  }

  // Run on load and transitions
  if (document.readyState !== 'loading') initPortfolioAnim();
  else document.addEventListener('DOMContentLoaded', initPortfolioAnim);
  
  document.addEventListener("astro:page-load", initPortfolioAnim);
  document.addEventListener("astro:after-swap", initPortfolioAnim);
</script>
