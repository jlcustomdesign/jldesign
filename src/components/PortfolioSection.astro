---
const portfolio = [
  {
    name: "Apartament Băneasa",
    material: "Nuc American",
    img: "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Villa Pipera",
    material: "Stejar Masiv",
    img: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Penthouse Herăstrău",
    material: "MDF Vopsit & Marmură",
    img: "https://images.unsplash.com/photo-1600566752355-35792bedcfe1?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Loft Timpuri Noi",
    material: "Metal & Lemn Recuperat",
    img: "https://images.unsplash.com/photo-1507089947368-19c1da9775ae?q=80&w=1600&auto=format&fit=crop",
  },
  {
    name: "Cluj Residence",
    material: "Furnir Eucalipt",
    img: "https://images.unsplash.com/photo-1615529182904-14819c35db37?q=80&w=1600&auto=format&fit=crop",
  },
];
---

<section
  class="bg-secondary relative overflow-hidden"
  id="portfolio-section"
  data-theme="light"
>
  <!-- No height set on wrapper needed for pin:true, GSAP handles spacing. -->
  <div
    class="w-full relative min-h-screen flex flex-col justify-center pt-32 pb-12"
    id="portfolio-wrapper"
  >
    <div
      class="container mx-auto px-4 md:px-8 mb-8 md:mb-12 flex justify-between items-end"
    >
      <h2 class="font-serif text-4xl md:text-5xl text-primary">
        Portofoliu Selectiv
      </h2>
      <span class="text-gray-400 hidden md:inline-block"
        >← Scroll Horizontally →</span
      >
    </div>

    <!-- The Horizontal Track -->
    <!-- 
      Universal: overflow-hidden (GSAP Controlled on All Devices)
    -->
    <div class="w-full overflow-hidden">
      <div
        class="flex gap-4 md:gap-16 pl-4 md:pl-24 pr-24 will-change-transform transform-gpu"
        id="portfolio-gallery"
      >
        {
          portfolio.map((item, index) => (
            <div
              class="relative flex-none w-[85vw] md:w-[420px] xl:w-[550px] group portfolio-item snap-center"
              style="backface-visibility: hidden; -webkit-backface-visibility: hidden; transform: translateZ(0);"
            >
              <div class="w-full aspect-[3/2] rounded-2xl overflow-hidden relative">
                <img
                  src={item.img}
                  alt={item.name}
                  loading="lazy"
                  class="w-full h-full object-cover grayscale-[30%] md:group-hover:grayscale-0 md:transition-all md:duration-700 md:ease-out scale-100 md:group-hover:scale-105 portfolio-img"
                />
              </div>
              <div class="mt-6 flex justify-between items-start">
                <div>
                  <h3
                    class="font-serif text-2xl text-primary"
                    style="backface-visibility: hidden; -webkit-backface-visibility: hidden;"
                  >
                    {item.name}
                  </h3>
                  <p
                    class="text-sm font-medium text-accent mt-1 uppercase tracking-wider"
                    style="backface-visibility: hidden;"
                  >
                    {item.material}
                  </p>
                </div>
                <div class="w-10 h-10 border border-primary/20 rounded-full flex items-center justify-center opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="text-primary transform -rotate-45"
                  >
                    <path
                      d="M5 12h14M12 5l7 7-7 7"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  initPortfolioAnim();
  document.addEventListener("astro:page-load", initPortfolioAnim);

  function initPortfolioAnim() {
    // Only verify elements prompt existence
    const wrapper = document.querySelector("#portfolio-wrapper");
    const gallery = document.querySelector("#portfolio-gallery");

    if (!wrapper || !gallery) return;

    // Critical: Save CSS styles (native scroll) before GSAP touches them
    ScrollTrigger.saveStyles("#portfolio-gallery, #portfolio-wrapper");

    // Enable GSAP Horizontal Scroll for ALL devices
    // User explicitly requested "Scroll Lock/Pin" behavior on mobile too.
    const ctx = gsap.context(() => {
      // Mobile detection for performance tuning
      const isMobile = window.innerWidth < 1024 || "ontouchstart" in window;

      const getScrollAmount = () => {
        let galleryWidth = (gallery as HTMLElement).scrollWidth;
        return -(galleryWidth - window.innerWidth + 100);
      };

      gsap.to(gallery, {
        x: getScrollAmount,
        ease: "none",
        scrollTrigger: {
          trigger: wrapper,
          start: "top top",
          // Shorter scroll distance on mobile for faster response
          end: isMobile ? "+=2000" : "+=3000",
          pin: true,
          // Lower scrub value on mobile for more responsive feel
          scrub: isMobile ? 0.3 : 1,
          invalidateOnRefresh: true,
        },
      });
    }, wrapper); // <-- This is new

    // Refresh to ensure pinning calculations are correct
    ScrollTrigger.refresh();

    // Cleanup logic
    const cleanup = () => {
      ctx.revert(); // Revert all GSAP animations and ScrollTriggers created in this context
      document.removeEventListener("astro:before-preparation", cleanup);
    };
    document.addEventListener("astro:before-preparation", cleanup);
  }
</script>
