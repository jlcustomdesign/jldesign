---
// Mock portfolio for landing page (Keystatic content used on /portfolio page)
const portfolio = [
  {
    name: "Apartament Băneasa",
    material: "Nuc American",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-03.webp",
  },
  {
    name: "Villa Pipera",
    material: "Stejar Masiv",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-05.webp",
  },
  {
    name: "Penthouse Herăstrău",
    material: "MDF Vopsit & Marmură",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-08.webp",
  },
  {
    name: "Loft Timpuri Noi",
    material: "Metal & Lemn Recuperat",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-10.webp",
  },
  {
    name: "Brașov Residence",
    material: "Furnir Eucalipt",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-25.webp",
  },
  {
    name: "Office Space Unirii",
    material: "Sticlă & Oțel",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-24.webp",
  },
  {
    name: "Duplex Primăverii",
    material: "Marmură Carrara",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-27.webp",
  },
  {
    name: "Showroom Victoriei",
    material: "Compozit & Velvet",
    image: "/Images/optimized/Proiecte-JL-Custom-Design-30.webp",
  },
];

// Split into 4 columns for masonry effect
type PortfolioItem = typeof portfolio[0];
const columns: PortfolioItem[][] = [[], [], [], []];
portfolio.forEach((item, i) => {
  columns[i % 4].push(item);
});
---

<section
  class="bg-secondary relative"
  id="portfolio-section"
  data-theme="light"
>
  <div class="w-full relative min-h-screen py-32 px-4">
    <div class="container mx-auto mb-20 md:mb-32 px-4 md:px-0">
      <!-- Title Left Aligned -->
      <h2 class="font-serif text-4xl md:text-6xl text-primary text-left">
        Portofoliu Selectiv
      </h2>
    </div>

    <!-- 
      Grid Layout:
      - Mobile: 2 columns (grid-cols-2)
      - Desktop: 4 columns (md:grid-cols-4)
    -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-[1800px] mx-auto" id="portfolio-grid">
      {
        columns.map((col, colIndex) => (
          <div class="flex flex-col gap-4 portfolio-column" data-col-index={colIndex}>
            {col.map((item) => (
              <div class="group relative w-full overflow-hidden rounded-3xl">
                <!-- Image Container -->
                <div class="w-full aspect-[3/4] overflow-hidden relative bg-gray-200">
                  <img
                    src={item.image}
                    alt={item.name}
                    loading="lazy"
                    class="w-full h-[120%] object-cover absolute top-0 left-0 portfolio-img will-change-transform"
                    style="transform: translate3d(0, -10%, 0);" 
                  />
                  
                  <!-- Overlay: Visible on Hover (Glassmorphism) -->
                  <div class="absolute inset-0 bg-black/30 backdrop-blur-sm border border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-500 z-10 flex flex-col justify-center items-center text-center p-6 portfolio-overlay">
                    <h3 class="font-serif text-2xl text-accent translate-y-4 group-hover:translate-y-0 transition-transform duration-500 delay-100 portfolio-text">
                      {item.name}
                    </h3>
                     <p class="text-sm font-medium text-gray-300 mt-1 uppercase tracking-wider translate-y-4 group-hover:translate-y-0 transition-transform duration-500 delay-200 portfolio-text">
                      {item.material}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initPortfolioAnim() {
    const section = document.querySelector("#portfolio-section");
    if (!section) return;

    const cols = document.querySelectorAll(".portfolio-column");
    if (cols.length === 0) return;

    const setupParallax = (range: number) => {
        cols.forEach((col, i) => {
            const isOddVisual = (i + 1) % 2 !== 0; 
            const startY = isOddVisual ? range : -range;
            const endY = isOddVisual ? -range : range;

            gsap.fromTo(col, 
                { y: startY },
                {
                    y: endY,
                    ease: "none",
                    force3D: true, // Force GPU acceleration
                    scrollTrigger: {
                        trigger: section,
                        start: "top bottom", 
                        end: "bottom top",
                        scrub: true,
                    }
                }
            );
        });
    };

    let mm: any = ScrollTrigger.matchMedia({
        // Desktop/Tablet: Full range
        "(min-width: 768px)": function() {
            setupParallax(100);
        },
        // Mobile: Reduced range
        "(max-width: 767px)": function() {
            setupParallax(30);
        }
    });

    // Image Parallax (Subtle internal movement) - Always minimal
    const images = document.querySelectorAll(".portfolio-img");
    images.forEach((img) => {
            gsap.to(img, {
                y: "10%",
                ease: "none",
                force3D: true, // Force GPU acceleration
                scrollTrigger: {
                    trigger: img.parentElement,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: true
                }
            });
    });

    return () => mm.revert();
  }

  // Run on load and transitions
  if (document.readyState !== 'loading') initPortfolioAnim();
  else document.addEventListener('DOMContentLoaded', initPortfolioAnim);
  
  document.addEventListener("astro:page-load", initPortfolioAnim);
  document.addEventListener("astro:after-swap", initPortfolioAnim);
</script>
