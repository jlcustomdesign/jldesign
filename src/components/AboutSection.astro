---
// src/components/AboutSection.astro
import BubbleButton from "./ui/BubbleButton.astro";
import { ABOUT_SECTION } from "../config/content";
---

<section
  class="relative bg-secondary py-16 lg:py-24 overflow-hidden"
  id="about-section"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Image Reveal & Decorative Elements -->
      <div class="lg:col-span-5 lg:col-start-1 relative order-2 lg:order-1">
        <div class="about-image-main relative rounded-[2.5rem] overflow-hidden aspect-[4/5] max-h-[65vh] mx-auto w-full max-w-md lg:max-w-none shadow-2xl z-10">
          <img
            src="/Poze JL Custom Design - Site/LP/About/About-LP.webp"
            alt={ABOUT_SECTION.imageAlt}
            class="absolute inset-0 w-full h-full object-cover object-bottom about-parallax-img scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent pointer-events-none"></div>
        </div>
      </div>

      <!-- Right Column: Text Content -->
      <div class="lg:col-span-6 lg:col-start-7 space-y-8 order-1 lg:order-2">
        <div class="space-y-4 lg:space-y-6">
          <span class="block text-accent uppercase tracking-[0.3em] text-sm font-bold about-label">
            Povestea Noastră
          </span>
          <h2
            class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary leading-[1.1] about-heading"
            set:html={ABOUT_SECTION.headline}
          />
        </div>

        <div class="space-y-6 max-w-xl">
          <p class="text-lg md:text-xl text-primary/80 leading-relaxed about-text">
            {ABOUT_SECTION.paragraph1.replace('20', String(new Date().getFullYear() - 2006))}
          </p>
          <p class="text-base md:text-lg text-primary/60 leading-relaxed about-text">
            {ABOUT_SECTION.paragraph2}
          </p>
        </div>

        <div class="pt-4 lg:pt-6 about-cta">
          <BubbleButton href="/about" variant="dark">
            {ABOUT_SECTION.ctaButton}
          </BubbleButton>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let aboutAnimInitialized = false;

  function initAboutSectionRedesign() {
    if (aboutAnimInitialized) return;
    const section = document.querySelector("#about-section");
    if (!section) return;
    
    aboutAnimInitialized = true;

    const ctx = gsap.context(() => {
      // 1. Continuous Reveal Timeline (Image + Text)
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 75%",
        }
      });

      tl.from(".about-image-main", {
          clipPath: "inset(100% 0 0 0)",
          duration: 1.2,
          ease: "expo.inOut"
        })
        .from(".about-label", { opacity: 0, x: -20, duration: 0.8, ease: "power2.out" }, "-=0.8")
        .from(".about-heading", { opacity: 0, y: 30, duration: 1, ease: "expo.out" }, "-=0.6")
        .from(".about-text", { opacity: 0, y: 20, duration: 0.8, stagger: 0.15, ease: "power2.out" }, "-=0.8")
        .from(".about-cta", { opacity: 0, y: 20, duration: 0.6, ease: "back.out(1.5)" }, "-=0.6");

      // 2. Parallax
      const isMobile = window.innerWidth < 768;
      gsap.to(".about-parallax-img", {
        y: isMobile ? "5%" : "10%",
        ease: "none",
        scrollTrigger: {
          trigger: ".about-image-main",
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      });

    }, section);
  }

  document.addEventListener("astro:page-load", () => {
    aboutAnimInitialized = false;
    initAboutSectionRedesign();
  });
  
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAboutSectionRedesign();
  } else {
    document.addEventListener("DOMContentLoaded", initAboutSectionRedesign);
  }
</script>

