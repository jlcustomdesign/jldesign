---
import BubbleButton from "./ui/BubbleButton.astro";
---

<section
  class="relative bg-[#F4F1EA] py-16 md:py-24 overflow-hidden z-20"
  id="about-section"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10">
    <div
      class="flex flex-col lg:grid lg:grid-cols-2 gap-8 lg:gap-12 items-start"
    >
      <!-- Left Column -->
      <div class="contents lg:flex lg:flex-col lg:gap-8 lg:h-full">
        <!-- Headline Card -->
        <div
          class="about-fade-card bg-white p-8 lg:p-10 rounded-[2.5rem] shadow-xl about-card w-full"
        >
          <h2
            class="about-fade-text font-serif text-4xl lg:text-6xl text-primary leading-none"
          >
            Peste 15 ani de <br />
            <span class="text-accent">excelență</span> în <br />
            arta lemnului.
          </h2>
        </div>

        <!-- CTA Card -->
        <div
          class="about-fade-card bg-white p-8 lg:p-10 rounded-[2.5rem] shadow-xl about-card flex flex-col justify-center flex-grow order-last lg:order-none w-full"
        >
          <p class="about-fade-text text-lg text-primary/80 mb-8 max-w-sm">
            Ești gata să transformi ideile în realitate? Haide să discutăm
            despre proiectul tău.
          </p>
          <div class="about-fade-text">
            <BubbleButton href="/about" variant="dark" class="!px-10 !py-4">
              Descoperă Povestea
            </BubbleButton>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div
        class="about-fade-card bg-white p-8 lg:p-10 rounded-[2.5rem] shadow-xl about-card flex flex-col gap-8 h-full w-full"
      >
        <!-- Text Block -->
        <div>
          <p
            class="about-fade-text text-lg md:text-xl text-primary/80 leading-normal"
          >
            Fiecare piesă de mobilier pe care o creăm este rezultatul unei
            pasiuni pentru perfecțiune și al unui respect profund pentru
            tradiția meșteșugului, combinat cu tehnologii moderne de producție.
          </p>
          <p
            class="about-fade-text text-lg md:text-xl text-primary/80 leading-relaxed mt-6"
          >
            Nu producem doar mobilă, ci conturăm spațiul în care viața ta se
            desfășoară. De la concept la montaj, detaliul face diferența.
          </p>
        </div>

        <!-- Image -->
        <div
          class="about-fade-card relative w-full aspect-[4/3] overflow-hidden rounded-[2.5rem] about-image-wrapper"
        >
          <img
            src="https://images.unsplash.com/photo-1611269154421-4e27233ac5c7?q=80&w=1200&auto=format&fit=crop"
            alt="Craftsmanship detail"
            class="absolute inset-0 w-full h-full object-cover object-center about-image"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Centralized Initialization wrapper
  function initAboutSection() {
    const section = document.querySelector("#about-section");
    if (!section) return;

    // Make sure we kill old triggers first to prevent duplicates on navigation
    ScrollTrigger.getAll().forEach((t) => {
      if (
        (t.vars.trigger === ".about-image-wrapper" ||
          t.vars.trigger === section) &&
        t.vars.scrub
      ) {
        t.kill();
      }
    });

    // 1. Explicit GSAP Animations instead of buggy data-reveal
    const cards = gsap.utils.toArray(".about-fade-card");
    const texts = gsap.utils.toArray(".about-fade-text");

    cards.forEach((card: any, i) => {
      gsap.fromTo(
        card,
        { y: 50, opacity: 0 },
        {
          scrollTrigger: {
            trigger: card,
            start: "top 85%", // Trigger when the card itself enters viewport
            toggleActions: "play none none reverse",
          },
          y: 0,
          opacity: 1,
          duration: 1,
          ease: "expo.out",
          delay: (i % 3) * 0.1, // Stagger effect for items appearing together
        },
      );
    });

    texts.forEach((text: any) => {
      gsap.fromTo(
        text,
        { y: 30, opacity: 0 },
        {
          scrollTrigger: {
            trigger: text,
            start: "top 90%", // Start slightly after card triggers
            toggleActions: "play none none reverse",
          },
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
        },
      );
    });

    // 2. Parallax Effect
    gsap.to(".about-image", {
      y: "-15%",
      ease: "none",
      force3D: true, // Force GPU acceleration
      scrollTrigger: {
        trigger: ".about-image-wrapper",
        start: "top 95%", // Start slightly earlier on mobile
        end: "bottom top",
        scrub: true,
      },
    });
  }

  // Run on first load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAboutSection);
  } else {
    initAboutSection();
  }

  // Run on subsequent page navigations
  document.addEventListener("astro:page-load", initAboutSection);
</script>
