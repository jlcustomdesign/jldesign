---
import BubbleButton from "./ui/BubbleButton.astro";
---

<section
  class="relative bg-[#F4F1EA] py-24 md:py-32 overflow-hidden z-20"
  style="background-color: #F4F1EA; position: relative; z-index: 20;"
  id="about-section"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10">
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start"
      id="about-grid"
    >
      <!-- Left Column: Stacked Containers -->
      <div class="flex flex-col gap-8 h-full">
        <!-- Container 1: Headline -->
        <div
          class="bg-white p-8 md:p-12 rounded-3xl md:rounded-[2.5rem] shadow-xl about-card about-card-headline"
        >
          <h2
            class="about-headline font-serif text-4xl md:text-5xl lg:text-7xl text-primary leading-[1.1]"
          >
            Peste 15 ani de <br />
            <span class="text-accent">excelență</span> în <br />
            arta lemnului.
          </h2>
        </div>

        <!-- Container 2: CTA -->
        <div
          class="bg-white p-8 md:p-12 rounded-3xl md:rounded-[2.5rem] shadow-xl about-card about-card-cta flex flex-col justify-center flex-grow"
        >
          <p class="about-cta-text text-lg text-primary/80 mb-8 max-w-sm">
            Ești gata să transformi ideile în realitate? Haide să discutăm
            despre proiectul tău.
          </p>
          <div class="about-cta-btn">
            <BubbleButton href="/about" variant="dark" class="!px-10 !py-4">
              Descoperă Povestea
            </BubbleButton>
          </div>
        </div>
      </div>

      <!-- Right Column: Subtitle & Image (Container 3) -->
      <div
        class="bg-white p-8 md:p-12 rounded-3xl md:rounded-[2.5rem] shadow-xl about-card about-card-right flex flex-col gap-8 h-full"
      >
        <!-- Text Block -->
        <div class="about-text-block">
          <p
            class="about-text-p text-lg md:text-xl text-primary/80 leading-relaxed"
          >
            Fiecare piesă de mobilier pe care o creăm este rezultatul unei
            pasiuni pentru perfecțiune și al unui respect profund pentru
            tradiția meșteșugului, combinat cu tehnologii moderne de producție.
          </p>
          <p
            class="about-text-p text-lg md:text-xl text-primary/80 leading-relaxed mt-6"
          >
            Nu producem doar mobilă, ci conturăm spațiul în care viața ta se
            desfășoară. De la concept la montaj, detaliul face diferența.
          </p>
        </div>

        <!-- Image -->
        <div
          class="relative w-full aspect-[4/3] overflow-hidden about-image-wrapper mt-auto"
          style="border-radius: 2.5rem; clip-path: inset(0 round 2.5rem);"
        >
          <img
            src="https://images.unsplash.com/photo-1611269154421-4e27233ac5c7?q=80&w=1200&auto=format&fit=crop"
            alt="Craftsmanship detail"
            class="absolute inset-0 w-full h-[125%] object-cover object-center about-image"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAboutRedesign() {
    const section = document.querySelector("#about-section");
    if (!section) return;

    // --- HELPER: Manual Split Text ---
    const splitTextToSpans = (element: HTMLElement) => {
      if (!element || element.classList.contains("split-done")) return;

      const text = element.innerText;
      const words = text.split(/\s+/).filter((w) => w.length > 0);

      element.innerHTML = words
        .map(
          (word) =>
            `<span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">${word}&nbsp;</span></span>`,
        )
        .join("");

      element.classList.add("split-done");
    };

    // 1. Split Headline (Custom)
    const headline = document.querySelector(".about-headline") as HTMLElement;
    if (headline && !headline.classList.contains("split-done")) {
      const wrapWord = (word: string) =>
        `<span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">${word}&nbsp;</span></span>`;

      const part1 = "Peste 15 ani de".split(" ").map(wrapWord).join("");
      const part2 = "excelență"
        .split(" ")
        .map(
          (w) =>
            `<span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform">${w}</span></span>`,
        )
        .join("");
      const part3 = "în".split(" ").map(wrapWord).join("");
      const part4 = "arta lemnului.".split(" ").map(wrapWord).join("");

      headline.innerHTML = `
         ${part1}
         <br />
         <span class="text-accent inline-block">
            ${part2}
         </span>
         ${part3}
         <br />
         ${part4}
       `;
      headline.classList.add("split-done");
    }

    // 2. Split Paragraphs
    const paragraphs = section.querySelectorAll(
      ".about-cta-text, .about-text-p",
    );
    paragraphs.forEach((p) => splitTextToSpans(p as HTMLElement));

    // --- ANIMATIONS ---
    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();

      // Desktop: Pinned Sequence
      mm.add("(min-width: 1024px)", () => {
        // Initial States
        gsap.set(".about-card-headline", { x: -100, opacity: 0 });
        gsap.set(".about-card-cta", { x: -100, opacity: 0 });
        gsap.set(".about-card-right", { x: 100, opacity: 0 });

        gsap.set(".about-headline span span", { y: "100%", opacity: 0 });
        gsap.set(".about-cta-text span span", { y: "100%", opacity: 0 });
        gsap.set(".about-cta-btn", { y: 30, opacity: 0 });
        gsap.set(".about-text-p span span", { y: "100%", opacity: 0 });

        // Image Wrapper Initial
        gsap.set(".about-image-wrapper", { opacity: 0, y: 30 });

        // Timeline: Scrubbed Sequence
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: "top top",
            end: "+=250%",
            pin: true,
            scrub: 1,
            anticipatePin: 1,
          },
        });

        // STEP 1: CARDS STAGGERED ENTRANCE
        tl.to(".about-card-headline", {
          x: 0,
          opacity: 1,
          duration: 2,
          ease: "power2.out",
        })
          .to(
            ".about-card-cta",
            { x: 0, opacity: 1, duration: 2, ease: "power2.out" },
            "-=1.5",
          )
          .to(
            ".about-card-right",
            { x: 0, opacity: 1, duration: 2, ease: "power2.out" },
            "-=1.5",
          );

        // STEP 2: TEXTS REVEAL (After cards settle)
        tl.to(
          ".about-headline span span",
          {
            y: "0%",
            opacity: 1,
            stagger: 0.1,
            duration: 2,
            ease: "power2.out",
          },
          "-=1.0",
        )
          .to(
            ".about-cta-text span span",
            {
              y: "0%",
              opacity: 1,
              stagger: 0.05,
              duration: 2,
              ease: "power2.out",
            },
            "-=1.5",
          )
          .to(
            ".about-text-p span span",
            {
              y: "0%",
              opacity: 1,
              stagger: 0.03,
              duration: 2,
              ease: "power2.out",
            },
            "-=1.8",
          );

        // STEP 3: IMAGE REVEAL (Before Button)
        tl.to(
          ".about-image-wrapper",
          { opacity: 1, y: 0, duration: 2, ease: "power2.out" },
          "-=0.5",
        );

        // STEP 4: BUTTON (LAST)
        // Moves after image reveal
        tl.to(
          ".about-cta-btn",
          { y: 0, opacity: 1, duration: 1.5, ease: "power2.out" },
          "-=0.2",
        ); // Slight overlap for flow

        // Image Parallax
        const img = section.querySelector(".about-image");
        if (img) {
          tl.to(img, { y: "-20%", duration: 8, ease: "none" }, 0);
        }
      });

      // Mobile: Standard Triggers
      mm.add("(max-width: 1023px)", () => {
        gsap.from(".about-card-headline", {
          scrollTrigger: { trigger: ".about-card-headline", start: "top 85%" },
          x: -50,
          opacity: 0,
          duration: 1,
          ease: "power2.out",
        });
        gsap.from(".about-card-cta", {
          scrollTrigger: { trigger: ".about-card-cta", start: "top 85%" },
          x: -50,
          opacity: 0,
          duration: 1,
          delay: 0.2,
          ease: "power2.out",
        });
        gsap.from(".about-card-right", {
          scrollTrigger: { trigger: ".about-card-right", start: "top 85%" },
          x: 50,
          opacity: 0,
          duration: 1,
          delay: 0.4,
          ease: "power2.out",
        });

        const revealText = (trigger: string, target: string, delay = 0) => {
          const els = section.querySelectorAll(target);
          if (els.length) {
            gsap.to(els, {
              scrollTrigger: { trigger: trigger, start: "top 85%" },
              y: 0,
              opacity: 1,
              stagger: 0.05,
              duration: 0.8,
              delay: delay,
              ease: "power2.out",
            });
          }
        };

        revealText(".about-card-headline", ".about-headline span span", 0.5);
        revealText(".about-card-cta", ".about-cta-text span span", 0.5);
        revealText(".about-card-right", ".about-text-p span span", 0.5);

        // Image Before Button
        gsap.from(".about-image-wrapper", {
          scrollTrigger: { trigger: ".about-image-wrapper", start: "top 85%" },
          opacity: 0,
          y: 30,
          duration: 1,
          delay: 0.5,
        });

        // Button Last
        gsap.from(".about-cta-btn", {
          scrollTrigger: { trigger: ".about-card-cta", start: "top 85%" },
          y: 30,
          opacity: 0,
          duration: 1,
          delay: 0.8,
        });
      });
    }, section);

    ScrollTrigger.refresh();
  }

  // Robust Init Pattern
  if (document.readyState !== "loading") initAboutRedesign();
  else document.addEventListener("DOMContentLoaded", initAboutRedesign);

  document.addEventListener("astro:page-load", initAboutRedesign);
</script>
