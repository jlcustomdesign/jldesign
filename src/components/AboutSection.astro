---
import BubbleButton from "./ui/BubbleButton.astro";
---

<section
  class="relative bg-[#F4F1EA] py-16 md:py-24 overflow-hidden z-20"
  id="about-section"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10">
    <div
      class="flex flex-col lg:grid lg:grid-cols-2 gap-8 lg:gap-12 items-start"
    >
      <!-- Left Column -->
      <div class="contents lg:flex lg:flex-col lg:gap-8 lg:h-full">
        <!-- Headline Card -->
        <div
          class="bg-white p-8 lg:p-10 rounded-[2.5rem] shadow-xl about-card w-full"
          data-reveal="block"
          data-reveal-delay="0"
          data-reveal-duration="0.8"
        >
          <h2
            class="font-serif text-4xl lg:text-6xl text-primary leading-none"
            data-reveal="word-slide"
            data-reveal-delay="0.3"
            data-reveal-stagger="0.05"
          >
            Peste 15 ani de <br />
            <span class="text-accent">excelență</span> în <br />
            arta lemnului.
          </h2>
        </div>

        <!-- CTA Card -->
        <div
          class="bg-white p-8 lg:p-10 rounded-[2.5rem] shadow-xl about-card flex flex-col justify-center flex-grow order-last lg:order-none w-full"
          data-reveal="block"
          data-reveal-delay="0.2"
          data-reveal-duration="0.8"
        >
          <p
            class="text-lg text-primary/80 mb-8 max-w-sm"
            data-reveal="word-slide"
            data-reveal-delay="0.5"
          >
            Ești gata să transformi ideile în realitate? Haide să discutăm
            despre proiectul tău.
          </p>
          <div data-reveal="block" data-reveal-delay="0.7">
            <BubbleButton href="/about" variant="dark" class="!px-10 !py-4">
              Descoperă Povestea
            </BubbleButton>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div
        class="bg-white p-8 lg:p-10 rounded-[2.5rem] shadow-xl about-card flex flex-col gap-8 h-full w-full"
        data-reveal="block"
        data-reveal-delay="0.4"
        data-reveal-duration="0.8"
      >
        <!-- Text Block -->
        <div>
          <p
            class="text-lg md:text-xl text-primary/80 leading-normal"
            data-reveal="word-slide"
            data-reveal-delay="0.6"
          >
            Fiecare piesă de mobilier pe care o creăm este rezultatul unei
            pasiuni pentru perfecțiune și al unui respect profund pentru
            tradiția meșteșugului, combinat cu tehnologii moderne de producție.
          </p>
          <p
            class="text-lg md:text-xl text-primary/80 leading-relaxed mt-6"
            data-reveal="word-slide"
            data-reveal-delay="0.6"
          >
            Nu producem doar mobilă, ci conturăm spațiul în care viața ta se
            desfășoară. De la concept la montaj, detaliul face diferența.
          </p>
        </div>

        <!-- Image -->
        <div
          class="relative w-full aspect-[4/3] overflow-hidden rounded-[2.5rem] about-image-wrapper"
          data-reveal="block"
          data-reveal-delay="0.6"
          data-reveal-duration="1.0"
        >
          <img
            src="https://images.unsplash.com/photo-1611269154421-4e27233ac5c7?q=80&w=1200&auto=format&fit=crop"
            alt="Craftsmanship detail"
            class="absolute inset-0 w-full h-full object-cover object-center about-image"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTextAnimations } from "../utils/RevealAnimationHandler";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Initialize specific to this component just in case global init missed it or for View Transitions
  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector("#about-section");
    if (section) {
      // Pass the section as scope to prevent double-binding if called elsewhere
      initTextAnimations(section as HTMLElement);

      // Optional: Keep the subtle parallax if desired
      gsap.to(".about-image", {
        y: "-15%",
        ease: "none",
        scrollTrigger: {
          trigger: ".about-image-wrapper",
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      });
    }
  });

  // Initial fallback
  if (document.readyState === "complete") {
    const section = document.querySelector("#about-section");
    if (section) initTextAnimations(section as HTMLElement);
  } else {
    document.addEventListener("DOMContentLoaded", () => {
      const section = document.querySelector("#about-section");
      if (section) initTextAnimations(section as HTMLElement);
    });
  }
</script>
