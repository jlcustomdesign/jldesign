---
import BubbleButton from "./ui/BubbleButton.astro";
---

<section
  class="relative bg-[#F4F1EA] py-24 md:py-32 overflow-hidden z-20"
  style="background-color: #F4F1EA; position: relative; z-index: 20;"
  id="about-section"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Stacked Containers -->
      <div class="flex flex-col gap-8 h-full">
        <!-- Container 1: Headline -->
        <div
          class="bg-white p-8 md:p-12 rounded-3xl md:rounded-[2.5rem] shadow-xl about-card-headline"
        >
          <h2
            class="about-headline font-serif text-4xl md:text-5xl lg:text-7xl text-primary leading-[1.1]"
          >
            Peste 15 ani de <br />
            <span class="text-accent">excelență</span> în <br />
            arta lemnului.
          </h2>
        </div>

        <!-- Container 2: CTA -->
        <div
          class="bg-white p-8 md:p-12 rounded-3xl md:rounded-[2.5rem] shadow-xl about-card-cta flex flex-col justify-center flex-grow"
        >
          <p class="text-lg text-primary/80 mb-8 max-w-sm">
            Ești gata să transformi ideile în realitate? Haide să discutăm
            despre proiectul tău.
          </p>
          <div class="about-cta">
            <BubbleButton href="/about" variant="primary" class="!px-10 !py-4">
              Descoperă Povestea
            </BubbleButton>
          </div>
        </div>
      </div>

      <!-- Right Column: Subtitle & Image (Container 3) -->
      <div
        class="bg-white p-8 md:p-12 rounded-3xl md:rounded-[2.5rem] shadow-xl about-card-right flex flex-col gap-8 h-full"
      >
        <!-- Text Block -->
        <div class="about-text-block">
          <p class="text-lg md:text-xl text-primary/80 leading-relaxed">
            Fiecare piesă de mobilier pe care o creăm este rezultatul unei
            pasiuni pentru perfecțiune și al unui respect profund pentru
            tradiția meșteșugului, combinat cu tehnologii moderne de producție.
          </p>
          <p class="text-lg md:text-xl text-primary/80 leading-relaxed mt-6">
            Nu producem doar mobilă, ci conturăm spațiul în care viața ta se
            desfășoară. De la concept la montaj, detaliul face diferența.
          </p>
        </div>

        <!-- Image -->
        <div
          class="relative w-full aspect-[4/3] overflow-hidden rounded-2xl about-image-wrapper mt-auto"
        >
          <img
            src="https://images.unsplash.com/photo-1611269154421-4e27233ac5c7?q=80&w=1200&auto=format&fit=crop"
            alt="Craftsmanship detail"
            class="absolute inset-0 w-full h-[120%] object-cover object-center about-image"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAboutRedesign() {
    const section = document.querySelector("#about-section");
    const headlineCard = document.querySelector(".about-card-headline");
    const ctaCard = document.querySelector(".about-card-cta");
    const rightCard = document.querySelector(".about-card-right");

    if (!section || !headlineCard || !ctaCard || !rightCard) return;

    // --- ANIMATIONS ---
    const ctx = gsap.context(() => {
      // 1. Headline Card Reveal
      gsap.from(headlineCard, {
        scrollTrigger: {
          trigger: headlineCard,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
        y: 50,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
      });

      // 2. CTA Card Reveal
      gsap.from(ctaCard, {
        scrollTrigger: {
          trigger: ctaCard,
          start: "top 90%",
          toggleActions: "play none none reverse",
        },
        y: 50,
        opacity: 0,
        duration: 1,
        delay: 0.1,
        ease: "power3.out",
      });

      // 3. Right Card Reveal
      gsap.from(rightCard, {
        scrollTrigger: {
          trigger: rightCard,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
        y: 50,
        opacity: 0,
        duration: 1,
        delay: 0.2,
        ease: "power3.out",
      });

      // 4. Image Parallax
      const img = section.querySelector(".about-image");
      const imgWrapper = section.querySelector(".about-image-wrapper");
      if (img && imgWrapper) {
        gsap.to(img, {
          y: "-20%", // Move up inside container
          ease: "none",
          scrollTrigger: {
            trigger: imgWrapper,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        });
      }
    }, section);
  }

  // Robust Init Pattern used in ServicesSectionV2
  if (document.readyState !== "loading") initAboutRedesign();
  else document.addEventListener("DOMContentLoaded", initAboutRedesign);

  document.addEventListener("astro:page-load", initAboutRedesign);
</script>
