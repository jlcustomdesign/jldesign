---
// src/components/AboutSection.astro
import BubbleButton from "./ui/BubbleButton.astro";
import { ABOUT_SECTION } from "../config/content";
---

<section
  class="relative bg-secondary py-24 md:py-32 overflow-hidden z-20"
  id="about-section"
  data-theme="light"
>
  <div class="container mx-auto px-4 md:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Image Reveal & Decorative Elements -->
      <div class="lg:col-span-6 relative order-2 lg:order-1">
        <div class="about-image-main relative rounded-[2.5rem] overflow-hidden aspect-[4/5] shadow-2xl z-10">
          <img
            src="/Poze JL Custom Design - Site/LP/About/About-LP.webp"
            alt={ABOUT_SECTION.imageAlt}
            class="absolute inset-0 w-full h-full object-cover object-top about-parallax-img scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent pointer-events-none"></div>
        </div>
        
        <!-- Floating Accent Element -->
        <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-accent rounded-3xl -rotate-12 -z-10 opacity-20 blur-2xl about-accent"></div>
        <div class="absolute -top-12 -left-12 w-64 h-64 border border-primary/10 rounded-full -z-10 about-circle"></div>
      </div>

      <!-- Right Column: Text Content -->
      <div class="lg:col-span-6 space-y-10 order-1 lg:order-2">
        <div class="space-y-6">
          <span class="block text-accent uppercase tracking-[0.3em] text-sm font-bold about-label">
            Povestea Noastră
          </span>
          <h2
            class="font-serif text-4xl md:text-6xl lg:text-7xl text-primary leading-[1.1] about-heading"
            set:html={ABOUT_SECTION.headline}
          />
        </div>

        <div class="space-y-8 max-w-xl">
          <p class="text-xl md:text-2xl text-primary/80 leading-relaxed about-text">
            {ABOUT_SECTION.paragraph1}
          </p>
          <p class="text-lg text-primary/60 leading-relaxed about-text">
            {ABOUT_SECTION.paragraph2}
          </p>
        </div>

        <div class="pt-6 about-cta">
          <BubbleButton href="/about" variant="dark">
            {ABOUT_SECTION.ctaButton}
          </BubbleButton>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAboutSectionRedesign() {
    const section = document.querySelector("#about-section");
    if (!section) return;

    const ctx = gsap.context(() => {
      // 1. Text Reveals
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
        }
      });

      tl.from(".about-label", { opacity: 0, x: -20, duration: 0.8, ease: "power2.out" })
        .from(".about-heading", { opacity: 0, y: 40, duration: 1, ease: "expo.out" }, "-=0.4")
        .from(".about-text", { opacity: 0, y: 20, duration: 0.8, stagger: 0.2, ease: "power2.out" }, "-=0.6")
        .from(".about-cta", { opacity: 0, scale: 0.9, duration: 0.6, ease: "back.out(1.7)" }, "-=0.4");

      // 2. Image Reveal
      gsap.from(".about-image-main", {
        scrollTrigger: {
          trigger: ".about-image-main",
          start: "top 85%",
        },
        clipPath: "inset(100% 0 0 0)",
        duration: 1.5,
        ease: "expo.inOut"
      });

      // 3. Parallax & Floating
      const isMobile = window.innerWidth < 768;
      gsap.to(".about-parallax-img", {
        y: isMobile ? "5%" : "10%",
        ease: "none",
        scrollTrigger: {
          trigger: ".about-image-main",
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      });

      gsap.to(".about-accent", {
        rotate: 12,
        duration: 20,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut"
      });

      gsap.to(".about-circle", {
        scale: 1.1,
        duration: 15,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut"
      });

    }, section);
  }

  document.addEventListener("astro:page-load", initAboutSectionRedesign);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAboutSectionRedesign();
  }
</script>

