---
import { SERVICES_PAGE } from "../config/content";

interface Props {
  items?: any[];
  title?: string;
  subtitle?: string;
  description?: string;
  ctaText?: string;
}

const {
  items = SERVICES_PAGE.process,
  title = "Ce putem face pentru tine",
  subtitle,
  description = "De la proiectare la montaj, oferim soluții de mobilier personalizat adaptate nevoilor tale.",
  ctaText = "Cere o ofertă"
} = Astro.props;
---

<section class="bg-secondary py-24 md:py-32 overflow-hidden border-t border-primary/5">
  <div class="max-w-[1800px] mx-auto px-4 md:px-8">
    
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-16 md:mb-24">
      <div class="max-w-2xl">
        {subtitle && (
          <div class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-full border border-primary/10 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
            <span class="text-xs font-bold uppercase tracking-widest text-primary">{subtitle}</span>
          </div>
        )}
        <h2 class="font-serif text-5xl md:text-7xl text-primary leading-[1.1]">
          {title}
        </h2>
      </div>
      <div class="max-w-md md:text-right flex flex-col md:items-end gap-8">
        <p class="text-primary/70 text-lg leading-relaxed">
          {description}
        </p>
        <a href="/contact" class="group inline-flex w-max mx-auto md:mx-0 items-center gap-4 bg-[#c7b299] hover:bg-primary text-primary hover:text-white px-8 py-4 rounded-full transition-all duration-500 shadow-lg">
          <span class="font-medium tracking-wide">{ctaText}</span>
          <div class="w-10 h-10 rounded-full bg-primary group-hover:bg-white flex items-center justify-center transition-colors duration-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white group-hover:text-primary"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </div>
        </a>
      </div>
    </div>

    <!-- Grid Section -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-6">
      {items.map((item, i) => (
        <div class="group service-card-v2 relative h-[400px] md:h-[480px] perspective-1000 cursor-pointer" data-index={i}>
          <div class="card-inner relative w-full h-full transition-transform duration-700 transform-style-3d">
            
            <!-- Front Face -->
            <div class="card-front absolute inset-0 w-full h-full backface-hidden rounded-[2rem] overflow-hidden">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <!-- Dark Gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-80"></div>
              
              <!-- Arrow Icon -->
              <div class="absolute top-6 right-6 w-12 h-12 rounded-full bg-white/20 backdrop-blur-md border border-white/30 flex items-center justify-center group-hover:bg-white group-hover:border-white transition-all duration-500">
                 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white group-hover:text-primary transition-colors duration-500"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </div>

              <!-- Title -->
              <div class="absolute bottom-10 left-8 right-8">
                <h3 class="font-serif text-2xl md:text-3xl text-white leading-tight">
                  {item.title}
                </h3>
              </div>
            </div>

            <!-- Back Face -->
            <div class="card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 bg-[#1a1a1a] rounded-[2rem] p-10 flex flex-col justify-center items-center text-center border border-white/10 shadow-2xl">
              <h3 class="font-serif text-2xl text-white mb-6">{item.title}</h3>
              <p class="text-white/70 text-lg leading-relaxed mb-8">
                {item.backDesc || item.desc}
              </p>
              <div class="w-12 h-12 rounded-full border border-white/20 flex items-center justify-center text-white/40 group-hover:text-white group-hover:border-white transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
  .is-flipped .card-inner {
    transform: rotateY(180deg);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initServicesGridV2() {
    const section = document.querySelector(".service-card-v2")?.closest("section");
    if (!section) return;

    // Flip logic
    const cards = section.querySelectorAll('.service-card-v2');
    cards.forEach(card => {
      card.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
      });
    });

    // Reveal animation
    gsap.from(cards, {
      y: 100,
      opacity: 0,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out",
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
      }
    });

    // Header reveal
    gsap.from(section.querySelector(".max-w-2xl"), {
      x: -50,
      opacity: 0,
      duration: 1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
      }
    });

    gsap.from(section.querySelector(".max-w-md"), {
      x: 50,
      opacity: 0,
      duration: 1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
      }
    });
  }

  document.addEventListener("astro:page-load", initServicesGridV2);
  if (document.readyState !== "loading") initServicesGridV2();
  else document.addEventListener("DOMContentLoaded", initServicesGridV2);
</script>
