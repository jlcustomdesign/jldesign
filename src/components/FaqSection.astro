---
const faqs = [
  {
    q: "Cât durează execuția unei comenzi?",
    a: "În funcție de complexitatea proiectului, termenul de livrare variază între 4 și 8 săptămâni de la semnarea contractului și stabilirea detaliilor tehnice finale.",
  },
  {
    q: "Oferiți garanție pentru mobilier?",
    a: "Da, oferim o garanție comercială de 24 de luni pentru mobilier și garanția producătorului pentru feronerie (care poate ajunge până la 20 de ani la branduri precum Blum).",
  },
  {
    q: "Realizați și proiectare 3D?",
    a: "Absolut. Fiecare proiect începe cu o etapă de consultanță și proiectare 3D, astfel încât să puteți vizualiza exact cum va arăta spațiul dumneavoastră final.",
  },
  {
    q: "Ce tipuri de materiale folosiți?",
    a: "Lucrăm cu o gamă variată de materiale premium: MDF vopsit sau înfoliat, PAL melaminat Egger/Kronospan, furnir natural, lemn masiv, sticlă, metal și compozit.",
  },
  {
    q: "Este necesară o programare pentru vizita în showroom?",
    a: "Pentru a ne asigura că un designer vă poate acorda întreaga atenție, recomandăm programarea unei vizite în prealabil, telefonic sau prin email.",
  },
  {
    q: "Vă ocupați și de integrarea electrocasnicelor?",
    a: "Desigur. Mobilierul este proiectat milimetric pentru a încorpora perfect electrocasnicele dumneavoastră, indiferent de marcă sau dimensiuni.",
  },
  {
    q: "Care sunt condițiile de plată?",
    a: "Standardul nostru este un avans de 50% la semnarea contractului pentru a demara producția, iar restul de 50% se achită înainte de livrare și montaj.",
  },
  {
    q: "Livrați mobilier și în afara Bucureștiului?",
    a: "Da, realizăm proiecte la nivel național. Pentru livrările în afara zonei București-Ilfov, se va calcula un cost suplimentar de transport și logistică.",
  },
];
---

<section class="py-24 bg-secondary" id="faq-section-v2" data-theme="light">
  <div class="container mx-auto px-4 md:px-8">
    <div
      class="flex flex-col lg:flex-row gap-16 items-start relative wrapper-v2"
    >
      <!-- Left: Sidebar (Will be animated manually) -->
      <div class="lg:w-1/3 z-10 relative" id="faq-sidebar-v2">
        <h2 class="font-serif text-4xl md:text-5xl text-primary mb-6">
          Întrebări Frecvente
        </h2>
      </div>

      <!-- Right: Accordion -->
      <div class="lg:w-2/3 w-full" id="faq-list-v2">
        <div class="space-y-4">
          {
            faqs.map((faq, index) => (
              <div class="group pb-4 faq-item-v2 cursor-pointer relative will-change-transform will-change-opacity">
                <button
                  class="w-full flex justify-between items-center py-4 text-left focus:outline-none faq-trigger-v2"
                  aria-expanded="false"
                >
                  <span class="text-2xl md:text-3xl font-medium text-primary group-hover:text-accent transition-colors">
                    {faq.q}
                  </span>
                  <span class="ml-4 transform transition-transform duration-300 faq-icon-v2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      class="w-8 h-8 md:w-10 md:h-10"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4.5v15m7.5-7.5h-15"
                      />
                    </svg>
                  </span>
                </button>
                <div class="h-0 overflow-hidden faq-content-v2 opacity-0">
                  <p class="text-gray-600 leading-relaxed pb-4 pr-8 text-lg">
                    {faq.a}
                  </p>
                </div>
                <!-- Animated Separator Line -->
                <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gray-200 origin-left transform scale-x-0 faq-line"></div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", initFAQv2);
  initFAQv2();

  function initFAQv2() {
    // Helper: Split text
    const splitTextToWords = (element: Element | null) => {
      if (!element) return;
      const text = element.textContent?.trim() || "";
      element.innerHTML = text
        .split(" ")
        .map(
          (word: string) =>
            `<span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform" style="filter: blur(8px)">${word}&nbsp;</span></span>`
        )
        .join("");
    };

    // Animate Header (Triggered)
    const faqHeader = document.querySelector("#faq-sidebar-v2 h2");
    splitTextToWords(faqHeader);

    // Animate FAQ Items (Triggered List)
    const faqItemsList = document.querySelectorAll(".faq-item-v2");
    
    // Master Scrub Timeline (Matched to About Section logic)
    const scrubTl = gsap.timeline({
      scrollTrigger: {
        trigger: "#faq-section-v2",
        start: "top bottom", // Start as soon as section enters viewport
        end: "center 60%",   // Finish when section center is at 60% viewport
        scrub: 1,
      }
    });

    // Check mobile
    const isMobile = window.innerWidth < 1024;

    // 1. Header Reveal (Use fromTo for guaranteed start state)
    if (faqHeader) {
      scrubTl.fromTo(
        faqHeader.querySelectorAll("span span"),
        { 
            y: 20, 
            opacity: 0, 
            filter: isMobile ? "none" : "blur(10px)" 
        }, 
        {
          y: 0,
          opacity: 1,
          filter: isMobile ? "none" : "blur(0px)",
          duration: 2,
          stagger: 0.1,
          ease: "power2.out",
        }
      );
    }

    // 2. Items & Lines Reveal
    if (faqItemsList.length) {
      faqItemsList.forEach((item, i) => {
         const line = item.querySelector(".faq-line");
         
         // Check mobile
         const isMobile = window.innerWidth < 1024;

         // Animate Item Opacity/Blur (fromTo)
         scrubTl.fromTo(
           item,
           { 
             y: 20, 
             opacity: 0, 
             filter: isMobile ? "none" : "blur(5px)" // Disable expensive blur on mobile
           },
           {
            y: 0,
            opacity: 1,
            filter: isMobile ? "none" : "blur(0px)",
            duration: 2,
            ease: "power2.out"
           },
           "-=1.5"
         );

         // Animate Line Expansion (fromTo)
         if(line) {
             scrubTl.fromTo(
               line,
               { scaleX: 0 },
               {
                 scaleX: 1,
                 duration: 3,
                 ease: "none"
               },
               "<"
             );
         }
      });
    }

    // 1. Accordion Logic (No changes, works well)
    const items = document.querySelectorAll(".faq-item-v2");

    if (items.length) {
      items.forEach((item) => {
        const trigger = item.querySelector(".faq-trigger-v2");
        const content = item.querySelector(".faq-content-v2");
        const icon = item.querySelector(".faq-icon-v2");

        if (!trigger || !content || !icon) return;

        trigger.addEventListener("click", () => {
          const isOpen = content.clientHeight > 0;

          // Close others
          items.forEach((otherItem) => {
            if (otherItem !== item) {
              const otherContent = otherItem.querySelector(".faq-content-v2");
              const otherIcon = otherItem.querySelector(".faq-icon-v2");
              /* @ts-ignore */
              if (otherContent && otherContent.clientHeight > 0) {
                gsap.to(otherContent, {
                  height: 0,
                  opacity: 0,
                  duration: 0.4,
                  ease: "power2.out",
                });
                gsap.to(otherIcon, { rotation: 0, duration: 0.2 });
              }
            }
          });

          if (!isOpen) {
            gsap.to(content, {
              height: "auto",
              opacity: 1,
              duration: 0.5,
              ease: "power2.out",
              onComplete: () => ScrollTrigger.refresh(),
            });
            gsap.to(icon, { rotation: 45, duration: 0.2 });
          } else {
            gsap.to(content, {
              height: 0,
              opacity: 0,
              duration: 0.4,
              ease: "power2.in",
              onComplete: () => ScrollTrigger.refresh(),
            });
            gsap.to(icon, { rotation: 0, duration: 0.2 });
          }
        });
      });
    }

    // 2. Manual "Sticky" Logic using GSAP Scrub (1:1 Movement)
    // This replicates sticky behavior by animating Y position to exactly match scroll distance
    if (window.innerWidth >= 1024) {
      setTimeout(() => {
        const sidebar = document.querySelector(
          "#faq-sidebar-v2"
        ) as HTMLElement;
        const content = document.querySelector("#faq-list-v2") as HTMLElement;
        const wrapper = document.querySelector(".wrapper-v2") as HTMLElement;

        if (sidebar && content && wrapper) {
          // Cleanup
          ScrollTrigger.getAll().forEach((st) => {
            if (st.vars.trigger === sidebar || st.vars.trigger === wrapper)
              st.kill();
          });

          // We use function-based values so they recalculate when the Accordion changes size
          // and ScrollTrigger.refresh() is called.

          // The tween: Move sidebar down by (ContentHeight - SidebarHeight)
          gsap.to(sidebar, {
            y: () => {
              const diff = content.offsetHeight - sidebar.offsetHeight;
              return diff > 0 ? diff : 0;
            },
            ease: "none", // Linear, 1:1 with scroll
            scrollTrigger: {
              trigger: wrapper,
              start: "top top+=120", // Pin starts when wrapper hits this point
              // The duration of the scroll (end) MUST match the distance we move (y)
              // relative to the viewport movement for it to appear "pinned".
              end: () => {
                const diff = content.offsetHeight - sidebar.offsetHeight;
                return "+=" + (diff > 0 ? diff : 0);
              },
              scrub: true, // Tie animation strictly to scroll position, instant response
              invalidateOnRefresh: true, // Important: Recalculate values on resize/refresh
            },
          });
        }
      }, 500);
    }
  }
</script>
