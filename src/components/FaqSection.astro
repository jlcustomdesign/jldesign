---
import { FAQ } from "../config/content";

const faqs = FAQ.items;

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a,
    },
  })),
});
---

<section class="py-24 bg-secondary" id="faq-section-v2" data-theme="light">
  <script type="application/ld+json" set:html={faqSchema}></script>
  <div class="container mx-auto px-4 md:px-8">
    <div
      class="flex flex-col lg:flex-row gap-16 items-start relative wrapper-v2"
    >
      <!-- Left: Sidebar (Will be animated manually) -->
      <div class="lg:w-1/3 z-10 relative" id="faq-sidebar-v2">
          <h2 class="font-serif text-5xl md:text-6xl text-primary mb-8" id="faq-title">
            {FAQ.title}
          </h2>
      </div>

      <!-- Right: Accordion -->
      <div class="lg:w-2/3 w-full" id="faq-list-v2">
        <div class="space-y-4">
          {
            faqs.map((faq, index) => (
              <div class="group pb-4 faq-item-v2 cursor-pointer relative will-change-transform will-change-opacity">
                <button
                  class="w-full flex justify-between items-center py-4 text-left focus:outline-none faq-trigger-v2"
                  aria-expanded="false"
                >
                  <span class="text-2xl md:text-3xl font-medium text-primary group-hover:text-accent transition-colors">
                    {faq.q}
                  </span>
                  <span class="ml-4 transform transition-transform duration-300 faq-icon-v2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      class="w-8 h-8 md:w-10 md:h-10"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4.5v15m7.5-7.5h-15"
                      />
                    </svg>
                  </span>
                </button>
                <div class="h-0 overflow-hidden faq-content-v2 opacity-0">
                  <p class="text-gray-600 leading-relaxed pb-4 pr-8 text-lg">
                    {faq.a}
                  </p>
                </div>
                <!-- Animated Separator Line -->
                <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gray-200 origin-left transform scale-x-0 faq-line"></div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", initFAQv2);
  initFAQv2();

  function initFAQv2() {
    // Helper: Split text into words for animation
    // Wraps each word in spans for blur/opacity control
    const splitTextToWords = (element: Element | null) => {
      if (!element) return;
      const text = element.textContent?.trim() || "";
      element.innerHTML = text
        .split(" ")
        .map(
          (word: string) =>
            `<span class="inline-block overflow-hidden"><span class="inline-block translate-y-full opacity-0 will-change-transform" style="filter: blur(8px)">${word}&nbsp;</span></span>`
        )
        .join("");
    };

    const isMobile = window.innerWidth < 1024;

    // --- 1. Header Reveal (One-time trigger) ---
    const faqHeader = document.querySelector("#faq-sidebar-v2 h2");
    splitTextToWords(faqHeader);
    
    if (faqHeader) {
      ScrollTrigger.create({
        trigger: "#faq-section-v2",
        start: "top 80%", // Trigger when section comes into view
        onEnter: () => {
          gsap.to(faqHeader.querySelectorAll("span span"), {
            y: 0,
            opacity: 1,
            filter: "blur(0px)",
            duration: 1.5,
            stagger: 0.1,
            ease: "power3.out",
          });
        }
      });
    }

    // --- 2. Questions Progressive Reveal (Scrub) ---
    // Questions reveal (blur -> focus) as they move up the viewport
    const faqItemsList = document.querySelectorAll(".faq-item-v2");

    if (faqItemsList.length) {
      faqItemsList.forEach((item) => {
        const questionText = item.querySelector("span.text-2xl"); // The question text
        const line = item.querySelector(".faq-line");

        // Animate Line (Scrub)
        if (line) {
          gsap.fromTo(line, 
            { scaleX: 0, transformOrigin: "left" },
            {
              scaleX: 1,
              ease: "none",
              scrollTrigger: {
                trigger: item,
                start: "top bottom", // Start when item enters bottom
                end: "top 70%",      // Finish when item is 70% up
                scrub: 1,
              }
            }
          );
        }

        // Animate Question Text opacity/blur (Scrub)
        if (questionText) {
          gsap.fromTo(questionText,
            { 
              opacity: 0.2, 
              filter: "blur(4px)",
              y: 20 
            },
            {
              opacity: 1, 
              filter: "blur(0px)",
              y: 0,
              ease: "none",
              scrollTrigger: {
                trigger: item,
                start: "top bottom", 
                end: "top 60%",    // Fully visible when 60% down viewport
                scrub: 1,
              }
            }
          );
        }
      });
    }

    // --- 3. Accordion Logic with Perspective Reveal ---
    const items = document.querySelectorAll(".faq-item-v2");

    if (items.length) {
      items.forEach((item) => {
        const trigger = item.querySelector(".faq-trigger-v2");
        const content = item.querySelector(".faq-content-v2");
        const icon = item.querySelector(".faq-icon-v2");
        const answerTextP = item.querySelector("p"); // The P tag inside content

        if (!trigger || !content || !icon || !answerTextP) return;

        // Save original text for restoring if needed (though we just overwrite here)
        /* @ts-ignore */
        if (!answerTextP._originalText) answerTextP._originalText = answerTextP.innerHTML;

        trigger.addEventListener("click", () => {
          const isOpen = content.clientHeight > 0;

          // Close others
          items.forEach((otherItem) => {
            if (otherItem !== item) {
              const otherContent = otherItem.querySelector(".faq-content-v2");
              const otherIcon = otherItem.querySelector(".faq-icon-v2");
              /* @ts-ignore */
              if (otherContent && otherContent.clientHeight > 0) {
                gsap.to(otherContent, {
                  height: 0,
                  opacity: 0,
                  duration: 0.4,
                  ease: "power2.out",
                });
                gsap.to(otherIcon, { rotation: 0, duration: 0.2 });
              }
            }
          });

          if (!isOpen) {
            // OPENING
            // 1. Expand Height
            gsap.to(content, {
              height: "auto",
              opacity: 1,
              duration: 0.5,
              ease: "power2.out",
              onComplete: () => ScrollTrigger.refresh(),
            });
            gsap.to(icon, { rotation: 45, duration: 0.2 });

            // 2. Animate Answer Text (Perspective Reveal)
            // Use split words approach for 3D effect
            /* @ts-ignore */
            answerTextP.innerHTML = answerTextP._originalText; // Reset
            
            // Only do expensive word split on desktop
            if (!isMobile) {
                const words = answerTextP.innerText.split(" ");
                answerTextP.innerHTML = words.map(w => `<span class="inline-block opacity-0" style="transform-origin: 50% 50%; transform: rotateX(90deg) translateY(10px)">${w}&nbsp;</span>`).join("");
                
                gsap.to(answerTextP.querySelectorAll("span"), {
                    opacity: 1,
                    rotateX: 0,
                    translateY: 0,
                    duration: 0.5,
                    stagger: 0.01,
                    ease: "back.out(1.5)",
                    delay: 0.1 // Wait for height expansion slightly
                });
            } else {
                // Mobile: Simple fade
                 gsap.fromTo(answerTextP, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4, delay: 0.1 });
            }

          } else {
            // CLOSING
            gsap.to(content, {
              height: 0,
              opacity: 0,
              duration: 0.4,
              ease: "power2.in",
              onComplete: () => ScrollTrigger.refresh(),
            });
            gsap.to(icon, { rotation: 0, duration: 0.2 });
          }
        });
      });
    }

    // --- 4. Sidebar Sticky Logic (Desktop Only via MatchMedia) ---
    ScrollTrigger.matchMedia({
        "(min-width: 1024px)": function() {
            const sidebar = document.querySelector("#faq-sidebar-v2") as HTMLElement;
            const content = document.querySelector("#faq-list-v2") as HTMLElement;
            const wrapper = document.querySelector(".wrapper-v2") as HTMLElement;

            if (sidebar && content && wrapper) {
                ScrollTrigger.create({
                    trigger: wrapper, 
                    start: "top top+=120", 
                    end: () => `+=${content.offsetHeight - sidebar.offsetHeight}`,
                    pin: sidebar, 
                    pinSpacing: false,
                    invalidateOnRefresh: true, 
                });
            }
        },
        "(max-width: 1023px)": function() {
             // Cleanup if needed, usually auto-handled by matchMedia for triggers created inside
        }
    });
  }
</script>
