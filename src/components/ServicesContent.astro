---
import BubbleButton from "./ui/BubbleButton.astro";
import { SERVICES_PAGE } from "../config/content";

interface Props {
  items?: any[];
  title?: string;
  id?: string;
}

const { 
  items = SERVICES_PAGE.services, 
  title,
  id = "services-detailed"
} = Astro.props;

// Split services: First item (Hero) vs Rest (Grid)
const [firstService, ...restServices] = items;

// Split remaining items into columns
const col1 = restServices.filter((_, i) => i % 2 === 0);
const col2 = restServices.filter((_, i) => i % 2 !== 0);
---

<section
  id={id}
  class="bg-secondary py-24 md:py-32 w-full overflow-hidden border-t border-primary/5"
>
  <div class="container mx-auto px-4 md:px-8">
    {title && (
      <div class="mb-16 md:mb-24">
        <h2 class="font-serif text-4xl md:text-6xl text-primary">{title}</h2>
      </div>
    )}
    <div class="flex flex-col gap-16 md:gap-32">
      <!-- 1. FEATURED HERO ITEM (Full Width) -->
      <!-- Solves the "5 items" odd number issue by giving the first one prominence -->
      <!-- 1. FEATURED HERO ITEM (Full Width) -->
      <!-- Solves the "5 items" odd number issue by giving the first one prominence -->
      
      <!-- We make the Hero Item also a Flip Card for consistency, or keep it static? 
           User said "for each image". So we apply to all. -->
           
      <div class="group service-card w-full h-[600px] md:h-[80vh] perspective-1000">
         <div class="flip-card-inner relative w-full h-full transition-transform duration-700 transform-style-3d">
            
            <!-- FRONT -->
            <div class="flip-card-front absolute inset-0 w-full h-full backface-hidden rounded-[2.5rem] overflow-hidden shadow-2xl">
                 <img 
                  src={firstService.img} 
                  alt={firstService.title}
                  class="w-full h-full object-cover transition-transform duration-700 md:group-hover:scale-105 group-hover:scale-110"
                  loading="lazy"
                />
                
                <!-- Match Grid Gradient on Mobile, Original on Desktop -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 md:from-black/70 md:via-transparent to-transparent opacity-80 md:opacity-60 group-hover:opacity-90 md:group-hover:opacity-80 transition-opacity duration-500"></div>
                
                <!-- Match Grid Positioning/Padding on Mobile -->
                <div class="absolute bottom-0 md:bottom-16 left-0 md:left-16 w-full p-8 md:p-0 md:px-4 text-white max-w-2xl transform transition-transform duration-500 translate-y-2 group-hover:translate-y-0 md:translate-y-0 text-left">
                   <h2 class="font-serif font-medium text-3xl md:text-7xl leading-tight md:leading-none mb-3 md:mb-6">
                     {firstService.title}
                   </h2>
                   <!-- Match Grid Desc Opacity on Mobile -->
                   <p class="font-sans text-lg md:text-2xl text-gray-200 md:text-white/90 leading-relaxed md:max-w-xl opacity-90 md:opacity-100 group-hover:opacity-100 transition-opacity mb-6 md:mb-8 max-w-sm">
                     {firstService.desc}
                   </p>
                   <button class="flip-trigger inline-block bg-white/10 backdrop-blur-md border border-white/30 text-white px-6 md:px-8 py-2 md:py-3 rounded-full hover:bg-white hover:text-black transition-all duration-300 text-sm md:text-base">
                      {SERVICES_PAGE.flipReadMore}
                   </button>
                </div>
            </div>

            <!-- BACK text mapping -->
            <div class="flip-card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 bg-white md:bg-secondary rounded-[2.5rem] overflow-hidden p-8 md:p-16 flex flex-col justify-center md:items-start shadow-2xl">
                <h3 class="font-serif text-2xl md:text-5xl text-primary mb-4 md:mb-6">{firstService.title}</h3>
                <p class="font-sans text-gray-600 text-base md:text-xl leading-relaxed mb-6 md:mb-8 max-w-3xl">
                    {firstService.backDesc}
                </p>
                <ul class="font-sans text-gray-500 space-y-2 mb-8 md:mb-12 list-disc list-inside hidden md:block">
                    {SERVICES_PAGE.flipBackItems.map((item) => (
                      <li>{item}</li>
                    ))}
                </ul>
                <button class="flip-close text-primary text-sm md:text-base border-b border-primary pb-1 w-max md:w-auto hover:text-accent hover:border-accent transition-colors">
                    <span class="md:hidden">{SERVICES_PAGE.flipBack}</span>
                    <span class="hidden md:inline">{SERVICES_PAGE.flipBackDesktop}</span>
                </button>
            </div>

         </div>
      </div>

      <!-- 2. MASONRY GRID (Remaining 4 Items) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-start">
        <!-- Column 1 -->
        <div class="flex flex-col gap-12 md:gap-24 masonry-col" data-speed="1">
          {
            col1.map((service, i) => (
              <div class="group service-card perspective-1000 h-[600px] w-full"> <!-- Fixed height for flip to work well -->
                <div class="flip-card-inner relative w-full h-full transition-transform duration-700 transform-style-3d">
                    
                    <!-- FRONT -->
                    <div class="flip-card-front absolute inset-0 w-full h-full backface-hidden rounded-[2.5rem] overflow-hidden shadow-2xl">
                        <img
                            src={service.img}
                            alt={service.title}
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500" />

                        <div class="absolute bottom-0 left-0 w-full p-8 md:p-10 transform transition-transform duration-500 translate-y-2 group-hover:translate-y-0">
                            <h2 class="font-serif font-medium text-3xl md:text-5xl text-white leading-tight mb-3">
                            {service.title}
                            </h2>
                            <p class="font-sans text-gray-200 text-lg leading-relaxed max-w-sm opacity-90 group-hover:opacity-100 transition-opacity mb-6">
                            {service.desc}
                            </p>
                            <button class="flip-trigger inline-block bg-white/10 backdrop-blur-md border border-white/30 text-white px-6 py-2 rounded-full hover:bg-white hover:text-black transition-all duration-300 text-sm">
                                {SERVICES_PAGE.flipReadMore}
                            </button>
                        </div>
                    </div>

                    <!-- BACK -->
                    <div class="flip-card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 bg-white rounded-[2.5rem] overflow-hidden p-8 md:p-12 flex flex-col justify-center shadow-2xl">
                         <h3 class="font-serif text-2xl md:text-4xl text-primary mb-4">{service.title}</h3>
                         <p class="font-sans text-gray-600 leading-relaxed mb-6">
                            {service.backDesc}
                         </p>
                         <button class="flip-close text-primary text-sm border-b border-primary pb-1 w-max hover:text-accent hover:border-accent transition-colors">
                            {SERVICES_PAGE.flipBack}
                         </button>
                    </div>

                </div>
              </div>
            ))
          }
        </div>

        <!-- Column 2 -->
        <div
          class="flex flex-col gap-12 md:gap-24 masonry-col md:pt-32"
          data-speed="1.1"
        >
          {
            col2.map((service, i) => (
              <div class="group service-card perspective-1000 h-[600px] w-full">
                <div class="flip-card-inner relative w-full h-full transition-transform duration-700 transform-style-3d">
                    <!-- FRONT -->
                    <div class="flip-card-front absolute inset-0 w-full h-full backface-hidden rounded-[2.5rem] overflow-hidden shadow-2xl">
                        <img
                            src={service.img}
                            alt={service.title}
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500" />

                        <div class="absolute bottom-0 left-0 w-full p-8 md:p-10 transform transition-transform duration-500 translate-y-2 group-hover:translate-y-0">
                            <h2 class="font-serif font-medium text-3xl md:text-5xl text-white leading-tight mb-3">
                            {service.title}
                            </h2>
                            <p class="font-sans text-gray-200 text-lg leading-relaxed max-w-sm opacity-90 group-hover:opacity-100 transition-opacity mb-6">
                            {service.desc}
                            </p>
                             <button class="flip-trigger inline-block bg-white/10 backdrop-blur-md border border-white/30 text-white px-6 py-2 rounded-full hover:bg-white hover:text-black transition-all duration-300 text-sm">
                                {SERVICES_PAGE.flipReadMore}
                            </button>
                        </div>
                    </div>

                     <!-- BACK -->
                    <div class="flip-card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 bg-white rounded-[2.5rem] overflow-hidden p-8 md:p-12 flex flex-col justify-center shadow-2xl">
                         <h3 class="font-serif text-2xl md:text-4xl text-primary mb-4">{service.title}</h3>
                         <p class="font-sans text-gray-600 leading-relaxed mb-6">
                            {service.backDesc}
                         </p>
                         <button class="flip-close text-primary text-sm border-b border-primary pb-1 w-max hover:text-accent hover:border-accent transition-colors">
                            {SERVICES_PAGE.flipBack}
                         </button>
                    </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    </div>
  </div>
</section>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden; /* Fix for Safari/iOS shadow leaks */
    transform: translateZ(1px); /* Force layer isolation to prevent shadow bleed during rotate */
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
  .is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initServicesContentAnim() {
    const sections = document.querySelectorAll("section[id^='services-detailed']");
    if (sections.length === 0) return;

    sections.forEach(section => {
      // FLIP CARD LOGIC
      const flipCards = section.querySelectorAll('.service-card');
      flipCards.forEach(card => {
          const trigger = card.querySelector('.flip-trigger');
          const close = card.querySelector('.flip-close');
          
          if(trigger && close) {
              trigger.addEventListener('click', (e) => {
                  e.preventDefault();
                  card.classList.add('is-flipped');
              });
              
              close.addEventListener('click', (e) => {
                   e.preventDefault();
                   card.classList.remove('is-flipped');
              });
          }
      });


      // Chaotic Reveal for Cards (Thrown on Table effect)
      const cards = section.querySelectorAll(".service-card");
      cards.forEach((card, i) => {
        // Randomize direction and rotation for each card
        const randomX = (Math.random() - 0.5) * 200; // -100 to 100
        const randomY = 100 + Math.random() * 100; // 100 to 200 (always coming from slightly below)
        const randomRot = (Math.random() - 0.5) * 15; // -7.5 to 7.5 deg
        const randomScale = 0.8 + Math.random() * 0.2; // 0.8 to 1.0

        gsap.fromTo(
          card,
          {
            opacity: 0,
            x: randomX,
            y: randomY,
            rotation: randomRot,
            scale: 0.9,
            transformOrigin: "center center",
          },
          {
            opacity: 1,
            x: 0,
            y: 0,
            rotation: 0,
            scale: 1,
            duration: 1.4,
            ease: "power3.out",
            scrollTrigger: {
              trigger: card,
              start: "top 85%",
            },
          },
        );
      });

      // Parallax for Column 2 (on Desktop)
      if (window.innerWidth >= 768) {
        const col2 = section.querySelector('.masonry-col[data-speed="1.1"]');
        if (col2) {
          gsap.to(col2, {
            y: -80, // Reduced travel distance
            ease: "none",
            scrollTrigger: {
              trigger: section,
              start: "top bottom",
              end: "bottom top",
              scrub: true, // "True" binds directly to scrollbar (no lag), fixing the fight with smooth-scroll
            },
          });
        }
      }
    });
  }

  // Run on Page Load (View Transitions)
  document.addEventListener("astro:page-load", initServicesContentAnim);
  if (document.readyState !== "loading") initServicesContentAnim();
  else document.addEventListener("DOMContentLoaded", initServicesContentAnim);
</script>
