---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import MobileMenu from "../components/MobileMenu.astro";
import CustomCursor from "../components/ui/CustomCursor.astro";
import ContactModal from "../components/ContactModal.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Mobilă la comandă - Quiet Luxury" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Prevent scroll restoration (glitch prevention)
      if (history.scrollRestoration) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body
    class="bg-secondary text-primary font-sans antialiased overflow-x-hidden"
  >
    <!--  Navbar must be outside smooth-wrapper to be fixed/sticky correctly -->
    <Navbar />
    <MobileMenu />
    <CustomCursor />

    <!-- ScrollSmoother Structure -->
    <div
      id="smooth-wrapper"
      class="pointer-events-none"
      style="position: relative; z-index: 10 !important;"
    >
      <div id="smooth-content" class="pointer-events-none">
        <div class="pointer-events-auto">
          <slot />
        </div>
      </div>
    </div>
    <slot name="footer" />

    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll";

      // Optimization: Stagger initialization to avoid blocking Main Thread on load
      const init = () => {
        requestAnimationFrame(() => {
          setTimeout(() => {
            initSmoothScroll();
          }, 100);
        });
      };

      init();
      document.addEventListener("astro:page-load", init);
    </script>
    <ContactModal />
  </body>
</html>

<style is:global>
  /* Custom Scrollbar HIDDEN as requested */
  ::-webkit-scrollbar {
    display: none;
    width: 0px;
    background: transparent;
  }

  html {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  /* Performance Optimization */
  .section-optimize {
    content-visibility: auto;
    contain-intrinsic-size: 1px 1000px; /* Guess height to prevent scroll jump */
  }

  /* Hide Default Cursor on Desktop */
  @media (hover: hover) and (pointer: fine) {
    html,
    body,
    a,
    button,
    input,
    select,
    textarea,
    [role="button"] {
      cursor: none !important;
    }
  }
</style>
