---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import MobileMenu from "../components/MobileMenu.astro";
import CustomCursor from "../components/ui/CustomCursor.astro";
import ContactModal from "../components/ContactModal.astro";
import ContactFAB from "../components/ui/ContactFAB.astro";
import { SITE, absoluteUrl, targetCitiesString } from "../config/site";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: "website" | "article";
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = `${SITE.tagline} — Design interior, mobilier din lemn masiv și soluții premium de la ${SITE.name} în ${targetCitiesString()}.`,
  image = SITE.defaultOgImage,
  canonicalURL = new URL(Astro.url.pathname, SITE.url),
  type = "website",
  breadcrumbs,
} = Astro.props;

// --- Structured Data Schemas ---

// 1. Organization with Wikidata entity disambiguation
const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE.name,
  "url": SITE.url,
  "logo": absoluteUrl(SITE.logo),
  "image": absoluteUrl(SITE.defaultOgImage),
  "description": `${SITE.tagline} — soluții premium de design interior în ${targetCitiesString()}.`,
  "telephone": SITE.phone,
  "email": SITE.email,
  "sameAs": [
    ...SITE.sameAs,
    // Wikidata entity disambiguation
    "https://www.wikidata.org/wiki/Q82070",  // Brașov
    "https://www.wikidata.org/wiki/Q193055", // Buzău
    "https://www.wikidata.org/wiki/Q83364",  // Sibiu
    "https://www.wikidata.org/wiki/Q179714", // Sfântu Gheorghe
  ],
  "areaServed": SITE.targetCities.map(city => ({
    "@type": "City",
    "name": city,
  })),
});

// 2. LocalBusiness with precise PostalAddress + GeoCoordinates
const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": SITE.name,
  "image": absoluteUrl(SITE.defaultOgImage),
  "url": SITE.url,
  "telephone": SITE.phone,
  "email": SITE.email,
  "priceRange": "$$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.address.street,
    "addressLocality": SITE.address.city,
    "addressRegion": SITE.address.region,
    "postalCode": SITE.address.postalCode,
    "addressCountry": SITE.address.country,
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": SITE.geo.latitude,
    "longitude": SITE.geo.longitude,
  },
  "areaServed": SITE.targetCities.map(city => ({
    "@type": "City",
    "name": city,
  })),
});

// 3. WebSite (enables Google Sitelinks search box)
const webSiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE.name,
  "url": SITE.url,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${SITE.url}/?s={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
});

// 4. BreadcrumbList (per-page, only if breadcrumbs prop is passed)
const breadcrumbSchema = breadcrumbs ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": crumb.name,
    "item": crumb.url.startsWith("http") ? crumb.url : absoluteUrl(crumb.url),
  })),
}) : null;

// GTM
const GTM_ID = SITE.gtmId;
const hasGTM = GTM_ID && GTM_ID !== "GTM-XXXXXXX";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="RO-BV" />
    <meta name="geo.placename" content={SITE.address.city} />
    <meta name="geo.position" content={`${SITE.geo.latitude};${SITE.geo.longitude}`} />
    <meta name="ICBM" content={`${SITE.geo.latitude}, ${SITE.geo.longitude}`} />

    {/* Google Tag Manager — head script */}
    {hasGTM && (
      <script is:inline define:vars={{ GTM_ID }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',GTM_ID);
      </script>
    )}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, SITE.url)} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, SITE.url)} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={organizationSchema}></script>
    <script type="application/ld+json" set:html={localBusinessSchema}></script>
    <script type="application/ld+json" set:html={webSiteSchema}></script>
    {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema}></script>}

    <link
      rel="preload"
      href="/Fonts/grift-2025-04-02-02-51-35-utc/Variable-TT/Grift Variable-VF.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preload" as="image" href="/Images/optimized/hero-image.webp" />
    <script is:inline>
      // Prevent scroll restoration (glitch prevention)
      if (history.scrollRestoration) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body class="text-primary font-sans antialiased overflow-x-hidden">
    {/* Google Tag Manager — noscript fallback */}
    {hasGTM && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <!--  Navbar must be outside smooth-wrapper to be fixed/sticky correctly -->
    <Navbar />
    <MobileMenu />
    <CustomCursor />

    <!-- ScrollSmoother Structure -->
    <div
      id="smooth-wrapper"
      style="position: relative; z-index: 10 !important;"
    >
      <div id="smooth-content">
        <slot />
        <slot name="footer" />
      </div>
    </div>

    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll";

      // Optimization: Stagger initialization to avoid blocking Main Thread on load
      const init = () => {
        requestAnimationFrame(() => {
          setTimeout(() => {
            initSmoothScroll();
          }, 100);
        });
      };

      init();
      document.addEventListener("astro:page-load", init);
    </script>
    <ContactModal />
    <ContactFAB />
  </body>
</html>

<style is:global>
  /* Custom Scrollbar for 'Quiet Luxury' feel */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  ::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
  }

  /* Performance Optimization */
  .section-optimize {
    content-visibility: auto;
    contain-intrinsic-size: 1px 1000px; /* Guess height to prevent scroll jump */
  }

  /* Hide Default Cursor on Desktop */
  @media (hover: hover) and (pointer: fine) {
    html,
    body,
    a,
    button,
    input,
    select,
    textarea,
    [role="button"] {
      cursor: none !important;
    }
  }
</style>
