---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import MobileMenu from "../components/MobileMenu.astro";
import CustomCursor from "../components/ui/CustomCursor.astro";
import ContactModal from "../components/ContactModal.astro";
import ContactFAB from "../components/ui/ContactFAB.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: "website" | "article";
}

const {
  title,
  description = "Mobilă la comandă - Design interior, mobilier din lemn masiv și soluții premium de la JL Mobila, realizate la cele mai înalte standarde.",
  image = "/Images/optimized/hero-image.webp",
  canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://jl-design.vercel.app",
  ),
  type = "website",
} = Astro.props;

// Default LocalBusiness JSON-LD Schema
const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "JL Mobila",
  image: new URL(
    "/Images/optimized/hero-image.webp",
    Astro.site || "https://jl-design.vercel.app",
  ),
  description: description,
  url: Astro.site || "https://jl-design.vercel.app",
  telephone: "+40700000000",
  priceRange: "$$$",
});
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(image, Astro.site || "https://jl-design.vercel.app")}
    />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="JL Mobila" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={new URL(image, Astro.site || "https://jl-design.vercel.app")}
    />

    <script type="application/ld+json" set:html={localBusinessSchema} />
    <link
      rel="preload"
      href="/Fonts/grift-2025-04-02-02-51-35-utc/Variable-TT/Grift Variable-VF.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preload" as="image" href="/Images/optimized/hero-image.webp" />
    <script is:inline>
      // Prevent scroll restoration (glitch prevention)
      if (history.scrollRestoration) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body class="text-primary font-sans antialiased overflow-x-hidden">
    <!--  Navbar must be outside smooth-wrapper to be fixed/sticky correctly -->
    <Navbar />
    <MobileMenu />
    <CustomCursor />

    <!-- ScrollSmoother Structure -->
    <div
      id="smooth-wrapper"
      style="position: relative; z-index: 10 !important;"
    >
      <div id="smooth-content">
        <slot />
        <slot name="footer" />
      </div>
    </div>

    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll";

      // Optimization: Stagger initialization to avoid blocking Main Thread on load
      const init = () => {
        requestAnimationFrame(() => {
          setTimeout(() => {
            initSmoothScroll();
          }, 100);
        });
      };

      init();
      document.addEventListener("astro:page-load", init);
    </script>
    <ContactModal />
    <ContactFAB />
  </body>
</html>

<style is:global>
  /* Custom Scrollbar for 'Quiet Luxury' feel */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  ::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
  }

  /* Performance Optimization */
  .section-optimize {
    content-visibility: auto;
    contain-intrinsic-size: 1px 1000px; /* Guess height to prevent scroll jump */
  }

  /* Hide Default Cursor on Desktop */
  @media (hover: hover) and (pointer: fine) {
    html,
    body,
    a,
    button,
    input,
    select,
    textarea,
    [role="button"] {
      cursor: none !important;
    }
  }
</style>
