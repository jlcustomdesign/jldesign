---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import MobileMenu from "../components/MobileMenu.astro";
import CustomCursor from "../components/ui/CustomCursor.astro";
import ContactModal from "../components/ContactModal.astro";
import ContactFAB from "../components/ui/ContactFAB.astro";
import { SITE, absoluteUrl, targetCitiesString } from "../config/site";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: "website" | "article";
  breadcrumbs?: BreadcrumbItem[];
  hideNavbar?: boolean;
  hideContact?: boolean;
}

const {
  title,
  description = `${SITE.tagline} — design interior, mobilier la comandă, mobilă personalizată și soluții premium de la ${SITE.name} în ${targetCitiesString()}.`,
  image = SITE.defaultOgImage,
  canonicalURL = new URL(Astro.url.pathname, SITE.url),
  type = "website",
  breadcrumbs,
  hideNavbar = false,
  hideContact = false,
} = Astro.props;

// CMS preview mode: when loaded in the admin "Conținut site" editor (?cms=1),
// inject a small overlay that makes text/images click-to-edit + live-updatable.
const cmsMode = Astro.url.searchParams.get("cms") === "1";

// --- Structured Data Schemas ---

// 1. Organization with Wikidata entity disambiguation
const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE.name,
  "url": SITE.url,
  "logo": absoluteUrl(SITE.logo),
  "image": absoluteUrl(SITE.defaultOgImage),
  "description": `${SITE.tagline}. Atelier de mobilă la comandă și mobilier personalizat în ${targetCitiesString()}.`,
  "telephone": SITE.phone,
  "email": SITE.email,
  "knowsAbout": [
    "mobilă la comandă",
    "mobilier personalizat",
    "mobilă Brașov",
    "mobilă la comandă Brașov",
    "bucătării la comandă",
    "dressinguri la comandă",
    "design interior",
    "proiectare 3D",
    "lemn masiv",
    "MDF vopsit",
    "PAL melaminat",
    "furnir natural",
  ],
  "sameAs": [
    ...SITE.sameAs,
    // Wikidata entity disambiguation
    "https://www.wikidata.org/wiki/Q82070",  // Brașov
    "https://www.wikidata.org/wiki/Q193055", // Buzău
    "https://www.wikidata.org/wiki/Q83364",  // Sibiu
    "https://www.wikidata.org/wiki/Q179714", // Sfântu Gheorghe
  ],
  "areaServed": SITE.targetCities.map(city => ({
    "@type": "City",
    "name": city,
  })),
});

// 2. LocalBusiness with precise PostalAddress + GeoCoordinates
//    Using both LocalBusiness and Carpenter types gives Google richer signals
//    for "mobilă la comandă" / custom furniture searches.
const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Carpenter"],
  "name": SITE.name,
  "image": absoluteUrl(SITE.defaultOgImage),
  "url": SITE.url,
  "telephone": SITE.phone,
  "email": SITE.email,
  "description": `Atelier de mobilă la comandă și mobilier personalizat din lemn masiv, MDF și PAL în ${targetCitiesString(8)}. Proiectare 3D, execuție custom și montaj profesional.`,
  "priceRange": "$$$",
  "address": {
    "@type": "PostalAddress",
    // Empty fields (street / postalCode) are omitted from schema — a missing
    // property is cleaner than an empty string for local SEO signals.
    ...(SITE.address.street ? { "streetAddress": SITE.address.street } : {}),
    "addressLocality": SITE.address.city,
    "addressRegion": SITE.address.region,
    ...(SITE.address.postalCode ? { "postalCode": SITE.address.postalCode } : {}),
    "addressCountry": SITE.address.country,
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": SITE.geo.latitude,
    "longitude": SITE.geo.longitude,
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Brașov",
      "containedIn": "Brașov County, Romania",
    },
    ...SITE.targetCities.slice(1).map(city => ({
      "@type": "City",
      "name": city,
    })),
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicii mobilă la comandă Brașov",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Mobilă la comandă",
          "description": "Mobilier personalizat și mobilă la comandă pentru locuințe, birouri și spații comerciale în Brașov.",
        },
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Proiectare 3D și randări",
          "description": "Consultanță, design interior, proiectare tehnică și randări fotorealiste înainte de execuție.",
        },
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Producție și montaj mobilier",
          "description": "Execuție în atelier propriu și montaj profesional de mobilier din lemn masiv, MDF vopsit și PAL melaminat.",
        },
      },
    ],
  },
  "makesOffer": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Bucătării la comandă Brașov",
      },
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Dressinguri și dulapuri la comandă",
      },
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Mobilier living și biblioteci",
      },
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Mobilier birouri și spații comerciale",
      },
    },
  ],
});

// 3. WebSite (enables Google Sitelinks search box)
const webSiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE.name,
  "url": SITE.url,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${SITE.url}/?s={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
});

// 4. BreadcrumbList (per-page, only if breadcrumbs prop is passed)
const breadcrumbSchema = breadcrumbs ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": crumb.name,
    "item": crumb.url.startsWith("http") ? crumb.url : absoluteUrl(crumb.url),
  })),
}) : null;

---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon_nou.png?v=18" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="RO-BV" />
    <meta name="geo.placename" content={SITE.address.city} />
    <meta name="geo.position" content={`${SITE.geo.latitude};${SITE.geo.longitude}`} />
    <meta name="ICBM" content={`${SITE.geo.latitude}, ${SITE.geo.longitude}`} />
    
    {/* Bing Webmaster Verification */}
    {SITE.bingVerification && (
      <meta name="msvalidate.01" content={SITE.bingVerification} />
    )}

    {/* Google Analytics (gtag.js) */}
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ GA_ID: SITE.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.keywords.join(", ")} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, SITE.url)} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, SITE.url)} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={organizationSchema}></script>
    <script type="application/ld+json" set:html={localBusinessSchema}></script>
    <script type="application/ld+json" set:html={webSiteSchema}></script>
    {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema}></script>}

    <link
      rel="preload"
      href="/Fonts/grift-2025-04-02-02-51-35-utc/Variable-TT/Grift Variable-VF.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preload" as="image" href="/Poze JL Custom Design - Site/LP/Hero/Desktop.webp" />
    <script is:inline>
      // Prevent scroll restoration (glitch prevention)
      if (history.scrollRestoration) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body class:list={["text-primary font-sans antialiased overflow-x-hidden", { "cms-preview": cmsMode }]}>
    {/* Navbar must be outside smooth-wrapper to be fixed/sticky correctly */}
    {!hideNavbar && <Navbar />}
    {!hideNavbar && <MobileMenu />}
    {/* Custom cursor everywhere except the admin live-preview, where the
        system cursor is needed to click elements. */}
    {!cmsMode && <CustomCursor />}

    <!-- ScrollSmoother Structure -->
    <div
      id="smooth-wrapper"
      style="position: relative; z-index: 10 !important;"
    >
      <div id="smooth-content">
        <slot />
        <slot name="footer" />
      </div>
    </div>

    <slot name="outside" />

    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll";
      import { initAutoTracking } from "../scripts/analytics";

      const init = () => {
        // Optimization: Defer to requestIdleCallback if available to avoid blocking FCP
        const deferFn = window.requestIdleCallback || ((cb) => setTimeout(cb, 300));
        
        deferFn(() => {
          initSmoothScroll();
          initAutoTracking();
          
          // Fail-safe: Heartbeat refresh to handle any late-loading assets
          // that might "trap" the scroll height
          import("gsap/ScrollTrigger").then(({ ScrollTrigger }) => {
            let refreshCount = 0;
            const heartbeat = setInterval(() => {
              ScrollTrigger.refresh();
              refreshCount++;
              if (refreshCount > 5) clearInterval(heartbeat);
            }, 500);
          });
        });
      };

      init();
      document.addEventListener("astro:page-load", init);
    </script>
    {!hideContact && <ContactModal />}
    {!hideContact && <ContactFAB />}
    {cmsMode && <script is:inline src="/cms-overlay.js?v=7"></script>}
  </body>
</html>

<style is:global>
  /* Custom Scrollbar for 'Quiet Luxury' feel */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  ::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
  }

  /* Performance Optimization */
  .section-optimize {
    content-visibility: auto;
    contain-intrinsic-size: 1px 1000px; /* Guess height to prevent scroll jump */
  }

  /* Hide Default Cursor on Desktop */
  @media (hover: hover) and (pointer: fine) {
    html,
    body,
    a,
    button,
    input,
    select,
    textarea,
    [role="button"] {
      cursor: none !important;
    }
  }

  /* In the admin live-preview (?cms=1) keep the system cursor visible. */
  body.cms-preview,
  body.cms-preview * {
    cursor: auto !important;
  }
  body.cms-preview [data-cms] {
    cursor: pointer !important;
  }
</style>
